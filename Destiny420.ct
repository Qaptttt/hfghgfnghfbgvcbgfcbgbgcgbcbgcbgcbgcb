          <AssemblerScript>// ALURA IS YOUR DADDY YOU FAT TUBS OF WHALE SHIT

{$lua}
function checkKeys()
    local playerBase = readPointer(getAddress("Player"))
    if playerBase ~= nil then
           --true death
        if isKeyPressed(VK_XBUTTON1) then
            writeFloat(playerBase + 0x1C0, -111111)
            writeFloat(playerBase + 0x1C4, -111111)
