pinBtn.Left = W - 192; pinBtn.Top = 11; pinBtn.Width = 34; pinBtn.Height = 22
pinBtn.Font.Size = 7; pinBtn.Font.Bold = true
pinBtn.Font.Color = C_DIM; pinBtn.Color = 0x222222
local _pinOn = false
pinBtn.OnClick = function()
  _pinOn = not _pinOn
  F.AlwaysOnTop = _pinOn
  pinBtn.Font.Color = _pinOn and C_ACCENT or C_DIM
  pinBtn.Caption    = _pinOn and "■PIN" or "PIN"
end

local accentBar = createPanel(F)
accentBar.Left = 0; accentBar.Top = HDR_H; accentBar.Width = W; accentBar.Height = 2
accentBar.Color = C_ACCENT; accentBar.BevelOuter = "bvNone"

local BODY_TOP = HDR_H + 2
local BODY_H   = H - BODY_TOP

local sidebar = createPanel(F)
sidebar.Left = 0; sidebar.Top = BODY_TOP
sidebar.Width = SIDE_W; sidebar.Height = BODY_H
sidebar.Color = C_SIDE; sidebar.BevelOuter = "bvNone"

local sideBorder = createPanel(F)
sideBorder.Left = SIDE_W; sideBorder.Top = BODY_TOP
sideBorder.Width = 1; sideBorder.Height = BODY_H
sideBorder.Color = C_SEP; sideBorder.BevelOuter = "bvNone"

local CONT_X = SIDE_W + 1
local CONT_W  = W - CONT_X
local COL_W   = math.floor((CONT_W - 3) / 2)
local COL2_X  = COL_W + 3

local CATS = {
  "PLAYER","MOVEMENT","COMBAT","ABILITIES","INTERACTION",
  "TELEPORTS","INVENTORY","WEAPONS","VISUAL","MISC","STEALTH"
}

local GROUPS = {
  { icon = "\xe2\x9a\xa1", label = "PLAYER",
    subs = {"PLAYER","MOVEMENT","COMBAT","ABILITIES","INTERACTION","TELEPORTS"} },
  { icon = "\xf0\x9f\x94\xab", label = "EQUIPMENT",
    subs = {"INVENTORY","WEAPONS"} },
  { icon = "\xf0\x9f\x91\x81", label = "VISUAL",
    subs = {"VISUAL"} },
  { icon = "\xe2\x9a\x99", label = "MISC",
    subs = {"MISC"} },
  { icon = "\xf0\x9f\x94\x92", label = "STEALTH",
    subs = {"STEALTH"} },
}

local catPanels  = {}
local catSideItems = {}
local currentCat = nil

local function setTab(name)
  if currentCat == name then return end
  currentCat = name
  for _, cat in ipairs(CATS) do
    local cp = catPanels[cat]
    if cp then cp.panel.Visible = (cat == name) end
    local si = catSideItems[cat]
    if si then
      si.bar.Visible = (cat == name)
      si.bg.Color    = (cat == name) and C_ACT_BG or C_SIDE
      si.lbl.Font.Color = (cat == name) and C_TEXT or C_DIM
      si.lbl.Color   = (cat == name) and C_ACT_BG or C_SIDE
    end
  end
end

local sideY = 0
for _, grp in ipairs(GROUPS) do
  local gh = createPanel(sidebar)
  gh.Left = 0; gh.Top = sideY; gh.Width = SIDE_W; gh.Height = 38
  gh.Color = C_GRP_HDR; gh.BevelOuter = "bvNone"

  local gIcon = createLabel(gh)
  gIcon.Caption = grp.icon
  gIcon.Left = 10; gIcon.Top = 9
  gIcon.Font.Size = 11; gIcon.Font.Color = C_ACCENT
  gIcon.Color = C_GRP_HDR; gIcon.ParentColor = false

  local gLbl = createLabel(gh)
  gLbl.Caption = grp.label
  gLbl.Left = 36; gLbl.Top = 11
  gLbl.Font.Size = 9; gLbl.Font.Bold = true; gLbl.Font.Color = C_TEXT
  gLbl.Color = C_GRP_HDR; gLbl.ParentColor = false

  sideY = sideY + 38

  for _, cat in ipairs(grp.subs) do
    local subH = 30
    local bg = createPanel(sidebar)
    bg.Left = 0; bg.Top = sideY; bg.Width = SIDE_W; bg.Height = subH
    bg.Color = C_SIDE; bg.BevelOuter = "bvNone"

    local bar = createPanel(bg)
    bar.Left = 0; bar.Top = 0; bar.Width = 3; bar.Height = subH
    bar.Color = C_ACCENT; bar.BevelOuter = "bvNone"; bar.Visible = false

    local lbl = createLabel(bg)
    lbl.Caption = cat
    lbl.Left = 18; lbl.Top = 8
    lbl.Font.Size = 8; lbl.Font.Color = C_DIM
    lbl.Color = C_SIDE; lbl.ParentColor = false

    catSideItems[cat] = { bg = bg, bar = bar, lbl = lbl }
    local cc = cat
    bg.OnClick  = function() setTab(cc) end
    lbl.OnClick = function() setTab(cc) end

    sideY = sideY + subH
  end

  local sep = createPanel(sidebar)
  sep.Left = 0; sep.Top = sideY; sep.Width = SIDE_W; sep.Height = 1
  sep.Color = C_SEP; sep.BevelOuter = "bvNone"
  sideY = sideY + 1
end

