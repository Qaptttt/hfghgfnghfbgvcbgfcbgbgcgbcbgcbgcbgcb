            </CheatEntry>
            <CheatEntry>
              <ID>2740</ID>
              <Description>"shellLocalPlayer"</Description>
              <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <Color>808080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
local destinyBase = getAddressSafe('destiny2.exe+2F41D60')
local localPlayerOffset = 0x1C0
local teamIdOffset = 0xAAC

function LocalPlayerFunction()
  local localPlayer = readPointer(getAddress("LocalPlayer"))
  local MovingEntityX = readFloat(destinyBase)
  local LocalPlayerX = readFloat(localPlayer + localPlayerOffset)
  local MovingEntityY = readFloat(destinyBase + 4)
  local LocalPlayerY = readFloat(localPlayer + localPlayerOffset + 4)
  local MovingEntityZ = readFloat(destinyBase + 8)
  local LocalPlayerZ = readFloat(localPlayer + localPlayerOffset + 8)

 -- local TeamID = readFloat(localPlayer + teamIdOffset)

  if (
    (MovingEntityX - 1 &lt;= LocalPlayerX and LocalPlayerX &lt;= MovingEntityX + 1) and
    (MovingEntityY - 1 &lt;= LocalPlayerY and LocalPlayerY &lt;= MovingEntityY + 1) and
    (MovingEntityZ - 3 &lt;= LocalPlayerZ and LocalPlayerZ &lt;= MovingEntityZ + 3) --and
   -- TeamID == 1
  ) then
    writeQword(getAddress("Player"), localPlayer)
  end
end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 1
  tmr.OnTimer = LocalPlayerFunction
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()
{$asm}
alloc(Player, 8)
registersymbol(Player)
{$lua}
[DISABLE]
disableFunction()
{$asm}
dealloc(Player, 8)
unregistersymbol(Player)

</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>2739</ID>
          <Description>"Freecam"</Description>
          <Color>FF0080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}

local storedX, storedY, storedZ

KEEP_GOING = true

local function getCameraBase()
local address = getAddressSafe("destiny2.exe+24760D8")
  if address == nil then
    return nil
  end
  local CameraBase = readQword(address) - 0xCAE154
  if CameraBase == 0 then
    return nil
  end
  return CameraBase
end

local function freezePlayer()
  local playerBase = getAddressSafe("Player")
  if playerBase and playerBase ~= 0 then
    local playerPositionBase = readPointer(playerBase) + 0x1C0

    storedX = readFloat(playerPositionBase)
    storedY = readFloat(playerPositionBase + 0x4)
    storedZ = readFloat(playerPositionBase + 0x8)
  end
end

function Fly()
  freezePlayer()

  while KEEP_GOING do
    local CameraBase = getCameraBase()
    if CameraBase and CameraBase ~= 0 then
      local playerBase = getAddressSafe("Player")
      if playerBase and playerBase ~= 0 then
        local playerPositionBase = readPointer(playerBase) + 0x1C0

        writeFloat(playerPositionBase, storedX)
        writeFloat(playerPositionBase + 0x4, storedY)
        writeFloat(playerPositionBase + 0x8, storedZ)

        local CameraX = readFloat(CameraBase)
        local CameraY = readFloat(CameraBase + 0x4)
        local CameraZ = readFloat(CameraBase + 0x8)

        local rotationX = readFloat(playerPositionBase + 0x10)
        local rotationY = readFloat(playerPositionBase + 0x14)
        local rotationZ = readFloat(playerPositionBase + 0x18)

        WpositionX = CameraX + rotationX * 0.005
        WpositionY = CameraY + rotationY * 0.005

        SpositionX = CameraX - rotationX * 0.005
        SpositionY = CameraY - rotationY * 0.005

        ApositionX = CameraX - rotationY * 0.005
        ApositionY = CameraY + rotationX * 0.005

        DpositionX = CameraX + rotationY * 0.005
        DpositionY = CameraY - rotationX * 0.005

        UppositionZ = CameraZ + 0.005
        DownpositionZ = CameraZ - 0.005

        if isKeyPressed(VK_W) then
          writeFloat(CameraBase, WpositionX)
          writeFloat(CameraBase + 0x4, WpositionY)
        end

        if isKeyPressed(VK_S) then
          writeFloat(CameraBase, SpositionX)
          writeFloat(CameraBase + 0x4, SpositionY)
        end

        if isKeyPressed(VK_A) then
          writeFloat(CameraBase, ApositionX)
          writeFloat(CameraBase + 0x4, ApositionY)
        end

        if isKeyPressed(VK_D) then
          writeFloat(CameraBase, DpositionX)
          writeFloat(CameraBase + 0x4, DpositionY)
        end

        if isKeyPressed(VK_Q) then
          writeFloat(CameraBase + 0x8, UppositionZ)
        end

        if isKeyPressed(VK_E) then
          writeFloat(CameraBase + 0x8, DownpositionZ)
        end
      end
    end
  end
end

createNativeThread(Fly)

