      <Description>"View Angles"</Description>
      <Color>808080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscan(INJECT,F3 0F 11 47 1C 7A) // unique: d2+1934376
alloc(newmem,$2000,INJECT)
registersymbol(ViewAngles)
alloc(ViewAngles, 8)
registersymbol(AimbotYaw)
alloc(AimbotYaw, 4)
registersymbol(AimbotPitch)
alloc(AimbotPitch, 4)
registersymbol(AimbotOn)
alloc(AimbotOn, 1)
label(code)
label(doyaw)
label(nopitch)
label(return)

newmem:
code:
  push r14
  mov r14, AimbotOn
  cmp byte ptr [r14], 0
  je doyaw
  movss xmm0, [AimbotYaw]
doyaw:
  movss [rdi+1C], xmm0
  mov r14, AimbotOn
  cmp byte ptr [r14], 0
  je nopitch
  movss xmm0, [AimbotPitch]
  movss [rdi+18], xmm0
nopitch:
  mov r14, ViewAngles
  mov [r14], rdi
  pop r14
  jmp return

INJECT:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db F3 0F 11 47 1C

unregistersymbol(INJECT)
dealloc(newmem)
unregistersymbol(ViewAngles)
dealloc(ViewAngles, 8)
unregistersymbol(AimbotYaw)
dealloc(AimbotYaw, 4)
unregistersymbol(AimbotPitch)
dealloc(AimbotPitch, 4)
unregistersymbol(AimbotOn)
dealloc(AimbotOn, 1)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>3489</ID>
          <Description>"Spinbot"</Description>
          <Color>FF0080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}

KEEP_GOING = true
rotationSpeed = 0.3  -- 3 rot/sec; was 3 (=50 rot/sec, instant server-side flag)

angle = 0
originalViewX = nil
originalViewY = nil

function Fly()
  while KEEP_GOING do
    local ViewBase = getAddressSafe("ViewAngles")
    if ViewBase and ViewBase ~= 0 then
      local ViewAngleBase = readPointer(ViewBase) + 0x1C

      local viewX = readFloat(ViewAngleBase - 0x4)
      local viewY = readFloat(ViewAngleBase)

      -- Store the original view angle when F is first pressed
      if originalViewX == nil and originalViewY == nil and isKeyPressed(VK_F) then
        originalViewX = viewX
        originalViewY = viewY
      end

      -- If F is held, modify the view angle
      if isKeyPressed(VK_F) then
        writeFloat(ViewAngleBase, 0.3)

        angle = angle + rotationSpeed
        if angle > 6.25 then
          angle = 0
        end

        local newViewX = math.sin(angle) * 6.25
        writeFloat(ViewAngleBase - 0x4, newViewX)
      else
        -- When F is not pressed, restore the original view angles
        if originalViewX and originalViewY then
          writeFloat(ViewAngleBase - 0x4, originalViewX)
          writeFloat(ViewAngleBase, originalViewY)
          originalViewX = nil
          originalViewY = nil
        end
      end
    end
    sleep(10)
  end
end

createNativeThread(Fly)

