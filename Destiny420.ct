        <CheatEntry>
          <ID>5001</ID>
          <Description>"Inf Ammo"</Description>
          <Color>FF0080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
-- Freeze ammo for all 16 weapon slots via LocalPlayer pointer chain.
-- Weapon list starts at player+0x2C8, each entry is 8 bytes (ptr), ammo int at weapon+0xC
InfAmmoRunning = true
createNativeThread(function()
  while InfAmmoRunning do
    pcall(function()
      local lp = getAddressSafe("LocalPlayer")
      if not lp or lp == 0 then return end
      local playerPtr = readPointer(lp)
      if not playerPtr or playerPtr == 0 then return end
      -- walk up to 16 weapon slots; slot base at player+0x2C8
      for i = 0, 15 do
        local slotAddr = playerPtr + 0x2C8 + i * 8
        local wep = readPointer(slotAddr)
        if wep and wep ~= 0 then
          -- magazine at +0xC, reserve at +0x10 (DWORD)
          local mag = readInteger(wep + 0xC)
          if mag and mag >= 0 and mag &lt; 9999 then
            writeInteger(wep + 0xC, 999)
          end
          local res = readInteger(wep + 0x10)
          if res and res >= 0 and res &lt; 9999 then
            writeInteger(wep + 0x10, 999)
          end
        end
      end
    end)
    sleep(150)
  end
end)
{$asm}

[DISABLE]
{$lua}
InfAmmoRunning = false
{$asm}
</AssemblerScript>
        </CheatEntry>
