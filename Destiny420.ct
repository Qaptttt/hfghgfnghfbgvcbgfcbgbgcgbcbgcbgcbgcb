        <CheatEntry>
          <ID>9020</ID>
          <Description>"Aimbot [RMB/LT=aim, F8=rescan, F7=toggle ctrl/mouse]"</Description>
          <Color>FF0080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

AimbotRunning = true
local AimbotCache = {}

-- ══ AIMBOT SETTINGS (tune these) ══════════════════════════════════════════
local SMOOTH      = 0.10   -- lerp speed     (0.05=butter-smooth, 0.25=aggressive)
local MAX_TURN    = 0.09   -- max rad/tick   (0.05=subtle, 0.09=default, 0.15=fast)
local AIMBOT_FOV  = 180    -- FOV cone degs  (180=full, 90=wide, 45=tight, 20=pixel)
local AIMBOT_RAD  = 400    -- entity radius  world-units (increase for longer ranges)
-- ══════════════════════════════════════════════════════════════════════════

-- VK_F7 = toggle controller/mouse mode
-- VK_F8 = rescan entities
-- VK_RBUTTON      = 0x02   (right mouse button)
-- VK_PAD_LTRIGGER = 0x5806 (Xbox/PS left trigger — CE handles XInput natively)
local VK_F7           = 0x76
local VK_F8           = 0x77
local VK_RBUTTON      = 0x02
local VK_PAD_LTRIGGER = 0x5806

if g_useCtrl == nil then g_useCtrl = false end

local function isAimPressed()
  if g_useCtrl then
    return isKeyPressed(VK_PAD_LTRIGGER)
  else
    return isKeyPressed(VK_RBUTTON)
  end
end

local function safeF(fn, ...)
  local ok, v = pcall(fn, ...)
  return ok and v or nil
end

local function getLP()
  local s = getAddressSafe("LocalPlayer")
  if not s or s == 0 then return nil end
  local p = readPointer(s)
  return (p and p ~= 0) and p or nil
end

-- d2 module range for vtable sanity check (avoids false-positive entities)
local aim_d2lo, aim_d2hi = 0, 0
local aim_d2mi = getModuleInfo("destiny2.exe")
if aim_d2mi then
  aim_d2lo = aim_d2mi.Address
  aim_d2hi = aim_d2mi.Address + aim_d2mi.Size
end

local function buildEntityCache()
  AimbotCache = {}
  local lp = getLP()
  if not lp then return end
  local lpx = safeF(readFloat, lp + 0x1C0); if not lpx or lpx ~= lpx then return end
  local lpy = safeF(readFloat, lp + 0x1C4)
  local lpz = safeF(readFloat, lp + 0x1C8)
  if not lpy or not lpz then return end

  -- anchor on the region that contains LocalPlayer (same pool as other entities)
  local rBase = lp - 0x200000
  local rSize = 0x400000
  local ok2, regions = pcall(getMemoryRegions)
  if ok2 and regions then
    for i = 0, regions.Count - 1 do
      local r = regions[i]
      if r.BaseAddress &lt;= lp and lp &lt; r.BaseAddress + r.RegionSize then
        rBase = r.BaseAddress; rSize = r.RegionSize; break
      end
    end
    if regions.destroy then regions.destroy() end
  end

  local stride = 0x800
  local top = rBase + rSize - 0x1E0
  local addr = rBase
  while addr &lt;= top do
    if addr ~= lp then
      -- vtable sanity: qword@+0 must point inside d2 image to rule out heap garbage
      local vt = safeF(readPointer, addr)
      if vt and vt &gt;= aim_d2lo and vt &lt; aim_d2hi then
        local ex = safeF(readFloat, addr + 0x1C0)
        if ex and ex == ex and math.abs(ex - lpx) &lt; AIMBOT_RAD then
          local ey = safeF(readFloat, addr + 0x1C4)
          local ez = safeF(readFloat, addr + 0x1C8)
          if ey and ey == ey and ez and ez == ez
             and math.abs(ey - lpy) &lt; AIMBOT_RAD
             and math.abs(ez - lpz) &lt; AIMBOT_RAD then
            local dd = (ex-lpx)^2 + (ey-lpy)^2 + (ez-lpz)^2
            if dd > 1 then
              AimbotCache[#AimbotCache+1] = {ex, ey, ez, addr}
            end
          end
        end
      end
    end
    addr = addr + stride
  end
end

local function aimLoop()
  local prevF7, prevF8 = false, false
  -- Hook symbol addresses: lazy-init once ViewAngles (ID 2977) is enabled.
  -- ViewAngles hook writes: AimbotPitch->[rdi+0x18] (actual YAW axis in D2),
  --                         AimbotYaw  ->[rdi+0x1C] (actual PITCH axis in D2).
  local aOnAddr, aYawAddr, aPitchAddr = nil, nil, nil
  local lastRebuild = 0

  while AimbotRunning do
    -- auto-rebuild entity cache every 3 seconds
    local now = getTickCount()
    if now - lastRebuild > 3000 then
      buildEntityCache()
      lastRebuild = now
    end

    -- lazy-init hook addresses
    if not aOnAddr or aOnAddr == 0 then
      aOnAddr    = getAddressSafe("AimbotOn")
      aYawAddr   = getAddressSafe("AimbotYaw")
      aPitchAddr = getAddressSafe("AimbotPitch")
    end

    local f7 = isKeyPressed(VK_F7)
    if f7 and not prevF7 then g_useCtrl = not g_useCtrl end
    prevF7 = f7

    local f8 = isKeyPressed(VK_F8)
    if f8 and not prevF8 then buildEntityCache(); lastRebuild = getTickCount() end
    prevF8 = f8

    if isAimPressed() then
      local lp = getLP()
      if lp then
        local lpx = safeF(readFloat, lp + 0x1C0)
        if lpx and lpx == lpx then
          local lpy = safeF(readFloat, lp + 0x1C4)
          local lpz = safeF(readFloat, lp + 0x1C8)
          if lpy and lpz then
            -- build view direction for optional FOV cone filter
            local vpBaseF = getAddressSafe("ViewAngles")
            local vpF     = vpBaseF and safeF(readPointer, vpBaseF) or nil
            local fovYaw   = (vpF and safeF(readFloat, vpF + 0x18)) or 0
            local fovPitch = (vpF and safeF(readFloat, vpF + 0x1C)) or 0
            local cpf = math.cos(fovPitch)
            local vdxF = cpf * math.cos(fovYaw)
            local vdyF = math.sin(fovPitch)
            local vdzF = cpf * math.sin(fovYaw)
            local best, bDist = nil, 1e18
            for _, e in ipairs(AimbotCache) do
              -- FOV filter: skip targets outside the configured cone
              if AIMBOT_FOV &lt; 180 then
                local dx2 = e[1]-lpx; local dy2 = e[2]-lpy; local dz2 = e[3]-lpz
                local d2  = math.sqrt(dx2*dx2 + dy2*dy2 + dz2*dz2)
                if d2 > 0.01 then
                  local dot = (vdxF*dx2 + vdyF*dy2 + vdzF*dz2) / d2
                  local ang = math.deg(math.acos(math.max(-1, math.min(1, dot))))
                  if ang > AIMBOT_FOV then goto nextEnt end
                end
              end
              do
                local dd = (e[1]-lpx)^2 + (e[2]-lpy)^2 + (e[3]-lpz)^2
                if dd &lt; bDist then bDist = dd; best = e end
              end
              ::nextEnt::
            end
            if best and aOnAddr and aOnAddr ~= 0 then
              local dx = best[1] - lpx
              local dy = best[2] - lpy
              local dz = best[3] - lpz
              local hz = math.sqrt(dx*dx + dz*dz)
              local tyaw   = math.atan2(dz, dx)
              local tpitch = -math.atan2(dy, hz)

              -- read current angles from game struct via ViewAngles ptr
              local vpBase = getAddressSafe("ViewAngles")
              local vp     = vpBase and readPointer(vpBase) or nil
              local curYaw   = (vp and safeF(readFloat, vp + 0x18)) or tyaw
              local curPitch = (vp and safeF(readFloat, vp + 0x1C)) or tpitch
              -- cap delta to MAX_TURN per tick, then lerp + micro-jitter
              local dyaw   = tyaw   - curYaw
              local dpitch = tpitch - curPitch
              local pi2 = 2 * math.pi
              dyaw = dyaw % pi2
              if dyaw > math.pi then dyaw = dyaw - pi2 end
              if math.abs(dyaw)   > MAX_TURN then dyaw   = MAX_TURN * (dyaw   > 0 and 1 or -1) end
              if math.abs(dpitch) > MAX_TURN then dpitch = MAX_TURN * (dpitch > 0 and 1 or -1) end
              local newYaw   = curYaw   + dyaw   * SMOOTH + (math.random() - 0.5) * 0.005
              local newPitch = curPitch + dpitch * SMOOTH + (math.random() - 0.5) * 0.003

              -- write through hook symbols:
              -- AimbotPitch symbol controls [rdi+0x18] = YAW axis
              -- AimbotYaw   symbol controls [rdi+0x1C] = PITCH axis
              pcall(writeFloat, aPitchAddr, newYaw)
              pcall(writeFloat, aYawAddr,   newPitch)
              pcall(writeBytes, aOnAddr, 1)
            end
          end
        end
      end
    else
      if aOnAddr and aOnAddr ~= 0 then pcall(writeBytes, aOnAddr, 0) end
    end
    sleep(8)
  end
  if aOnAddr and aOnAddr ~= 0 then pcall(writeBytes, aOnAddr, 0) end
end

createNativeThread(aimLoop)
