      <AssemblerScript>[ENABLE]
aobscan(ChamsTag,A6 95 80 80 00 00 00 00 10 BF) // unique suffix → d2+287EAB8 only
alloc(ChamsBase, 8)
registersymbol(ChamsBase)
{$lua}
if syntaxcheck then return end

-- Store the tag address for raw pointer base
local ct = getAddressSafe("ChamsTag")
local cb = getAddressSafe("ChamsBase")
if ct and ct ~= 0 and cb and cb ~= 0 then
  writeQword(cb, ct)
end

-- ══ WALL ESP / CHAMS ═══════════════════════════════════════════════════════
-- Scans LocalPlayer's object pool (stride 0x800) for nearby entities.
-- Writes 1 to entity+CHAMS_GLOW_OFF to force the D2 glow/highlight pass ON.
-- D2 renders the glow pass AFTER depth clear → shows through all geometry.
--
-- CALIBRATING CHAMS_GLOW_OFF (if no visual with default 0x230):
--   1. Walk near an enemy
--   2. CE → Add address manually → entity addr from debug print (set ChamsDbgLog=true)
--   3. Right-click entity addr → Browse this memory region
--   4. In-game: use Warlock rift / Hunter golden gun near the enemy
--   5. CE → Unknown → Changed → the DWORD that flipped 0→1 is CHAMS_GLOW_OFF
--   6. Update the value below (common: 0x1E0, 0x230, 0x238, 0x260)
_G["CHAMS_GLOW_OFF"] = 0x230   -- ← tune this if no glow
_G["CHAMS_RADIUS"]   = 600     -- world-unit radius (~600m effective range)
_G["ChamsRunning"]   = true
_G["ChamsDbgLog"]    = false   -- set true to print entity addrs to Lua output

-- Silence OutputDebugString so BattleEye debug monitoring sees nothing
pcall(function()
  local ods = getAddressSafe("kernel32.OutputDebugStringA")
  if ods and ods ~= 0 then writeBytes(ods, 0xC3) end
  ods = getAddressSafe("kernel32.OutputDebugStringW")
  if ods and ods ~= 0 then writeBytes(ods, 0xC3) end
end)

local function safeF_c(fn, ...)
  local ok, v = pcall(fn, ...)
  return ok and v or nil
end

local function getLPc()
  local s = getAddressSafe("LocalPlayer")
  if not s or s == 0 then return nil end
  local p = safeF_c(readPointer, s)
  return (p and p ~= 0) and p or nil
end

-- get d2 module range for vtable sanity (filters garbage floats at +0x1C0)
local d2lo, d2hi = 0, 0
local d2mi = getModuleInfo("destiny2.exe")
if d2mi then d2lo = d2mi.Address; d2hi = d2mi.Address + d2mi.Size end

local function chamsUpdate()
  if not _G["ChamsRunning"] then return end
  local lp = getLPc()
  if not lp then return end
  local lpx = safeF_c(readFloat, lp + 0x1C0)
  if not lpx or lpx ~= lpx then return end
  local lpy = safeF_c(readFloat, lp + 0x1C4)
  local lpz = safeF_c(readFloat, lp + 0x1C8)
  if not lpy or not lpz then return end

  -- find the heap region that contains LP (also holds other entities)
  local rBase = lp - 0x200000
  local rSize = 0x400000
  local ok2, regions = pcall(getMemoryRegions)
  if ok2 and regions then
    for i = 0, regions.Count - 1 do
      local r = regions[i]
      if r.BaseAddress &lt;= lp and lp &lt; r.BaseAddress + r.RegionSize then
        rBase = r.BaseAddress; rSize = r.RegionSize; break
      end
    end
    if regions.destroy then regions.destroy() end
  end

  local GOFF   = _G["CHAMS_GLOW_OFF"]
  local RAD    = _G["CHAMS_RADIUS"]
  local stride = 0x800
  local top    = rBase + rSize - 0x240
  local addr   = rBase
  local cnt    = 0

  while addr &lt;= top do
    if addr ~= lp then
      -- vtable sanity: qword@+0 must point inside destiny2.exe
      local vt = safeF_c(readPointer, addr)
      if vt and vt &gt;= d2lo and vt &lt; d2hi then
        local ex = safeF_c(readFloat, addr + 0x1C0)
        if ex and ex == ex and math.abs(ex - lpx) &lt; RAD then
          local ey = safeF_c(readFloat, addr + 0x1C4)
          local ez = safeF_c(readFloat, addr + 0x1C8)
          if ey and ey == ey and ez and ez == ez
             and math.abs(ey - lpy) &lt; RAD
             and math.abs(ez - lpz) &lt; RAD then
            pcall(writeInteger, addr + GOFF,     1)
            pcall(writeInteger, addr + GOFF + 4, 1)
            cnt = cnt + 1
            if _G["ChamsDbgLog"] and cnt &lt;= 8 then
              print(string.format("[Chams] ent@%X vt@%X pos=(%.0f,%.0f,%.0f) glow@+%X",
                addr, vt, ex, ey, ez, GOFF))
            end
          end
        end
      end
    end
    addr = addr + stride
  end
end

local function chamsLoop()
  while _G["ChamsRunning"] do
    chamsUpdate()
    sleep(50)
  end
end
createNativeThread(chamsLoop)
{$asm}

