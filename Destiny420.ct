    <CheatEntry>
      <ID>9033</ID>
      <Description>"ODS Mute [UD — run after attach]"</Description>
      <Color>FF4400</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Mute kernel32.OutputDebugString(A/W) by patching first byte to 0xC3 (RET).
-- BattleEye monitors debug string output via DBWIN_BUFFER/DBWIN_DATA named-pipe.
-- CE writes debug strings constantly (hook installs, AOB hits, symbol resolves).
-- After this patch every ODS call returns immediately — BE sees silence.
local function muteODS(sym)
  local a = getAddressSafe(sym)
  if not a or a == 0 then return false end
  local b = readBytes(a, 1, true)
  if b and b[1] == 0xC3 then return true end  -- already patched
  local ok = pcall(writeBytes, a, 0xC3)
  return ok
end
-- try common resolution paths (varies by CE version and attach order)
local muted =
  muteODS("kernel32.OutputDebugStringA") or
  muteODS("OutputDebugStringA")          or
  muteODS("kernel32.dll+OutputDebugStringA")
muted = muted or
  muteODS("kernel32.OutputDebugStringW") or
  muteODS("OutputDebugStringW")          or
  muteODS("kernel32.dll+OutputDebugStringW")
_G["ODSMuted"] = muted
if muted then
  print("[UD] OutputDebugString muted — BattleEye debug channel silenced")
else
  print("[UD] WARN: ODS not patched — try enabling after CE driver loads DBK")
end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
-- ODS stays muted for session safety — restoring it would re-expose the channel
_G["ODSMuted"] = false
