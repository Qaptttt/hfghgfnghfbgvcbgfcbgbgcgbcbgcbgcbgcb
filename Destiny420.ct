</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9032</ID>
      <Description>"Driver Stealth [run once after CT load]"</Description>
      <Color>FF4400</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local origin = TrainerOrigin or ""

-- 1: delete the SCM service registry key (all ControlSets)
--    BattleEye calls EnumServicesStatus — removing the key kills the entry
pcall(function()
  local f = io.open("driver64.dat", "r")
  if not f then
    f = io.open(origin .. "driver64.dat", "r")
    if not f then return end
  end
  local svc = (f:read("*l") or ""):match("^%s*(.-)%s*$")
  f:close()
  if not svc or #svc &lt; 2 then return end
  -- delete from all three ControlSet locations
  for _, cs in ipairs({"CurrentControlSet","ControlSet001","ControlSet002"}) do
    os.execute('reg delete "HKLM\\SYSTEM\\' .. cs .. '\\Services\\' .. svc .. '" /f >nul 2>nul')
  end
  -- sc delete also removes pending-delete mark in SCM in-memory table
  os.execute('sc delete "' .. svc .. '" >nul 2>nul')
end)

-- 2: rename (then delete) the .sys file from disk
--    Once loaded, the file can be renamed/deleted — kernel image stays in RAM.
--    BattleEye scans %SystemRoot%\System32\drivers and app dirs for known sys filenames.
pcall(function()
  local f = io.open("driver64.dat", "r")
  if not f then f = io.open(origin.."driver64.dat","r") end
  if not f then return end
  f:read("*l"); f:read("*l"); f:read("*l")   -- skip line1, line2, line3
  local sysName = (f:read("*l") or ""):match("^%s*(.-)%s*$")  -- line 4 = .sys filename
  f:close()
  if not sysName or #sysName &lt; 3 then return end
  -- try both local dir and origin dir
  for _, dir in ipairs({origin, origin.."drivers\\"}) do
    local fp = dir .. sysName
    local fh = io.open(fp, "rb")
    if fh then
      fh:close()
      -- rename to a random temp name so the original name is gone from disk
      local tmp = fp:gsub("%.sys$", math.random(10000,99999)..".tmp")
      os.rename(fp, tmp)
      break
    end
  end
end)

-- 3: PE header erasure DISABLED.
-- Zeroing kernel module headers triggers PatchGuard CRITICAL_STRUCTURE_CORRUPTION
-- bugcheck 0x109 on Win10/11. SCM deletion + file rename (steps 1-2) are sufficient.

-- 4: spoof CE's own PEB ImagePathName to look like a system process
--    replaces the unicode path string in the PEB so task managers + BE show a fake name
pcall(function()
  local peb = getAddressSafe("__readgsqword(0x60)")  -- not available from Lua directly
  -- use readPointer chain: TEB (GS:[0x30]) → PEB (offset 0x60) → ProcessParameters (0x20)
  -- → ImagePathName.Buffer (0x60), ImagePathName.Length (0x58)
  -- We can't read GS from Lua, but we CAN find the PEB via NtCurrentTeb if CE exposes it
  -- Best-effort: use a known CE Lua PEB accessor if available
  local getPEB = _G["getCEprocessParam"] or _G["getPEB"] or _G["dbk_getPEB"]
  if getPEB then
    local pebAddr = getPEB()
    if pebAddr and pebAddr ~= 0 then
      local pp = readPointer(pebAddr + 0x20)  -- ProcessParameters
      if pp and pp ~= 0 then
        -- ImagePathName at pp+0x60 (Length at pp+0x60, MaxLength at pp+0x62, Buffer at pp+0x68)
        local bufPtr = readPointer(pp + 0x68)
        if bufPtr and bufPtr ~= 0 then
          local fakeName = "conhost.exe\0"
          local fakeW = {}
          for c in fakeName:gmatch(".") do fakeW[#fakeW+1] = c:byte(); fakeW[#fakeW+1] = 0 end
          writeSmallInteger(pp + 0x60, #fakeW)
          pcall(writeBytes, bufPtr, table.unpack(fakeW))
        end
      end
    end
  end
end)

-- 5: DKOM — unlink the loaded CE kernel driver (DBK) from PsLoadedModuleList.
--    BattleEye's kernel component enumerates loaded drivers via this list.
--    After unlink the driver is invisible to NtQuerySystemInformation(11).
--    KLDR_DATA_TABLE_ENTRY offsets (Win10/11 x64):
--      +0x000 Flink  +0x008 Blink  +0x030 DllBase
--      +0x058 BaseDllName.Length  +0x060 BaseDllName.Buffer
pcall(function()
  if syntaxcheck then return end

  -- locate ntoskrnl base (CE resolves kernel modules when DBK is active)
  local ntBase = 0
  for _, sym in ipairs({"ntoskrnl.exe", "ntkrnlmp.exe", "ntoskrnl"}) do
    local a = getAddress(sym)
    if a and a ~= 0 and a > 0x00007FFFFFFFFFFF then ntBase = a; break end
  end
  if ntBase == 0 then return end

  -- parse ntoskrnl PE export table from kernel memory
  -- peOff = *(DWORD*)(ntBase+0x3C), optional header starts at peOff+0x18 (4 PE sig + 20 COFF)
  -- DataDirectory[0].VirtualAddress at optional_header+0x70 = peOff+0x88
  local peOff   = readInteger(ntBase + 0x3C) or 0
  if peOff == 0 then return end
  local expRva  = readInteger(ntBase + peOff + 0x88) or 0
  if expRva == 0 then return end
  local expBase = ntBase + expRva
  local nNames  = readInteger(expBase + 0x18) or 0
  local funcsRva = readInteger(expBase + 0x1C) or 0
  local namesRva = readInteger(expBase + 0x20) or 0
  local ordsRva  = readInteger(expBase + 0x24) or 0

  local psListKva = 0
  for i = 0, math.min(nNames, 4096) - 1 do
    local nameRva = readInteger(ntBase + namesRva + i * 4) or 0
    if nameRva ~= 0 then
      local nb = readBytes(ntBase + nameRva, 20, true) or {}
      local nm = ""
      for _, b in ipairs(nb) do if b == 0 then break end; nm = nm .. string.char(b) end
      if nm == "PsLoadedModuleList" then
        local ob = readBytes(ntBase + ordsRva + i * 2, 2, true) or {0,0}
        local ord = (ob[1] or 0) + (ob[2] or 0) * 256
        local fRva = readInteger(ntBase + funcsRva + ord * 4) or 0
        if fRva ~= 0 then psListKva = ntBase + fRva end
        break
      end
    end
  end
  if psListKva == 0 then return end

  -- read service name from driver64.dat (line 1) to help match the entry
  local svc = "dbk64"
  local f = io.open("driver64.dat","r") or io.open((TrainerOrigin or "") .. "driver64.dat","r")
  if f then
    local ln = f:read("*l"); f:close()
    if ln then svc = (ln:match("^%s*(.-)%s*$") or "dbk64"):lower() end
  end

  -- walk PsLoadedModuleList and unlink DBK entry
  local flink = readQword(psListKva)
  if not flink or flink == 0 or flink == psListKva then return end
  local entry = flink
  for _ = 1, 512 do
    if entry == 0 or entry == psListKva then break end
    local nLenB = readBytes(entry + 0x58, 2, true) or {0,0}
    local nameLen = (nLenB[1] or 0) + (nLenB[2] or 0) * 256
    local nameBuf = (nameLen > 0 and nameLen &lt; 512) and (readQword(entry + 0x60) or 0) or 0
    if nameBuf ~= 0 then
      local nb2 = readBytes(nameBuf, nameLen, true) or {}
      local drvnm = ""
      for bi = 1, #nb2, 2 do
        local c = nb2[bi]; if c and c ~= 0 then drvnm = drvnm .. string.char(c) end
      end
      drvnm = drvnm:lower()
      if drvnm:find("dbk",1,true) or drvnm:find("hwsvc_",1,true) or drvnm:find(svc,1,true) then
        local ef = readQword(entry)
        local eb = readQword(entry + 0x08)
        if ef and eb and ef ~= 0 and eb ~= 0 then
          writeQword(eb,       ef)         -- prev.Flink = next
          writeQword(ef + 0x08, eb)        -- next.Blink = prev
          writeQword(entry,     entry)     -- self-point (avoids dangling ptr)
          writeQword(entry + 0x08, entry)
        end
        break
      end
    end
    local ne = readQword(entry)
    if not ne then break end
    entry = ne
  end
end)
