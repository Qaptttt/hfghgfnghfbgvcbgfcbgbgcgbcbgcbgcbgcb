  {"ShieldSize",     "C6 F3 0F 10 B3 D4 00 00 00 48"},  -- d2+A8792  offset B8→D4 (leading C6)
  {"Damage2",        "F3 44 0F 10 61 08 44 0F 29 A8 68 FF FF FF 45 0F 57 ED"},  -- d2+1747F05 offset 24→08
  {"Orb2",           "DEAD"},  -- no reliable pattern in current build
