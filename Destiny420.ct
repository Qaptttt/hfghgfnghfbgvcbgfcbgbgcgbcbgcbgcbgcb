          <ID>2271</ID>
          <Description>"Timers"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- pattern dead as of last scan; guard so aobscan failure doesn't leave dangling labels
local r = AOBScan("48 89 8B A0 00 00 00 48 8D 4C 24 30")
if not r or r.Count == 0 then
  if r then r.destroy() end
  error("Timers pattern NOMATCH - needs rescan")
end
local addr = tonumber(r[0], 16); r.destroy()
if not addr or addr == 0 then error("Timers addr=0") end
registerSymbol("INJECT_TIMERS", addr)
{$asm}
alloc(newmem,$1000,INJECT_TIMERS)
label(code)
label(return)
newmem:
code:
  mov [rbx+000000A0],rcx
  jmp return
INJECT_TIMERS:
  jmp newmem
  nop 2
return:

[DISABLE]
{$lua}
if syntaxcheck then return end
local addr = getAddressSafe("INJECT_TIMERS")
if addr and addr ~= 0 then
  pcall(writeBytes, addr, 0x48,0x89,0x8B,0xA0,0x00,0x00,0x00)
end
unregisterSymbol("INJECT_TIMERS")
{$asm}
dealloc(newmem)

