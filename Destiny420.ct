  {"PlayerSpeed",    "0F 10 47 04 48 8B 7C 24 38 48 83 C4 20 5B C3 F3"},
  -- InfAmmo uses pointer chain (no AOB), depends on LocalPlayer
  {"ViewAngles",     "F3 0F 11 47 1C 7A"},
  -- Freecam hook
  {"Freecam",        "89 01 48 8D 49 04 49 83 E8 01 75 F1 EB 2E"},  -- d2+528CB3 (was 48→EB)
  -- pSticky base unique: 50 CD suffix selects d2+287F1A8
  {"pStickyBase",    "90 95 80 80 00 00 00 00 50 CD"},
  -- Chams base unique: 10 BF suffix selects d2+287EAB8
  {"ChamsBase",      "A6 95 80 80 00 00 00 00 10 BF"},
}
for _, e in ipairs(exact) do
  local hits = scan(e[2])
  if #hits == 0 then
    w("MISS  " .. e[1] .. "  " .. e[2])
  elseif #hits == 1 then
    w("OK    " .. e[1] .. "  @d2+" .. string.format("%X", hits[1]-d2base) .. "  " .. ctx(hits[1],6,20))
  else
    w("DUP(" .. #hits .. ")  " .. e[1])
    for _, h in ipairs(hits) do
      w("      d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,20))
    end
  end
end

