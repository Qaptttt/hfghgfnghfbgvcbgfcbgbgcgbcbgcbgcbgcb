w("  OLD 2F40E60 (DirectFly)    = " .. tostring(getAddressSafe('destiny2.exe+2F40E60')))

-- Resolve RIP-relative instruction target
local function resolveRIP(h, instrLen, off)
  local b = readBytes(h + off, 4, true)
  if not b or #b &lt; 4 then return nil end
  local d = b[1] + b[2]*256 + b[3]*65536 + b[4]*16777216
  if d >= 0x80000000 then d = d - 0x100000000 end
  return h + instrLen + d
end

-- Scan REX.W MOV/LEA rXX,[rip+d32] that point into d2 data (0x100000..0xA000000)
local rip_modrm = {"05","0D","15","1D","25","2D","35","3D"}
local cands = {}
local function addRIPcands(prefix, instrLen, label)
  for _, mr in ipairs(rip_modrm) do
    local hits = scan(string.format("48 %s %s ?? ?? ?? ??", prefix, mr), 200)
    for _, h in ipairs(hits) do
      local tgt = resolveRIP(h, instrLen, 3)
      if tgt then
        local off = tgt - d2base
        if off >= 0x100000 and off &lt;= 0xA000000 then
          cands[#cands+1] = {h-d2base, off, label}
        end
      end
    end
  end
end
addRIPcands("8B", 7, "MOV_r64")
addRIPcands("8D", 7, "LEA_r64")

-- Also scan MOVSS [rip+d32],xmm (write path to static floats)
local movss_w_modrm = {"05","0D","15","1D","25","2D","35","3D"}
for _, mr in ipairs(movss_w_modrm) do
  local hits = scan(string.format("F3 0F 11 %s ?? ?? ?? ??", mr), 200)
  for _, h in ipairs(hits) do
    local tgt = resolveRIP(h, 8, 4)
    if tgt then
      local off = tgt - d2base
      if off >= 0x100000 and off &lt;= 0xA000000 then
        cands[#cands+1] = {h-d2base, off, "MOVSS_WRITE"}
      end
    end
  end
end

table.sort(cands, function(a,b) return a[2] &lt; b[2] end)
if #cands == 0 then
  w("  None found in d2+100000..A000000")
else
  local prev = -1
  for i = 1, math.min(80, #cands) do
    local c = cands[i]
    if c[2] - prev > 0x800 then w("") end
    w(string.format("  instr@d2+%X  ->  data@d2+%X  [%s]", c[1], c[2], c[3]))
    prev = c[2]
  end
  w(string.format("  Total %d candidates (showed %d)", #cands, math.min(80,#cands)))
end

-- 鈹€鈹€ destinyBase DIRECT READ TEST 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
w("")
w("--- destinyBase direct float read test (look for ~-1 to 1 direction vecs) ---")
-- If we know any candidate that could be destinyBase, check offset+0x10..+0x18 for unit vectors
if #cands > 0 then
  for i = 1, math.min(20, #cands) do
    local c = cands[i]
    local tgt = d2base + c[2]
    local ok, vals = pcall(function()
      local x = readFloat(tgt + 0x10)
      local y = readFloat(tgt + 0x14)
      local z = readFloat(tgt + 0x18)
      return {x, y, z}
    end)
    if ok and vals then
      local x,y,z = vals[1],vals[2],vals[3]
      -- direction vector should have magnitude ~1.0
      local mag2 = x*x + y*y + z*z
      if mag2 > 0.5 and mag2 &lt; 2.0 then
        w(string.format("  CANDIDATE destinyBase@d2+%X  dir=%.3f,%.3f,%.3f  |mag2=%.3f|", c[2], x,y,z, mag2))
      end
    end
  end
end

w("")
-- ── SECTION 3: AMMO SYSTEM ──────────────────────────────────────────────────
w("")
w("--- SECTION 3: AMMO SYSTEM (InfAmmo fix) ---")
do
  local ammo_pats = {
    {"WepSlot_2C8","48 8B ?? C8 02 00 00 48 85 ?? 74","wep ptr at player+0x2C8"},
    {"WepSlot_2D0","48 8B ?? D0 02 00 00 48 85 ?? 74","wep ptr at player+0x2D0"},
    {"WepSlot_var","48 8B ?? ?? 02 00 00 48 85 ?? 74","wep ptr at player+0x2xx"},
    {"MagDec_32",  "FF C8 89 ?? ?? ?? ?? ?? 48 8B",  "dec eax; store32"},
    {"MagDec_16",  "FF C8 66 89 ?? ?? ?? ??",         "dec eax; store16"},
    {"MagSub_16",  "66 FF 4? ?? 00 00 00",            "dec word [reg+off]"},
    {"WepAmmo_0C", "8B ?? 0C 00 00 00 FF C? 89 ?? 0C 00 00 00","rw +0x0C"},
    {"WepAmmo_18", "8B ?? 18 00 00 00 FF C? 89 ?? 18 00 00 00","rw +0x18"},
    {"WepAmmo_20", "8B ?? 20 00 00 00 FF C? 89 ?? 20 00 00 00","rw +0x20"},
    {"WepAmmo_24", "8B ?? 24 00 00 00 FF C? 89 ?? 24 00 00 00","rw +0x24"},
    {"WepAmmo_30", "8B ?? 30 00 00 00 FF C? 89 ?? 30 00 00 00","rw +0x30"},
    {"WepMaxMag",  "8B ?? ?? 00 00 00 3B ?? ?? 00 00 00 7C","compare mag/maxmag"},
  }
  for _, e in ipairs(ammo_pats) do
    local hits = scan(e[2], 4)
    if #hits == 0 then
      w("NOMATCH  " .. e[1] .. "  [" .. e[3] .. "]")
    else
      w("FOUND(" .. #hits .. ")  " .. e[1] .. "  [" .. e[3] .. "]")
      for _, h in ipairs(hits) do
        w("  d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,28))
      end
    end
  end
end

-- ── SECTION 4: ENTITY SYSTEM (Aimbot) ───────────────────────────────────────
w("")
w("--- SECTION 4: ENTITY SYSTEM (Aimbot) ---")
do
  local ent_pats = {
    {"EntIter_rcx", "48 8B 04 C1 48 85 C0 74","ent=[rcx+rax*8]; null check"},
    {"EntIter_rdx", "48 8B 04 D1 48 85 C0 74","ent=[rcx+rdx*8]; null check"},
    {"EntIter_rsi", "48 8B 04 F1 48 85 C0 74","ent=[rcx+rsi*8]; null check"},
    {"EntListPtr1", "48 8B 05 ?? ?? ?? ?? 48 85 C0 74 ?? 48 8B 00","list ptr; null; deref"},
    {"EntListPtr2", "48 8B 0D ?? ?? ?? ?? 48 85 C9 74 ?? 8B 41","mgr ptr; null; read count"},
    {"EntPos_r",    "F3 0F 10 ?? C0 01 00 00","movss read +0x1C0"},
    {"EntPos_w",    "F3 0F 11 ?? C0 01 00 00","movss write +0x1C0"},
    {"EntHP_read1", "F3 0F 10 ?? 40 00 00 00 0F 2F","hp float +0x40; compare"},
    {"EntHP_read2", "F3 0F 10 ?? 44 00 00 00 0F 2F","hp float +0x44; compare"},
    {"EntHP_read3", "F3 0F 10 ?? 50 00 00 00 0F 2F","hp float +0x50; compare"},
    {"EntHP_write", "F3 41 0F 5C ?? F3 0F 11 ?? ?? 00 00 00","sub hp; store back"},
    {"EntNearCS",   "A6 95 80 80 00 00 00 00","chams class tag"},
    {"EntScan",     "90 95 80 80 00 00 00 00","pSticky class tag"},
  }
  for _, e in ipairs(ent_pats) do
    local hits = scan(e[2], 6)
    if #hits == 0 then
      w("NOMATCH  " .. e[1] .. "  [" .. e[3] .. "]")
    else
      w("FOUND(" .. #hits .. ")  " .. e[1] .. "  [" .. e[3] .. "]")
      for _, h in ipairs(hits) do
        local extra = ""
        if e[1]:find("Ptr") then
          local tgt = resolveRIP(h, 7, 3)
          if tgt then extra = "  ->d2+" .. string.format("%X", tgt-d2base) end
        end
        w("  d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,28) .. extra)
      end
    end
  end
end

w("")
w("--- SECTION 4b: LIVE ENTITY SCAN (enemies near player) ---")
do
  local playerSym = getAddressSafe("Player")
  if playerSym and playerSym ~= 0 then
    local lp = readPointer(playerSym)
    if lp and lp ~= 0 then
      local px = readFloat(lp + 0x1C0)
      local py = readFloat(lp + 0x1C4)
      local pz = readFloat(lp + 0x1C8)
      if px == px then
        w(string.format("  PlayerPos=%.2f,%.2f,%.2f  ptr=0x%X", px,py,pz,lp))
        local RANGE = 300
        local stride = 0x800
        local found = 0
        local rBase, rSize = lp - 0x200000, 0x400000
        local ok2, regions = pcall(getMemoryRegions)
        if ok2 and regions then
          for i = 0, regions.Count - 1 do
            local r = regions[i]
            if r.BaseAddress &lt;= lp and lp &lt; r.BaseAddress + r.RegionSize then
              rBase = r.BaseAddress; rSize = r.RegionSize; break
            end
          end
          regions.destroy()
        end
        for off = 0, rSize - 0x200, stride do
          local a = rBase + off
          if a ~= lp and a > 0x10000000 then
            local ok1, x = pcall(readFloat, a + 0x1C0)
            if ok1 and x == x and math.abs(x - px) &lt; RANGE then
              local ok3, y = pcall(readFloat, a + 0x1C4)
              if ok3 and y == y and math.abs(y - py) &lt; RANGE then
                local ok4, z = pcall(readFloat, a + 0x1C8)
                if ok4 and z == z and math.abs(z - pz) &lt; RANGE then
                  found = found + 1
                  w(string.format("  ENT@0x%X  d2+%X  xyz=%.1f,%.1f,%.1f", a, a-d2base, x,y,z))
                  if found >= 20 then w("  (capped at 20)") break end
                end
              end
            end
          end
        end
        if found == 0 then w("  No entities near player (be in-game with enemies visible)") end
      else w("  LocalPlayer not populated -- enable LocalPlayer hook first") end
    else w("  Player ptr=0 -- enable LocalPlayer hook first") end
  else w("  Player symbol missing") end
end

-- ── SECTION 5: INVENTORY ────────────────────────────────────────────────────
w("")
w("--- SECTION 5: INVENTORY / CHARACTER STATS ---")
do
  local inv_pats = {
    {"InvPtr1",   "48 8B 05 ?? ?? ?? ?? 48 85 C0 74 ?? 48 8B 80","load ptr; deref+off"},
    {"InvPtr2",   "48 8B 0D ?? ?? ?? ?? 48 85 C9 74 ?? 48 8B 89","load ptr; deref+"},
    {"LightLvl1", "F3 0F 10 ?? 98 0C 00 00","movss +0xC98 (light level)"},
    {"LightLvl2", "F3 0F 10 ?? ?? 0C 00 00","movss +0xCxx"},
    {"GRank",     "0F B7 ?? 84 1E 00 00","movzx guardian rank +0x1E84"},
    {"CharData1", "48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B","lea static char; call"},
    {"CharData2", "48 8B 35 ?? ?? ?? ?? 48 85 F6 74 ?? 48 8B 86","load char ptr"},
  }
  for _, e in ipairs(inv_pats) do
    local hits = scan(e[2], 4)
    if #hits == 0 then
      w("NOMATCH  " .. e[1] .. "  [" .. e[3] .. "]")
    else
      w("FOUND(" .. #hits .. ")  " .. e[1] .. "  [" .. e[3] .. "]")
      for _, h in ipairs(hits) do
        local extra = ""
        if e[1]:find("Ptr") or e[1]:find("Data") then
          local tgt = resolveRIP(h, 7, 3)
          if tgt then extra = "  ->static@d2+" .. string.format("%X", tgt-d2base) end
        end
        w("  d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,24) .. extra)
      end
    end
  end
end

-- ── SECTION 6: PLAYER POSITION WRITES ───────────────────────────────────────
w("")
w("--- SECTION 6: POSITION WRITES (fly confirm) ---")
do
  local posw_pats = {
    {"PosWrite_X",  "F3 0F 11 ?? C0 01 00 00","movss write +0x1C0 (X)"},
    {"PosRead_X",   "F3 0F 10 ?? C0 01 00 00 F3 0F 10 ?? C4 01","movss read XY"},
    {"VelWrite",    "F3 0F 11 ?? 30 02 00 00","movss write +0x230 (velX)"},
    {"VelWrite2",   "F3 0F 11 ?? 34 02 00 00","movss write +0x234 (velY)"},
    {"PosXYZ_16",   "0F 11 ?? C0 01 00 00","movups write +0x1C0"},
  }
  for _, e in ipairs(posw_pats) do
    local hits = scan(e[2], 6)
    if #hits == 0 then
      w("NOMATCH  " .. e[1] .. "  [" .. e[3] .. "]")
    else
      w("FOUND(" .. #hits .. ")  " .. e[1] .. "  [" .. e[3] .. "]")
      for _, h in ipairs(hits) do
        w("  d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,24))
      end
    end
  end
end

-- ── SECTION 7: WEAPON STATS ──────────────────────────────────────────────────
w("")
w("--- SECTION 7: WEAPON STAT TABLE ---")
do
  local wep_pats = {
    {"WepClassTag", "90 95 80 80 00 00 00 00","pSticky class tag"},
    {"WepClassAlt", "8F 95 80 80 00 00 00 00","adjacent class tag"},
    {"WepRPM",      "F3 0F 10 ?? ?? ?? ?? ?? F3 0F 59 ?? ?? ?? ?? ?? F3 0F 11","RPM multiply"},
    {"WepRange",    "F3 0F 10 ?? 50 00 00 00 F3 0F 59","range float +0x50"},
    {"WepFull1",    "F7 43 EA 80 ?? 95 80 80","flags near class tag"},
  }
  for _, e in ipairs(wep_pats) do
    local hits = scan(e[2], 4)
    if #hits == 0 then
      w("NOMATCH  " .. e[1] .. "  [" .. e[3] .. "]")
    else
      w("FOUND(" .. #hits .. ")  " .. e[1] .. "  [" .. e[3] .. "]")
      for _, h in ipairs(hits) do
        w("  d2+" .. string.format("%X",h-d2base) .. "  " .. ctx(h,6,28))
      end
    end
  end
end

w("")
w("=== END V2 (7 sections) ===")

local function notify(msg)
  local dlg = createForm(true)
  dlg.Caption = "D2 Scanner V2"
  dlg.Width = 440; dlg.Height = 120
  dlg.Position = poScreenCenter
  dlg.FormStyle = fsStayOnTop
  dlg.BorderStyle = bsDialog
  local lbl = createLabel(dlg)
  lbl.Left = 12; lbl.Top = 12; lbl.Width = 416; lbl.Height = 60
  lbl.WordWrap = true
  lbl.Caption = msg
  local btn = createButton(dlg)
  btn.Caption = "OK"; btn.Left = 180; btn.Top = 78; btn.Width = 80; btn.Height = 26
  btn.OnClick = function() dlg.Close() end
  dlg.ShowModal(); dlg.Destroy()
end

if outFile then
  outFile:close()
  notify("Scan V2 complete!\n" .. OUT .. "\n7 sections: CT/ammo/entities/inventory/positions/weapons")
else
  notify("WRITE FAILED — could not open output file")
end
