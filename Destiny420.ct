-- Driver check: use dbk_initialize() — actual kernel driver test, not an AOB scan
local function runDrvCheck()
  local pid = getOpenedProcessID()
  if not pid or pid == 0 then
    lblStatus.Caption = "● NOT ATTACHED"; lblStatus.Font.Color = C_RED; return
  end
  local ok = pcall(function() dbk_initialize() end)
  if ok then
    lblStatus.Caption = "● DRIVER OK";   lblStatus.Font.Color = C_GREEN
  else
    lblStatus.Caption = "● DRIVER FAIL"; lblStatus.Font.Color = C_RED
  end
end
drvBtn.OnClick = runDrvCheck

scanBtn.OnClick = function()
  local e = getE(9000); if not e then return end
  scanBtn.Caption = "SCANNING..."
  local t = createTimer(nil, false); t.Interval = 60
  t.OnTimer = function()
    t.Enabled = false; pcall(function() e.Active = true end)
    scanBtn.Caption = "AOB SCANNER"; t.Destroy()
  end
  t.Enabled = true
end

setTab("PLAYER")

_G["_dseMsg"]        = nil   -- set by autoDSEToggleAsync thread, read by refreshTmr
_G["_dseMsgClr"]     = nil
_G["_dseCheckPending"] = false  -- signals refreshTmr to call dbk_initialize on main thread

local refreshTmr = createTimer(nil, false)
refreshTmr.Interval = 600
refreshTmr.OnTimer = function()
  for _, r in ipairs(btnList) do r.refresh() end
  -- driver check after DSE toggle (must run on main thread, not inside native thread)
  if _G["_dseCheckPending"] then
    _G["_dseCheckPending"] = false
    local ok = false
    pcall(function() ok = (dbk_initialize() == true) end)
    _G["_dseMsg"]    = ok and "DRIVER OK" or "DRIVER FAIL"
    _G["_dseMsgClr"] = ok and C_GREEN or C_RED
  end
  local msg = _G["_dseMsg"]
  if msg then
    lblStatus.Caption = "● " .. msg
    lblStatus.Font.Color = _G["_dseMsgClr"] or 0xFF8800
    if msg == "DRIVER OK" or msg == "DRIVER FAIL" then _G["_dseMsg"] = nil end
  end
end
refreshTmr.Enabled  = true

local attachTmr = createTimer(nil, false)
attachTmr.Interval = 1500
attachTmr.OnTimer  = function()
  if tryAttach() then
    attachTmr.Enabled = false
    lblStatus.Caption = "● ATTACHED"; lblStatus.Font.Color = C_GREEN
  end
end
if tryAttach() then
  lblStatus.Caption = "● ATTACHED"; lblStatus.Font.Color = C_GREEN
else
  attachTmr.Enabled = true
end

-- Apply custom icon so taskbar/title bar don't show the CE gear
pcall(function()
  local origin = TrainerOrigin or ''
  if origin == '' then return end
  local icoPath = origin .. 'icon.ico'
  local fh = io.open(icoPath, 'rb')  -- existence check before LoadFromFile
  if not fh then return end
  fh:close()
  pcall(function() F.Icon.LoadFromFile(icoPath) end)
  pcall(function() getMainForm().Icon.LoadFromFile(icoPath) end)
end)

-- ═══ PREREQUISITE AUTO-FIX ═══
local function showRebootDialog(reason)
  local dlg = createForm(true)
  dlg.Caption = "BOBS D2 — Reboot Required"
  dlg.Width = 400; dlg.Height = 180
  dlg.Color = 0x141414; dlg.BorderStyle = "bsSingle"
  dlg.Position = "poScreenCenter"

  local function mk(parent, cls, ...)
    local w = cls(parent); return w
  end

  local lbl1 = createLabel(dlg)
  lbl1.Caption = reason
  lbl1.Left = 20; lbl1.Top = 18
  lbl1.Font.Size = 9; lbl1.Font.Bold = true; lbl1.Font.Color = 0xFF4444
  lbl1.Color = 0x141414; lbl1.ParentColor = false; lbl1.AutoSize = true

  local lbl2 = createLabel(dlg)
  lbl2.Caption = "A reboot is required before the driver can load.\nSave your work before rebooting."
  lbl2.Left = 20; lbl2.Top = 46
  lbl2.Font.Size = 8; lbl2.Font.Color = 0xBBBBBB
  lbl2.Color = 0x141414; lbl2.ParentColor = false; lbl2.AutoSize = true

  local btnNow = createButton(dlg)
  btnNow.Caption = "REBOOT NOW"
  btnNow.Left = 20; btnNow.Top = 108; btnNow.Width = 140; btnNow.Height = 32
  btnNow.Font.Bold = true; btnNow.Font.Color = 0xFFFFFF; btnNow.Color = 0x882222
  btnNow.OnClick = function()
    dlg.Close()
    shellExecute("open", "shutdown.exe", "/r /t 5", "", 0)
  end

  local btnLater = createButton(dlg)
  btnLater.Caption = "Later"
  btnLater.Left = 174; btnLater.Top = 108; btnLater.Width = 80; btnLater.Height = 32
  btnLater.OnClick = function() dlg.Close() end

  dlg.Show()
end

-- Auto DSE toggle via -off / -on flags (no interactive prompt, no bat trick).
-- Flow: disable DSE.exe -off  →  sc start driver  →  disable DSE.exe -on
-- Runs in a native thread so CE UI stays responsive during sleeps.
local function autoDSEToggleAsync(svcName)
  local origin = TrainerOrigin or ""
  local dseExe = "disable DSE.exe"
  local fck = io.open(dseExe, "rb")
  if not fck then
    dseExe = origin .. "disable DSE.exe"
    fck = io.open(dseExe, "rb")
    if not fck then return end
  end
  fck:close()

  createNativeThread(function()
    _G["_dseMsg"]    = "DSE: off..."
    _G["_dseMsgClr"] = 0xFF8800

    -- patch DSE silently; saves state to %TEMP%\dse_state.bin and exits immediately
    os.execute('"' .. dseExe .. '" -off')
    sleep(2500)

    if svcName and #svcName > 1 then
      os.execute('sc start "' .. svcName .. '" >nul 2>nul')
    end
    sleep(1500)

    -- restore DSE from saved state; exits immediately
    os.execute('"' .. dseExe .. '" -on')
    sleep(800)

    _G["_dseCheckPending"] = true
    _G["_dseMsg"]    = "DSE: checking..."
    _G["_dseMsgClr"] = 0xFF8800
  end)
end

local function runPrereqCheck()
  -- Step 1: test driver
  local drvOK = false
  pcall(function() drvOK = (dbk_initialize() == true) end)

  -- Step 1b: if driver not loaded, auto-attempt DSE toggle + sc start
  if not drvOK then
    pcall(function()
      local f = io.open("driver64.dat", "r")
      if not f then return end
      local svc = (f:read("*l") or ""):match("^%s*(.-)%s*$")
      f:close()
      if svc and #svc > 1 then
        autoDSEToggleAsync(svc)  -- async — returns immediately, thread handles the rest
      end
    end)
    return  -- prereq bat is pointless until DSE flow finishes; async will update status
  end

  -- Step 2: write a bat that checks + fixes HVCI, writes result to temp file
  local resPath = (os.getenv("TEMP") or "C:\\Windows\\Temp").."\\d2prereq_result.txt"
  local batPath = (os.getenv("TEMP") or "C:\\Windows\\Temp").."\\d2prereq_fix.bat"
  os.remove(resPath)
  local bat = io.open(batPath, "w")
  if bat then
    bat:write('@echo off\r\n')
    bat:write('set FIXED=0\r\n')
    bat:write('set SECBOOT=0\r\n')
    -- Check Secure Boot first — if on, nointegritychecks is silently ignored by Windows
    bat:write('REG QUERY "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\State" /v UEFISecureBootEnabled 2>nul | findstr /C:"0x1" >nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set SECBOOT=1\r\n')
    -- Key 1: HVCI scenario (Win10 + Win11)
    bat:write('REG QUERY "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity" /v Enabled 2>nul | findstr /C:"0x1" >nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity" /v Enabled /t REG_DWORD /d 0 /f >nul 2>nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- Key 2: VBS
    bat:write('REG QUERY "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard" /v EnableVirtualizationBasedSecurity 2>nul | findstr /C:"0x1" >nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard" /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f >nul 2>nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- Key 3: Policy HVCI
    bat:write('REG QUERY "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard" /v HypervisorEnforcedCodeIntegrity 2>nul | findstr /C:"0x1" >nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard" /v HypervisorEnforcedCodeIntegrity /t REG_DWORD /d 0 /f >nul 2>nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- bcdedit: kill hypervisor launch
    bat:write('bcdedit /set hypervisorlaunchtype off >nul 2>nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set FIXED=1\r\n')
    -- DSE bypass via nointegritychecks (Win11 24H2 — disable DSE.exe no longer reliable)
    -- Only works when Secure Boot is OFF; if SECBOOT=1 we report that instead
    -- nointegritychecks: always apply — works on Win10 even with Secure Boot on
    -- On Win11 24H2 with Secure Boot ON this gets ignored, but we still try
    bat:write('bcdedit /set nointegritychecks on >nul 2>nul\r\n')
    bat:write('bcdedit /set testsigning on >nul 2>nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set FIXED=1\r\n')
    -- Disable Hyper-V / VMP / HypervisorPlatform Windows Features (DBVMM VT-x fix)
    bat:write('dism /Online /Disable-Feature /FeatureName:Microsoft-Hyper-V-All /NoRestart /Quiet >nul 2>nul\r\n')
    bat:write('dism /Online /Disable-Feature /FeatureName:VirtualMachinePlatform /NoRestart /Quiet >nul 2>nul\r\n')
    bat:write('dism /Online /Disable-Feature /FeatureName:HypervisorPlatform /NoRestart /Quiet >nul 2>nul\r\n')
    -- Check Windows version to flag Win11 + Secure Boot combo specifically
    bat:write('set WIN11=0\r\n')
    bat:write('ver | findstr /C:"10.0.2" >nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set WIN11=1\r\n')
    -- Write result (goto avoids nested-if scoping issues in cmd)
    bat:write('if "%WIN11%"=="1" if "%SECBOOT%"=="1" goto :sb11\r\n')
    bat:write('if "%FIXED%"=="1" (echo HVCI_FIXED>'..resPath..') else (echo HVCI_OK>'..resPath..')\r\n')
    bat:write('goto :done\r\n')
    bat:write(':sb11\r\n')
    bat:write('echo SECUREBOOT_WIN11>'..resPath..'\r\n')
    bat:write(':done\r\n')
    bat:close()
    shellExecute("runas", "cmd.exe", '/c "'..batPath..'"', "", 0)
  end

  -- Step 3: poll for bat result (up to 10 seconds)
  local pollTmr = createTimer(nil, false)
  pollTmr.Interval = 500
  local pollN = 0
  pollTmr.OnTimer = function()
    pollN = pollN + 1
    local fh = io.open(resPath, "r")
    if fh then
      local result = (fh:read("*l") or ""):match("^%s*(.-)%s*$")
      fh:close()
      pollTmr.Enabled = false; pcall(function() pollTmr.Destroy() end)
      if result == "SECUREBOOT_WIN11" then
        -- Secure Boot blocks nointegritychecks — must go into UEFI
        local dlg = createForm(true)
        dlg.Caption = "BOBS D2 — Secure Boot Blocking Driver"
        dlg.Width = 430; dlg.Height = 210
        dlg.Color = 0x141414; dlg.BorderStyle = "bsSingle"
        dlg.Position = "poScreenCenter"
        local t1 = createLabel(dlg)
        t1.Caption = "Win11 + Secure Boot ON — driver blocked at boot"
        t1.Left = 16; t1.Top = 16; t1.Font.Size = 9; t1.Font.Bold = true
        t1.Font.Color = 0xFF4444; t1.Color = 0x141414; t1.ParentColor = false; t1.AutoSize = true
        local t2 = createLabel(dlg)
        t2.Caption = "Fix (required once):\n1. Restart PC  →  spam DEL / F2 at boot to enter UEFI\n2. Find  Security  →  Secure Boot  →  set DISABLED\n3. Save and reboot back into Windows\n4. Re-open CE and load this CT — driver will auto-fix rest"
        t2.Left = 16; t2.Top = 46; t2.Font.Size = 8
        t2.Font.Color = 0xCCCCCC; t2.Color = 0x141414; t2.ParentColor = false; t2.AutoSize = true
        local btnOK = createButton(dlg)
        btnOK.Caption = "OK, going to UEFI"
        btnOK.Left = 16; btnOK.Top = 164; btnOK.Width = 140; btnOK.Height = 28
        btnOK.Font.Bold = true; btnOK.OnClick = function() dlg.Close() end
        dlg.Show()
        lblStatus.Caption = "● SECURE BOOT"; lblStatus.Font.Color = 0xFF4444
      elseif result == "HVCI_FIXED" then
        showRebootDialog("HVCI + Hyper-V + DSE disabled. Reboot to apply.")
      elseif result == "HVCI_OK" and not drvOK then
        lblStatus.Caption = "● DRIVER FAIL"; lblStatus.Font.Color = 0xFF4444
      end
    elseif pollN > 20 then
      pollTmr.Enabled = false; pcall(function() pollTmr.Destroy() end)
    end
  end
  pollTmr.Enabled = true
end

-- Delay 6s after CT load so CE fully initializes (process watcher, driver, etc.)
local prereqTmr = createTimer(nil, false)
prereqTmr.Interval = 6000
prereqTmr.OnTimer = function()
  prereqTmr.Enabled = false; pcall(function() prereqTmr.Destroy() end)
  pcall(runPrereqCheck)
end
prereqTmr.Enabled = true

F.Show()

</LuaScript>
  <CheatEntries>
    <CheatEntry>
      <ID>9000</ID>
      <Description>"[SCANNER] Enable - writes scan_results.txt then auto-disables"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end

local OUT = "C:\\Users\\Bob\\Downloads\\d2\\scan_results.txt"
local lines = {}
local outFile = io.open(OUT, "w")
local function w(s)
  lines[#lines+1] = s
  if outFile then outFile:write(s .. "\n"); outFile:flush() end
end

local function getD2Base()
  local a = getAddress("destiny2.exe")
  if a and a ~= 0 then return a end
  local seeds = {
    "48 89 86 48 08 00 00 72","0F 11 47 70 41 8B 41 0C",
    "48 03 FA 0F B7 4F 0A","89 47 7C 0F B6 87 CB 00 00 00 44 0F 10 32",
  }
  local hit = nil
  for _, pat in ipairs(seeds) do
    local r = AOBScan(pat)
    if r and r.Count > 0 then
      local c = tonumber(r[0], 16)
      r.destroy()
      if c and c > 0x10000000 then hit = c break end
    elseif r then r.destroy() end
  end
  if not hit then return 0 end
  local base = hit - (hit % 0x10000)
  for i = 1, 2000 do
    base = base - 0x10000
    local ok, b = pcall(readBytes, base, 4, true)
    if ok and b and b[1] == 0x4D and b[2] == 0x5A then
      local ok2, pe = pcall(readInteger, base + 0x3C)
      if ok2 and pe and pe > 0 and pe &lt; 0x400 then
        local ok3, s = pcall(readBytes, base + pe, 2, true)
        if ok3 and s and s[1] == 0x50 and s[2] == 0x45 then return base end
      end
    end
  end
  return 0
end

local d2base = getD2Base()
if d2base == 0 then
  local dlg = createForm(true)
  dlg.Caption = "D2 Scanner"; dlg.Width = 360; dlg.Height = 110
  dlg.Position = poScreenCenter; dlg.FormStyle = fsStayOnTop; dlg.BorderStyle = bsDialog
  local lbl = createLabel(dlg); lbl.Left = 12; lbl.Top = 12; lbl.Width = 336; lbl.Height = 50
  lbl.Caption = "ERROR: d2base=0 — attach CE to destiny2.exe first"
  lbl.WordWrap = true
  local btn = createButton(dlg); btn.Caption = "OK"; btn.Left = 140; btn.Top = 60
  btn.Width = 80; btn.Height = 26; btn.OnClick = function() dlg.Close() end
  dlg.ShowModal(); dlg.Destroy()
  return
end
w("=== D2 SCAN " .. os.date("%Y-%m-%d %H:%M:%S") .. " ===")
w("d2base = " .. string.format("0x%X", d2base))
w("")

local function scan(pat, maxhits)
  maxhits = maxhits or 6
  local r = AOBScan(pat)
  local hits = {}
  if r then
    for i = 0, r.Count - 1 do
      local a = tonumber(r[i], 16)
      if a >= d2base and a &lt; d2base + 0x8000000 then
        hits[#hits+1] = a
        if #hits >= maxhits then break end
      end
    end
    r.destroy()
  end
  return hits
end

local function ctx(addr, bef, aft)
  local data = readBytes(addr - bef, bef + aft, true)
  if not data then return "??" end
  local s = ""
  for i, b in ipairs(data) do
    if i == bef + 1 then s = s .. "| " end
    s = s .. string.format("%02X ", b)
  end
  return s
end

-- 鈹€鈹€ EXACT PATTERNS (CT patterns) 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
w("--- EXACT PATTERNS (CT AOBs) ---")
local exact = {
