  end
end
if _G["SpoofTramp9031"] then
  pcall(deAlloc, _G["SpoofTramp9031"])
  _G["SpoofTramp9031"] = nil
end
if _G["SpoofTrampA9031"] then
  pcall(deAlloc, _G["SpoofTrampA9031"])
  _G["SpoofTrampA9031"] = nil
end
_G["SpoofPatched9031"] = nil
_G["SpoofGUID9031"] = nil
_G["SpoofFakeSerial9031"] = nil
