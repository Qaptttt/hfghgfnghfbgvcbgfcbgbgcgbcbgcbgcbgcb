            writeFloat(playerBase + 0x1C4, 9.264609337)
            writeFloat(playerBase + 0x1C8, 512.3733521)
            end
       if isKeyPressed(VK_0) then
            writeFloat(playerBase + 0x1C0, 1853.918579)
            writeFloat(playerBase + 0x1C4, -147.10289)
            writeFloat(playerBase + 0x1C8, 503.8335266)
            end
       if isKeyPressed(VK_P) then
            writeFloat(playerBase + 0x1C0, 1829.626953)
            writeFloat(playerBase + 0x1C4, -32.74996948)
            writeFloat(playerBase + 0x1C8, -323.2670593)
            end
       if isKeyPressed(VK_DECIMAL) then
            writeFloat(playerBase + 0x1C0, 1905.892578)
            writeFloat(playerBase + 0x1C4, 1536.254761)
            writeFloat(playerBase + 0x1C8, 2128.957764)
            end

        end
    end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 1
  tmr.OnTimer = checkKeys
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()

[DISABLE]
disableFunction()







