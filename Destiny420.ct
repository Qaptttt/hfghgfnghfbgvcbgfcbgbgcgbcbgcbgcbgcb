    <CheatEntry>
      <ID>9031</ID>
      <Description>"HWID Spoofer"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

math.randomseed(getTickCount())
local _unpack = table.unpack or unpack

local function rh(n)
  return string.format("%0"..n.."X", math.random(0, (16^n)-1))
end

local fakeSerial = math.random(0x10000000, 0x7FFFFFFF)
local fakeGUID   = rh(8).."-"..rh(4).."-4"..rh(3).."-"..rh(4).."-"..rh(12)

-- addr to 8 LE bytes (table)
local function q2b(a)
  local b = {}
  for i = 1, 8 do b[i] = a &amp; 0xFF; a = a >> 8 end
  return b
end

-- dword to 4 LE bytes (table)
local function d2b(v)
  return {v &amp; 0xFF, (v >> 8) &amp; 0xFF, (v >> 16) &amp; 0xFF, (v >> 24) &amp; 0xFF}
end

local function extend(t, src)
  for _, v in ipairs(src) do t[#t+1] = v end
end

-- Walk one PE's IAT, find target_addr, overwrite thunk with hook_addr.
-- Returns the thunk VA on success, nil on failure.
-- Import dir is DataDirectory[1]: PE+0x18(OptHdr)+0x78(DD[1].RVA)
local function iatPatch(pe_base, target_addr, hook_addr)
  if not pe_base or pe_base == 0 then return nil end
  local lf = readInteger(pe_base + 0x3C)
  if not lf then return nil end
  -- PE32+ magic check
  if readSmallInteger(pe_base + lf + 0x18) ~= 0x20B then return nil end
  local impRVA  = readInteger(pe_base + lf + 0x18 + 0x78)
  local impSize = readInteger(pe_base + lf + 0x18 + 0x7C)
  if not impRVA or impRVA == 0 then return nil end
  local desc = pe_base + impRVA
  for _ = 0, math.floor(impSize / 20) - 1 do
    local nameRVA = readInteger(desc + 0x0C)
    local ftRVA   = readInteger(desc + 0x10)
    if nameRVA == 0 and ftRVA == 0 then break end
    if ftRVA ~= 0 then
      local thunk = pe_base + ftRVA
      for _ = 1, 16384 do
        local fp = readPointer(thunk)
        if not fp or fp == 0 then break end
        if fp == target_addr then
          if pcall(writePointer, thunk, hook_addr) then return thunk end
          return nil
        end
        thunk = thunk + 8
      end
    end
    desc = desc + 20
  end
  return nil
end

-- Build GetVolumeInformation trampoline (W and A share same logic).
-- Uses RIP-relative scratch to save R9 — zero RSP delta so
-- the callee sees stack params 5-8 at their correct positions.
-- Layout (44 bytes code, scratch qword at offset 0x30):
--   4C 89 0D 29 00 00 00   mov [rip+0x29], r9
--   48 B8 [8]              mov rax, origAddr
--   FF D0                  call rax
--   85 C0                  test eax, eax
--   74 14                  jz done
--   4C 8B 0D 12 00 00 00   mov r9, [rip+0x12]
--   4D 85 C9               test r9, r9
--   74 08                  jz done
--   BA [4]                 mov edx, fakeSerial
--   41 89 11               mov [r9], edx
-- done: C3                 ret
local function buildVolTramp(origAddr)
  local tramp = allocateMemory(64)
  if not tramp or tramp == 0 then return nil end
  local sc = {
    0x4C,0x89,0x0D,0x29,0x00,0x00,0x00,   -- mov [rip+0x29], r9
    0x48,0xB8,
  }
  extend(sc, q2b(origAddr))
  extend(sc, {
    0xFF,0xD0,
    0x85,0xC0,
    0x74,0x14,
    0x4C,0x8B,0x0D,0x12,0x00,0x00,0x00,   -- mov r9, [rip+0x12]
    0x4D,0x85,0xC9,
    0x74,0x08,
  })
  extend(sc, {0xBA}); extend(sc, d2b(fakeSerial))
  extend(sc, {0x41,0x89,0x11})
  extend(sc, {0xC3})
  writeBytes(tramp, _unpack(sc))
  return tramp
end

-- Hook GetVolumeInformationW + GetVolumeInformationA in destiny2.exe + BEClient_x64.dll
local function hookVolumeSerial()
  local origW = getAddressSafe("GetVolumeInformationW")
  local origA = getAddressSafe("GetVolumeInformationA")
  _G["SpoofTramp9031"]  = (origW and origW ~= 0) and buildVolTramp(origW) or nil
  _G["SpoofTrampA9031"] = (origA and origA ~= 0) and buildVolTramp(origA) or nil
  _G["SpoofPatched9031"] = {}
  for _, mod in ipairs({"destiny2.exe","BEClient_x64.dll"}) do
    local base = getAddress(mod)
    if base and base ~= 0 then
      if _G["SpoofTramp9031"] and origW and origW ~= 0 then
        local thunk = iatPatch(base, origW, _G["SpoofTramp9031"])
        if thunk then
          _G["SpoofPatched9031"][#_G["SpoofPatched9031"]+1] = {thunk=thunk, orig=origW}
        end
      end
      if _G["SpoofTrampA9031"] and origA and origA ~= 0 then
        local thunk = iatPatch(base, origA, _G["SpoofTrampA9031"])
        if thunk then
          _G["SpoofPatched9031"][#_G["SpoofPatched9031"]+1] = {thunk=thunk, orig=origA}
        end
      end
    end
  end
end

-- MachineGuid: read real GUID via registry, scan for it (UTF-16LE) in memory, overwrite.
-- Falls back to scanning for the key name if io.popen unavailable.
local function patchMachineGUID()
  local wfake = {}
  for i = 1, #fakeGUID do
    wfake[#wfake+1] = fakeGUID:sub(i,i):byte(); wfake[#wfake+1] = 0
  end
  wfake[#wfake+1] = 0; wfake[#wfake+1] = 0

  local realGUID = nil
  local fh = io.popen('reg query "HKLM\\SOFTWARE\\Microsoft\\Cryptography" /v MachineGuid 2>nul')
  if fh then
    local out = fh:read("*a") or ""; fh:close()
    realGUID = out:match("MachineGuid%s+REG_SZ%s+([0-9A-Fa-f%-]+)")
    if realGUID then realGUID = realGUID:match("^%s*(.-)%s*$") end
  end

  if realGUID and #realGUID >= 32 then
    local parts = {}
    for i = 1, #realGUID do
      parts[#parts+1] = string.format("%02X 00", realGUID:sub(i,i):byte())
    end
    local r = AOBScan(table.concat(parts, " "))
    if r then
      for i = 0, math.min(r.Count-1, 63) do
        local addr = tonumber(r[i], 16)
        if addr and addr > 0x10000 then pcall(writeBytes, addr, _unpack(wfake)) end
      end
      r.destroy()
    end
  else
    -- fallback: key name scan
    local r = AOBScan("4D 00 61 00 63 00 68 00 69 00 6E 00 65 00 47 00 75 00 69 00 64 00")
    if r then
      for i = 0, math.min(r.Count-1, 15) do
        local addr = tonumber(r[i], 16)
        if addr and addr > 0x10000 then
          pcall(writeBytes, addr + 24, _unpack(wfake))
        end
      end
      r.destroy()
    end
  end
  _G["SpoofGUID9031"] = fakeGUID
end

pcall(hookVolumeSerial)
pcall(patchMachineGUID)
_G["SpoofFakeSerial9031"] = fakeSerial
