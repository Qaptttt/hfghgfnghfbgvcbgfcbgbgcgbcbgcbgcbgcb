        <CheatEntry>
          <ID>4010</ID>
          <Description>"View Model FoV 3.0"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- pattern dead as of last scan; guard so aobscan failure doesn't leave dangling labels
local r = AOBScan("F3 0F 11 43 08 F3 0F 10 87")
if not r or r.Count == 0 then
  if r then r.destroy() end
  error("FoV3 pattern NOMATCH - needs rescan")
end
local addr = tonumber(r[0], 16); r.destroy()
if not addr or addr == 0 then error("FoV3 addr=0") end
registerSymbol("INJECT_FOV3", addr)
{$asm}
alloc(newmem,$1000,INJECT_FOV3)
label(code)
label(return)
newmem:
code:
  movss [rbx+08],xmm0
  jmp return
INJECT_FOV3:
  jmp newmem
  nop
return:

[DISABLE]
{$lua}
if syntaxcheck then return end
local addr = getAddressSafe("INJECT_FOV3")
if addr and addr ~= 0 then
  pcall(writeBytes, addr, 0xF3,0x0F,0x11,0x43,0x08)
end
unregisterSymbol("INJECT_FOV3")
{$asm}
dealloc(newmem)

