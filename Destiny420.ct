alloc(HnxQBrSslpSZrxA, 8)
registersymbol(HnxQBrSslpSZrxA)
{$lua}
if syntaxcheck then return end
_G["InvPtrRunning"] = true
createNativeThread(function()
  while _G["InvPtrRunning"] do
    pcall(function()
      local d2base = getAddress("destiny2.exe")
      local staticAddr = d2base + 0x240C838
      local mid = readPointer(staticAddr)
      if mid and mid ~= 0 then
        local charBase = mid - 0x2F67B4
        if charBase > 0x100000 and charBase &lt; 0x7FFFFFFFFFFF then
          writeQword(getAddress("HnxQBrSslpSZrxA"), charBase)
        end
      end
    end)
    sleep(500)
  end
end)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
_G["InvPtrRunning"] = false
{$asm}
unregistersymbol(HnxQBrSslpSZrxA)
dealloc(HnxQBrSslpSZrxA, 8)

</AssemblerScript>
