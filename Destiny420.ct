end

local btnList = {}

local function addToggle(cat, name, entryID, depIDs, writeVal)
  local cp = catPanels[cat]
  local CARD_H = 36
  local CARD_W = COL_W - 6
  local TW, TH = 38, 20

  local isLeft = (cp.ly &lt;= cp.ry)
  local x = isLeft and 3 or (COL2_X + 3)
  local y = isLeft and cp.ly or cp.ry

  local card = createPanel(cp.panel)
  card.Left = x; card.Top = y
  card.Width = CARD_W; card.Height = CARD_H
  card.Color = C_CARD; card.BevelOuter = "bvNone"

  local lbl = createLabel(card)
  lbl.Caption = name
  lbl.Left = 10; lbl.Top = 10
  lbl.Font.Size = 8; lbl.Font.Color = C_TEXT
  lbl.Color = C_CARD; lbl.ParentColor = false

  local tgBg = createPanel(card)
  tgBg.Left = CARD_W - TW - 8
  tgBg.Top  = math.floor((CARD_H - TH) / 2)
  tgBg.Width = TW; tgBg.Height = TH
  tgBg.Color = C_OFF_BG; tgBg.BevelOuter = "bvNone"

  local tgDot = createPanel(tgBg)
  tgDot.Top = 2; tgDot.Width = TH - 4; tgDot.Height = TH - 4
  tgDot.Left = 2; tgDot.Color = 0x777777; tgDot.BevelOuter = "bvNone"

  local function refresh()
    local e  = getE(entryID)
    local on = e and e.Active
    tgBg.Color     = on and C_ON_BG  or C_OFF_BG
    tgDot.Left     = on and (TW - TH + 2) or 2
    tgDot.Color    = on and C_KNOB or 0x777777
    lbl.Font.Color = on and C_TEXT or C_DIM
  end
  refresh()

  local function doToggle()
    if depIDs then
      for _, dep in ipairs(depIDs) do
        local e = getE(dep)
        if e and not e.Active then pcall(function() e.Active = true end) end
      end
      local t = createTimer(nil, false); t.Interval = 150
      t.OnTimer = function()
        t.Enabled = false
        local e0 = getE(entryID)
        if e0 then
          local willBeOn = not e0.Active
          pcall(function() e0.Active = willBeOn end)
          if willBeOn and writeVal then pcall(function() e0.Value = writeVal end) end
        end
        refresh(); t.Destroy()
      end
      t.Enabled = true
    else
      local e0 = getE(entryID)
      if not e0 then
        lblStatus.Caption = "NIL #" .. entryID
        lblStatus.Font.Color = C_RED; return
      end
      local willBeOn = not e0.Active
      pcall(function() e0.Active = willBeOn end)
      if willBeOn and writeVal then pcall(function() e0.Value = writeVal end) end
      refresh()
      local isOn = getE(entryID) and getE(entryID).Active
      lblStatus.Caption    = isOn and "● ON" or "● OFF"
      lblStatus.Font.Color = isOn and C_GREEN or C_DIM
      -- self-heal: check 600ms later if activation silently failed (AOB miss / hook crash)
      if willBeOn then
        local _healTmr = createTimer(nil, false); _healTmr.Interval = 600
        local _eid, _nm = entryID, name
        _healTmr.OnTimer = function()
          _healTmr.Enabled = false
          local ec = getE(_eid)
          if ec and not ec.Active then
            lblStatus.Caption = "● DEAD: " .. _nm
            lblStatus.Font.Color = 0xFF8800
          end
          pcall(function() _healTmr.Destroy() end)
        end
        _healTmr.Enabled = true
      end
    end
  end

  card.OnClick  = doToggle
  lbl.OnClick   = doToggle
  tgBg.OnClick  = doToggle
  tgDot.OnClick = doToggle

  btnList[#btnList + 1] = { refresh = refresh }

  if isLeft then cp.ly = cp.ly + CARD_H + 3
  else           cp.ry = cp.ry + CARD_H + 3 end
end

local function addWepToggle(cat, name, entryID, depIDs)
  addToggle(cat, name, entryID, depIDs, "9999.0")
end

local function newRow(cat)
  local cp = catPanels[cat]
  local m  = math.max(cp.ly, cp.ry) + 6
  cp.ly = m; cp.ry = m
end

local function addSlider(cat, sym, minV, maxV, defV, ltext, step)
  newRow(cat)
  local cp = catPanels[cat]; step = step or 1.0
  local sy = cp.ly; local sw = CONT_W - 12
  cp.ly = cp.ly + 32; cp.ry = cp.ly
  pcall(function()
    local bg = createPanel(cp.panel)
    bg.Left = 6; bg.Top = sy; bg.Width = sw; bg.Height = 28
    bg.Color = C_CARD; bg.BevelOuter = "bvNone"
    local ll = createLabel(bg)
    ll.Caption = ltext; ll.Left = 10; ll.Top = 7; ll.Width = 130
    ll.Font.Size = 8; ll.Font.Color = C_DIM; ll.Color = C_CARD; ll.ParentColor = false
    local vl = createLabel(bg)
    vl.Left = sw - 58; vl.Top = 7; vl.Width = 52
    vl.Font.Size = 8; vl.Font.Bold = true; vl.Font.Color = C_TEXT
    vl.Color = C_CARD; vl.ParentColor = false
    local steps = math.max(1, math.floor((maxV - minV) / step + 0.5))
    local tb = createTrackBar(bg)
    tb.Left = 148; tb.Top = 6; tb.Width = sw - 214; tb.Height = 18
    tb.Min = 0; tb.Max = steps
    tb.Position = math.min(steps, math.max(0, math.floor((defV - minV) / step + 0.5)))
    local function upd()
      local v = minV + tb.Position * step
      vl.Caption = string.format(step &lt; 1 and "%.2f" or "%.0f", v)
      local a = getAddressSafe(sym)
      if a and a ~= 0 then pcall(writeFloat, a, v) end
    end
    upd(); tb.OnChange = upd
  end)
end

