      <AssemblerScript>{$lua}
function LocalPlayerFunction()
  local playerSym = getAddress("LocalPlayer")
  if not playerSym or playerSym == 0 then return end
  local localPlayer = readPointer(playerSym)
  if not localPlayer or localPlayer == 0 then return end
  local ok, x = pcall(readFloat, localPlayer + 0x1C0)
  if not ok or not x or x ~= x then return end
  if math.abs(x) > 50000 then return end
  writeQword(getAddress("Player"), localPlayer)
end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 250
  tmr.OnTimer = LocalPlayerFunction
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()
{$asm}
alloc(Player, 8)
registersymbol(Player)
{$lua}
[DISABLE]
disableFunction()
{$asm}
dealloc(Player, 8)
unregistersymbol(Player)

