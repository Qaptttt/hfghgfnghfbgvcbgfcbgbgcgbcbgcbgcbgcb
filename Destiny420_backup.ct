        </CheatEntry>
        <CheatEntry>
          <ID>2980</ID>
          <Description>"Spinbot New"</Description>
          <Color>FF0080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}

KEEP_GOING = true
rotationSpeed = 0.5

angleX = 0
angleY = 0.5

function Fly()
  while KEEP_GOING do
    local ViewBase = getAddressSafe("ViewAngles")
    if ViewBase and ViewBase ~= 0 then
      local ViewAngleBase = readPointer(ViewBase) + 0x1C

      local viewX = readFloat(ViewAngleBase - 0x4)
      local viewY = readFloat(ViewAngleBase)

      if isKeyPressed(VK_F) then
        writeFloat(ViewAngleBase, .5)

        angleX = angleX + rotationSpeed
        if angleX &gt; 6.25 then
          angleX = 0
        end

        angleY = angleY + rotationSpeed
        if angleY &gt; 1.5 then
          angleY = -1.5
        end

        local newViewX = math.sin(angleX) * 6.25
        writeFloat(ViewAngleBase - 0x4, newViewX)
        local newViewY = math.sin(angleY) * 1.5
        writeFloat(ViewAngleBase, newViewY)
      end
    end
    sleep(10)
  end
end

createNativeThread(Fly)

