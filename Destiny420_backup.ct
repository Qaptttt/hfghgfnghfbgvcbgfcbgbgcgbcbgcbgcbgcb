  <CheatEntries>
    <CheatEntry>
      <ID>9000</ID>
      <Description>"[SCANNER] Enable - writes scan_results.txt then auto-disables"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[ENABLE]
if syntaxcheck then return end

local OUT = "C:\\Users\\Bob\\Downloads\\d2\\scan_results.txt"
local lines = {}
local function w(s) lines[#lines+1] = s end

-- D2 unlinks itself from PEB so getAddress/enumModules return nothing.
-- Find base by: AOBScan a known pattern -> walk back to MZ+PE header.
local function getD2Base()
  local a = getAddress("destiny2.exe")
  if a and a ~= 0 then return a end

  local seeds = {
    "48 89 86 48 08 00 00 72",
    "F3 0F 11 43 08 48 83 C4 30 5B C3 83",
    "48 03 FA 0F B7 4F 0A",
    "0F 11 47 70 41 8B 41 0C",
  }
  local hit = nil
  for _, pat in ipairs(seeds) do
    local r = AOBScan(pat)
    if r and r.Count > 0 then
      local c = tonumber(r[0], 16)
      r.destroy()
      if c and c &gt; 0x10000000 then hit = c break end
    elseif r then r.destroy() end
  end
  if not hit then return 0 end

  local base = hit - (hit % 0x10000)
  for i = 1, 2000 do
    base = base - 0x10000
    local ok, b = pcall(readBytes, base, 4, true)
    if ok and b and b[1] == 0x4D and b[2] == 0x5A then
      local ok2, peoff = pcall(readInteger, base + 0x3C)
      if ok2 and peoff and peoff &gt; 0 and peoff &lt; 0x400 then
        local ok3, s = pcall(readBytes, base + peoff, 2, true)
        if ok3 and s and s[1] == 0x50 and s[2] == 0x45 then return base end
      end
    end
  end
  return 0
end
local d2base = getD2Base()
if d2base == 0 then
  showMessage("ERROR: d2base = 0\nAttach CE to destiny2.exe first, then re-enable.")
  return
end

w("=== D2 SCAN " .. os.date("%Y-%m-%d %H:%M:%S") .. " ===")
w("d2base = " .. string.format("0x%X", d2base))
w("")

-- Helper: scan, filter to d2 module range, return address list
local function scan(pat, maxhits)
  maxhits = maxhits or 8
  local r = AOBScan(pat)
  local hits = {}
  if r then
    for i = 0, r.Count - 1 do
      local a = tonumber(r[i], 16)
      if a &gt;= d2base and a &lt; d2base + 0x8000000 then
        hits[#hits+1] = a
        if #hits &gt;= maxhits then break end
      end
    end
    r.destroy()
  end
  return hits
end

-- Helper: hex context around address
local function ctx(addr, before, after)
  local data = readBytes(addr - before, before + after, true)
  if not data then return "??" end
  local s = ""
  for i, b in ipairs(data) do
    if i == before + 1 then s = s .. "***" end
    s = s .. string.format("%02X ", b)
    if i == before + after - before then s = s .. "   " end
  end
  return s
end

-- ========== EXACT PATTERNS ==========
w("--- EXACT PATTERNS ---")
local exact = {
  {"LocalPlayer",    "0F 10 89 C0 01 00 00 0F 54"},
  {"NoRecoil",       "0F 11 8B 20 10 00 00"},
  {"AbilityRegen",   "0F 28 C1 F3 41 0F 5C C3 0F 2F C6 73"},
  {"AbilityRate",    "F3 44 0F 11 5C 24 20 44 8B"},
  {"ImmuneBoss",     "0F 10 02 48 83 C1 60"},
  {"InfTokens",      "89 08 48 83 C4 38 C3 90"},
  {"KillAura",       "F3 0F 10 41 20 32 C0"},
  {"NoClip1",        "89 47 7C 0F B6 87 CB 00 00 00 44 0F 10 32"},
  {"NoClip2",        "89 43 7C 0F B6 83 CB 00 00 00 44 0F 10 12"},
  {"RapidFire",      "F3 0F 11 86 9C 17 00 00"},
  {"IcarusDash",     "89 46 34 89 6E 3C"},
  {"InstantRespawn", "48 89 86 48 08 00 00 72"},
  {"OPK",            "0F 11 47 70 41 8B 41 0C"},
  {"GenOrbs",        "89 51 48 48 8B D9"},
  {"Godmode1",       "F3 0F 11 4C 24 38 B9"},
  {"Godmode2",       "C3 89 07 48 8B 5C 24 30"},
  {"Godmode3",       "33 DA C1 C3 10 E8"},
  {"Stacks",         "89 5F 30 74 08"},
  {"Stacks2",        "F3 0F 10 C8 0F 11 0A C3 48 8D 64 24 F8 E9"},
  {"OneHitKill",     "F3 0F 11 44 24 50 33 C0 8B"},
  {"DamageScale",    "0F 10 80 00 01 00 00 0F 29"},
  {"Interact",       "8B 54 01 6C 8B 4F 24"},
  {"InteractSpeed",  "F3 0F 11 43 08 48 83 C4 30 5B C3 83"},
  {"InteractAura2",  "F3 42 0F 10 74 1A 6C"},
  {"Activity",       "48 03 FA 0F B7 4F 0A"},
  {"FoV1",           "0F 11 53 10 0F 10 4E 20 40"},
  {"FoV2",           "F3 0F 10 4B 10 F3 0F 10 43"},
  {"FoV3",           "F3 0F 11 43 08 F3 0F 10 87"},
  {"ShieldSize",     "F3 0F 10 B3 B8 00 00 00 F3"},
  {"Damage2",        "F3 44 0F 10 61 24"},
  {"Orb2",           "89 47 04 8B 10"},
  {"TurboCrash",     "C7 43 04 FF FF FF FF C6 03 01"},
}
for _, e in ipairs(exact) do
  local hits = scan(e[2])
  if #hits == 0 then
    w("MISS  " .. e[1] .. "  |  " .. e[2])
  elseif #hits == 1 then
    local off = hits[1] - d2base
    w("OK    " .. e[1] .. "  @d2+" .. string.format("%X", off) .. "  |  " .. ctx(hits[1], 6, 16))
  else
    w("DUP(" .. #hits .. ") " .. e[1])
    for _, h in ipairs(hits) do
      w("      d2+" .. string.format("%X", h-d2base) .. "  |  " .. ctx(h, 6, 12))
    end
  end
end

-- ========== BROAD LocalPlayer SCAN ==========
w("")
w("--- BROAD LocalPlayer (movups/movss [rcx+X] near 0x1C0) ---")
-- ModRM bytes where base=rcx (RM=001): 81,89,91,99,A1,A9,B1,B9 for xmm0-7
-- Displacements around 0x1C0 (range 0x140-0x240)
local found_lp = {}
for lo = 0x40, 0xFF, 8 do
  for hi = 1, 2 do
    local modrms = {0x81,0x89,0x91,0x99,0xA1,0xA9,0xB1,0xB9}
    for _, mr in ipairs(modrms) do
      local pat = string.format("0F 10 %02X %02X %02X 00 00", mr, lo, hi)
      local hits = scan(pat, 4)
      if #hits &gt; 0 and #hits &lt;= 3 then
        for _, h in ipairs(hits) do
          found_lp[#found_lp+1] = {h, mr, lo+(hi*256), pat, ctx(h,4,14)}
        end
      end
    end
  end
end
if #found_lp == 0 then
  w("  no movups [rcx+0x140..0x2FF] found")
else
  for _, f in ipairs(found_lp) do
    w(string.format("  d2+%X  mr=%02X off=0x%X  | %s", f[1]-d2base, f[2], f[3], f[5]))
  end
end

-- ========== destinyBase SCAN ==========
w("")
w("--- destinyBase offsets ---")
local db1 = getAddressSafe('destiny2.exe+2F41E70')
local db2 = getAddressSafe('destiny2.exe+2F40E60')
w("  0x2F41E70 (shellLP/WASD) = " .. (db1 and string.format("0x%X",db1) or "NIL"))
w("  0x2F40E60 (DirectFly)   = " .. (db2 and string.format("0x%X",db2) or "NIL"))

-- Scan for RIP-relative MOV/LEA that point into D2's data range
-- Old offsets: 2F41E70 (shellLP/WASD), 2F40E60 (DirectFly) - both NIL after update
-- Search .text for instructions that load a pointer FROM d2 data section
-- Patterns: MOV rXX,[rip+x] = 48 8B 0D/05/15/1D/25/2D/35/3D ??x4
--           LEA rXX,[rip+x] = 48 8D 0D/05/15/1D/25/2D/35/3D ??x4
w("  Scanning for RIP-relative refs into d2 data section (may take a moment)...")
local function resolveRIP(instrAddr, instrSize, dispBytes)
  local disp = dispBytes[1] + dispBytes[2]*256 + dispBytes[3]*65536 + dispBytes[4]*16777216
  if disp &gt;= 0x80000000 then disp = disp - 0x100000000 end
  return instrAddr + instrSize + disp
end
-- ModRM reg bytes for REX.W MOV/LEA rXX,[rip+disp32]
local modrm_bytes = {"05","0D","15","1D","25","2D","35","3D"}
local db_candidates = {}
local function scanRIPrel(prefix, instrLen)
  for _, mr in ipairs(modrm_bytes) do
    local pat = string.format("48 %s %s ?? ?? ?? ??", prefix, mr)
    local hits = scan(pat, 200)
    for _, h in ipairs(hits) do
      local b = readBytes(h+3, 4, true)
      if b and #b == 4 then
        local tgt = resolveRIP(h, instrLen, b)
        local off = tgt - d2base
        -- Data section heuristic: past the code area, within a 512MB window
        if off &gt;= 0x1000000 and off &lt;= 0x6000000 then
          db_candidates[#db_candidates+1] = {h-d2base, off, prefix, mr}
        end
      end
    end
  end
end
scanRIPrel("8B", 7)  -- MOV rXX,[rip+x]
scanRIPrel("8D", 7)  -- LEA rXX,[rip+x]
-- Sort by target offset so related entries cluster
table.sort(db_candidates, function(a,b) return a[2] &lt; b[2] end)
if #db_candidates == 0 then
  w("  no RIP-relative data refs found in range d2+1000000..6000000")
else
  w(string.format("  found %d candidates (showing first 40):", #db_candidates))
  for i = 1, math.min(40, #db_candidates) do
    local c = db_candidates[i]
    w(string.format("  instr@d2+%X -> data@d2+%X  [%s %s]", c[1], c[2], c[3], c[4]))
  end
end

w("")
w("=== END ===")

-- Write to file
local f = io.open(OUT, "w")
if f then
  f:write(table.concat(lines, "\n"))
  f:close()
  showMessage("Scan done! Results written to:\n" .. OUT .. "\n\nTotal lines: " .. #lines)
else
  showMessage("WRITE FAILED\n\n" .. table.concat(lines, "\n"):sub(1,1000))
end
[DISABLE]
</AssemblerScript>
