    </CheatEntry>
    <CheatEntry>
      <ID>2671</ID>
      <Description>"Speedhack"</Description>
      <ShowAsSigned>0</ShowAsSigned>
      <Color>FF0080</Color>
      <VariableType>Float</VariableType>
      <Address>destiny2.exe+1E7BD38</Address>
      <Hotkeys>
        <Hotkey OnlyWhileDown="1">
          <Action>Set Value</Action>
          <Keys>
            <Key>88</Key>
          </Keys>
          <Value>15000</Value>
          <ID>0</ID>
        </Hotkey>
