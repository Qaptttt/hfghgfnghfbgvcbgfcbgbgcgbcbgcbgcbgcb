      <AssemblerScript>[ENABLE]
aobscan(INJECT,F3 0F 11 47 1C 7A) // should be unique
alloc(newmem,$1000,INJECT)
registersymbol(ViewAngles)
alloc(ViewAngles, 8)
label(code)
label(return)

newmem:

code:
  push r14
  movss [rdi+1C],xmm0
  mov r14, ViewAngles
  mov [r14], rdi
  pop r14
  jmp return

