            writeFloat(playerBase + 0x1C4, -2211.560303)
            writeFloat(playerBase + 0x1C8, -280.4492493)
            end

            --second ball
        if isKeyPressed(VK_MULTIPLY) then
            writeFloat(playerBase + 0x1C0, -655.3621216)
            writeFloat(playerBase + 0x1C4, -2231.573975)
            writeFloat(playerBase + 0x1C8, -276.3625183)
            end

            -- third ball
        if isKeyPressed(VK_SUBTRACT) then
            writeFloat(playerBase + 0x1C0, -670.8379517)
            writeFloat(playerBase + 0x1C4, -2235.946045)
            writeFloat(playerBase + 0x1C8, -278.149231)
            end

            -- fourth ball
        if isKeyPressed(VK_NUMPAD7) then
            writeFloat(playerBase + 0x1C0, -1498.116089)
            writeFloat(playerBase + 0x1C4, -2899.857666)
            writeFloat(playerBase + 0x1C8, 21.03718948)
            end

           -- fifth ball
        if isKeyPressed(VK_NUMPAD8) then
            writeFloat(playerBase + 0x1C0, -1509.22168)
            writeFloat(playerBase + 0x1C4, -2899.760498)
            writeFloat(playerBase + 0x1C8, 21.03704453)
            end

            -- sixth ball
        if isKeyPressed(VK_NUMPAD9) then
            writeFloat(playerBase + 0x1C0, -1489.346436)
            writeFloat(playerBase + 0x1C4, -2885.822021)
            writeFloat(playerBase + 0x1C8, 18.98749924)
            end

            -- load
        if isKeyPressed(VK_NUMPAD4) then
            writeFloat(playerBase + 0x1C0, -1518.268555)
            writeFloat(playerBase + 0x1C4, -2886.17041)
            writeFloat(playerBase + 0x1C8, 19.91752434)
            end

            -- next load
        if isKeyPressed(VK_NUMPAD5) then
            writeFloat(playerBase + 0x1C0, -1497.269287)
            writeFloat(playerBase + 0x1C4, -2876.572021)
            writeFloat(playerBase + 0x1C8, 19.00346565)
            end
            --lift
        if isKeyPressed(VK_NUMPAD6) then
            writeFloat(playerBase + 0x1C0, -1510.446533)
            writeFloat(playerBase + 0x1C4, -2877.732666)
            writeFloat(playerBase + 0x1C8, 19.02994728)
            end
            --cp eager forward for load
        if isKeyPressed(VK_NUMPAD1) then
            writeFloat(playerBase + 0x1C0, -1492.10498)
            writeFloat(playerBase + 0x1C4, -2966.655762)
            writeFloat(playerBase + 0x1C8, 29.23707962)
            end
            --aura
        if isKeyPressed(VK_NUMPAD2) then
            writeFloat(playerBase + 0x1C0, -705.6876221)
            writeFloat(playerBase + 0x1C4, -2211.117676)
            writeFloat(playerBase + 0x1C8, -280.4898682)
            end

            --totems dunk plate
        if isKeyPressed(VK_NUMPAD3) then
            writeFloat(playerBase + 0x1C0, -792.7748413)
            writeFloat(playerBase + 0x1C4, -2121.584961)
            writeFloat(playerBase + 0x1C8, -212.3901062)
            end

        end
    end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 1
  tmr.OnTimer = checkKeys
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()

[DISABLE]
disableFunction()







