    <CheatEntry>
      <ID>470</ID>
      <Description>"shellLocalPlayer"</Description>
      <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
      <Color>808080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
local destinyBase = getAddressSafe('destiny2.exe+2F41E70')
local localPlayerOffset = 0x1C0
local teamIdOffset = 0xAAC

function LocalPlayerFunction()
  if not destinyBase then
    destinyBase = getAddressSafe('destiny2.exe+2F41E70')
    if not destinyBase then return end
  end
  local playerSym = getAddress("LocalPlayer")
  if not playerSym or playerSym == 0 then return end
  local localPlayer = readPointer(playerSym)
  if not localPlayer or localPlayer == 0 then return end
  local MovingEntityX = readFloat(destinyBase)
  local LocalPlayerX = readFloat(localPlayer + localPlayerOffset)
  local MovingEntityY = readFloat(destinyBase + 4)
  local LocalPlayerY = readFloat(localPlayer + localPlayerOffset + 4)
  local MovingEntityZ = readFloat(destinyBase + 8)
  local LocalPlayerZ = readFloat(localPlayer + localPlayerOffset + 8)

  if (
    (MovingEntityX - 1 &lt;= LocalPlayerX and LocalPlayerX &lt;= MovingEntityX + 1) and
    (MovingEntityY - 1 &lt;= LocalPlayerY and LocalPlayerY &lt;= MovingEntityY + 1) and
    (MovingEntityZ - 3 &lt;= LocalPlayerZ and LocalPlayerZ &lt;= MovingEntityZ + 3)
  ) then
    writeQword(getAddress("Player"), localPlayer)
  end
end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 250
  tmr.OnTimer = LocalPlayerFunction
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()
{$asm}
alloc(Player, 8)
registersymbol(Player)
{$lua}
[DISABLE]
disableFunction()
{$asm}
dealloc(Player, 8)
unregistersymbol(Player)

</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>471</ID>
          <Description>"-"</Description>
          <Color>808080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{Alura New Local Player}
[ENABLE]
aobscan(INJECT,0F 10 89 C0 01 00 00 0F 54) // should be unique
alloc(newmem,$1000,INJECT)
registersymbol(LocalPlayer)
alloc(LocalPlayer, 8)
label(code)
label(return)

newmem:

code:
  push r14
  mov r14, LocalPlayer
  mov [r14], rcx
  pop r14
  movups xmm1,[rcx+000001C0]
  jmp return

INJECT:
  jmp newmem
  nop 2
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 0F 10 89 C0 01 00 00
unregistersymbol(INJECT)
dealloc(newmem)
unregistersymbol(LocalPlayer)
dealloc(LocalPlayer, 8)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>2337</ID>
              <Description>"Directional Fly"</Description>
              <Color>FF0080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}

local destinyBase = getAddressSafe('destiny2.exe+2F40E60')
local AirstuckToggled = false
local previousStateG = false
local isGKeyPressed = false
KEEP_GOING = true

function handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
  writeFloat(playerPositionBase, positionX)
  writeFloat(playerPositionBase + 0x4, positionY)
  writeFloat(playerPositionBase + 0x8, positionZ)
  writeFloat(playerPositionBase + 0x70, 0)
  writeFloat(playerPositionBase + 0x74, 0)
  writeFloat(playerPositionBase + 0x78, 0)
end

function Fly()
  while KEEP_GOING do
    if not destinyBase then
      destinyBase = getAddressSafe('destiny2.exe+2F40E60')
    end
    if destinyBase then
      local playerBase = getAddressSafe("Player")
      if playerBase and playerBase ~= 0 then
        local ptrVal = readPointer(playerBase)
        if ptrVal and ptrVal ~= 0 then
          local playerPositionBase = ptrVal + 0x1C0
          local positionX = readFloat(playerPositionBase)
          local positionY = readFloat(playerPositionBase + 0x4)
          local positionZ = readFloat(playerPositionBase + 0x8)
          local rotationX = readFloat(destinyBase + 0x10)
          local rotationY = readFloat(destinyBase + 0x14)
          local rotationZ = readFloat(destinyBase + 0x18)
          FlypositionX = positionX + rotationX * 0.01
          FlypositionY = positionY + rotationY * 0.01
          FlypositionZ = positionZ + rotationZ * 0.01
          if isKeyPressed(VK_G) then
            writeFloat(playerPositionBase, FlypositionX)
            writeFloat(playerPositionBase + 0x4, FlypositionY)
            writeFloat(playerPositionBase + 0x8, FlypositionZ)
            writeFloat(playerPositionBase + 0x70, 0)
            writeFloat(playerPositionBase + 0x74, 0)
            writeFloat(playerPositionBase + 0x78, 0)
          end
          if isKeyPressed(VK_H) and not previousStateG then
            isGKeyPressed = not isGKeyPressed
            previousStateG = true
          elseif not isKeyPressed(VK_H) then
            previousStateG = false
          end
          if isGKeyPressed then
            handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
          end
        end
      end
    end
    sleep(10)
  end
end

createNativeThread(Fly)

