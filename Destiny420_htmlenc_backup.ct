end

w(&quot;&quot;)
w(&quot;--- SECTION 4b: LIVE ENTITY SCAN (enemies near player) ---&quot;)
do
  local playerSym = getAddressSafe(&quot;Player&quot;)
  if playerSym and playerSym ~= 0 then
    local lp = readPointer(playerSym)
    if lp and lp ~= 0 then
      local px = readFloat(lp + 0x1C0)
      local py = readFloat(lp + 0x1C4)
      local pz = readFloat(lp + 0x1C8)
      if px == px then
        w(string.format(&quot;  PlayerPos=%.2f,%.2f,%.2f  ptr=0x%X&quot;, px,py,pz,lp))
        local RANGE = 300
        local stride = 0x800
        local found = 0
        local rBase, rSize = lp - 0x200000, 0x400000
        local ok2, regions = pcall(getMemoryRegions)
        if ok2 and regions then
          for i = 0, regions.Count - 1 do
            local r = regions[i]
            if r.BaseAddress &lt;= lp and lp &lt; r.BaseAddress + r.RegionSize then
              rBase = r.BaseAddress; rSize = r.RegionSize; break
            end
          end
          regions.destroy()
        end
        for off = 0, rSize - 0x200, stride do
          local a = rBase + off
          if a ~= lp and a &gt; 0x10000000 then
            local ok1, x = pcall(readFloat, a + 0x1C0)
            if ok1 and x == x and math.abs(x - px) &lt; RANGE then
              local ok3, y = pcall(readFloat, a + 0x1C4)
              if ok3 and y == y and math.abs(y - py) &lt; RANGE then
                local ok4, z = pcall(readFloat, a + 0x1C8)
                if ok4 and z == z and math.abs(z - pz) &lt; RANGE then
                  found = found + 1
                  w(string.format(&quot;  ENT@0x%X  d2+%X  xyz=%.1f,%.1f,%.1f&quot;, a, a-d2base, x,y,z))
                  if found &gt;= 20 then w(&quot;  (capped at 20)&quot;) break end
                end
              end
            end
          end
        end
        if found == 0 then w(&quot;  No entities near player (be in-game with enemies visible)&quot;) end
      else w(&quot;  LocalPlayer not populated -- enable LocalPlayer hook first&quot;) end
    else w(&quot;  Player ptr=0 -- enable LocalPlayer hook first&quot;) end
  else w(&quot;  Player symbol missing&quot;) end
end

