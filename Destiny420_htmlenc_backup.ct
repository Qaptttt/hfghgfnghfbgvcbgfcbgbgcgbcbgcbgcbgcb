[ENABLE]
if syntaxcheck then return end

local OUT = &quot;C:\\Users\\Bob\\Downloads\\d2\\scan_results.txt&quot;
local lines = {}
local outFile = io.open(OUT, &quot;w&quot;)
local function w(s)
  lines[#lines+1] = s
  if outFile then outFile:write(s .. &quot;\n&quot;); outFile:flush() end
end

local function getD2Base()
  local a = getAddress(&quot;destiny2.exe&quot;)
  if a and a ~= 0 then return a end
  local seeds = {
    &quot;48 89 86 48 08 00 00 72&quot;,&quot;0F 11 47 70 41 8B 41 0C&quot;,
    &quot;48 03 FA 0F B7 4F 0A&quot;,&quot;89 47 7C 0F B6 87 CB 00 00 00 44 0F 10 32&quot;,
  }
  local hit = nil
  for _, pat in ipairs(seeds) do
    local r = AOBScan(pat)
    if r and r.Count &gt; 0 then
      local c = tonumber(r[0], 16)
      r.destroy()
      if c and c &gt; 0x10000000 then hit = c break end
    elseif r then r.destroy() end
  end
  if not hit then return 0 end
  local base = hit - (hit % 0x10000)
  for i = 1, 2000 do
    base = base - 0x10000
    local ok, b = pcall(readBytes, base, 4, true)
    if ok and b and b[1] == 0x4D and b[2] == 0x5A then
      local ok2, pe = pcall(readInteger, base + 0x3C)
      if ok2 and pe and pe &gt; 0 and pe &lt; 0x400 then
        local ok3, s = pcall(readBytes, base + pe, 2, true)
        if ok3 and s and s[1] == 0x50 and s[2] == 0x45 then return base end
      end
    end
  end
  return 0
end

local d2base = getD2Base()
if d2base == 0 then
  local dlg = createForm(true)
  dlg.Caption = &quot;D2 Scanner&quot;; dlg.Width = 360; dlg.Height = 110
  dlg.Position = poScreenCenter; dlg.FormStyle = fsStayOnTop; dlg.BorderStyle = bsDialog
  local lbl = createLabel(dlg); lbl.Left = 12; lbl.Top = 12; lbl.Width = 336; lbl.Height = 50
  lbl.Caption = &quot;ERROR: d2base=0 — attach CE to destiny2.exe first&quot;
  lbl.WordWrap = true
  local btn = createButton(dlg); btn.Caption = &quot;OK&quot;; btn.Left = 140; btn.Top = 60
  btn.Width = 80; btn.Height = 26; btn.OnClick = function() dlg.Close() end
  dlg.ShowModal(); dlg.Destroy()
  return
end
w(&quot;=== D2 SCAN &quot; .. os.date(&quot;%Y-%m-%d %H:%M:%S&quot;) .. &quot; ===&quot;)
w(&quot;d2base = &quot; .. string.format(&quot;0x%X&quot;, d2base))
w(&quot;&quot;)

local function scan(pat, maxhits)
  maxhits = maxhits or 6
  local r = AOBScan(pat)
  local hits = {}
  if r then
    for i = 0, r.Count - 1 do
      local a = tonumber(r[i], 16)
      if a &gt;= d2base and a &lt; d2base + 0x8000000 then
        hits[#hits+1] = a
        if #hits &gt;= maxhits then break end
      end
    end
    r.destroy()
  end
  return hits
end

local function ctx(addr, bef, aft)
  local data = readBytes(addr - bef, bef + aft, true)
  if not data then return &quot;??&quot; end
  local s = &quot;&quot;
  for i, b in ipairs(data) do
    if i == bef + 1 then s = s .. &quot;| &quot; end
    s = s .. string.format(&quot;%02X &quot;, b)
  end
  return s
end

