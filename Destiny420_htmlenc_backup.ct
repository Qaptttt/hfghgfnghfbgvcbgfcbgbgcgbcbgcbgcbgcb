          &lt;AssemblerScript&gt;// ALURA IS YOUR DADDY YOU FAT TUBS OF WHALE SHIT

{$lua}
function checkKeys()
    local playerBase = readPointer(getAddress(&quot;Player&quot;))
    if playerBase ~= nil then
           --true death
        if isKeyPressed(VK_XBUTTON1) then
            writeFloat(playerBase + 0x1C0, -111111)
            writeFloat(playerBase + 0x1C4, -111111)
            writeFloat(playerBase + 0x1C8, -111111)
            end
            --BEGINNING
        if isKeyPressed(VK_DIVIDE) then
            writeFloat(playerBase + 0x1C0, -559.6876831)
            writeFloat(playerBase + 0x1C4, 41.03936768)
            writeFloat(playerBase + 0x1C8, 113.8770905)
            end
            --first cp
        if isKeyPressed(VK_MULTIPLY) then
            writeFloat(playerBase + 0x1C0, -696.5344849)
            writeFloat(playerBase + 0x1C4, 202.7316742)
            writeFloat(playerBase + 0x1C8, 99.66590881)
            end

        if isKeyPressed(VK_NUMPAD7) then
            writeFloat(playerBase + 0x1C0, -703.6735229)
            writeFloat(playerBase + 0x1C4, 283.100708)
            writeFloat(playerBase + 0x1C8, 108.0345306)
            end
                        -- Plate 3
        if isKeyPressed(VK_NUMPAD8) then
            writeFloat(playerBase + 0x1C0, -1408.653198)
            writeFloat(playerBase + 0x1C4, 998.1480713)
            writeFloat(playerBase + 0x1C8, 14.31448078)
            end

                        --Load zone for 2nd
        if isKeyPressed(VK_NUMPAD9) then
            writeFloat(playerBase + 0x1C0, -1768.647461)
            writeFloat(playerBase + 0x1C4, 1356.4021)
            writeFloat(playerBase + 0x1C8, -58.93051147)
            end

                  if isKeyPressed(VK_SUBTRACT) then
            writeFloat(playerBase + 0x1C0, -1712.9646)
            writeFloat(playerBase + 0x1C4, 1356.189209)
            writeFloat(playerBase + 0x1C8, -245.3955994)
            end

                    if isKeyPressed(VK_NUMPAD4) then
            writeFloat(playerBase + 0x1C0, -1775.155884)
            writeFloat(playerBase + 0x1C4, 1478.13269)
            writeFloat(playerBase + 0x1C8, -89.15328217)
            end

            --dungeon room 2
        if isKeyPressed(VK_NUMPAD5) then
            writeFloat(playerBase + 0x1C0, -1774.637939)
            writeFloat(playerBase + 0x1C4, 1626.49707)
            writeFloat(playerBase + 0x1C8, -131.6396637)
            end
            --after dungeon cp
        if isKeyPressed(VK_NUMPAD6) then
            writeFloat(playerBase + 0x1C0, -1773.680786)
            writeFloat(playerBase + 0x1C4, 133.8741913)
            writeFloat(playerBase + 0x1C8, 95.60408783)
            end
            --after dungeon 2nd cp
        if isKeyPressed(VK_ADD) then
            writeFloat(playerBase + 0x1C0, -2070.296875)
            writeFloat(playerBase + 0x1C4, 648.9403687)
            writeFloat(playerBase + 0x1C8, -134.1384277)
            end
            --FLAME1
            --Flame2
        if isKeyPressed(VK_NUMPAD1) then
            writeFloat(playerBase + 0x1C0, -1831.556396)
            writeFloat(playerBase + 0x1C4, 668.9043579)
            writeFloat(playerBase + 0x1C8, -118.6330109)
            end

            --Flame

            --After ogre cp
        if isKeyPressed(VK_NUMPAD2) then
            writeFloat(playerBase + 0x1C0, -1764.593872)
            writeFloat(playerBase + 0x1C4, 1274.171143)
            writeFloat(playerBase + 0x1C8, -37.87751007)
            end
            --final boss
        if isKeyPressed(VK_NUMPAD3) then
            writeFloat(playerBase + 0x1C0, -1777.072144)
            writeFloat(playerBase + 0x1C4, 1397.462524)
            writeFloat(playerBase + 0x1C8, -40.13999557)
            end

                    if isKeyPressed(VK_NUMPAD0) then
            writeFloat(playerBase + 0x1C0, -1775.067627)
            writeFloat(playerBase + 0x1C4, 1679.749756)
            writeFloat(playerBase + 0x1C8, -134.6398773)
            end

        end
    end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 1
  tmr.OnTimer = checkKeys
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()

[DISABLE]
disableFunction()







