&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;
&lt;CheatTable TestxCapcutTableVersion=&quot;45&quot;&gt;
  &lt;LuaScript&gt;
local TARGET      = &quot;destiny2.exe&quot;
local TRAINER_VER = &quot;2.0&quot;

local C_BG       = 0x0D0D0D
local C_SIDE     = 0x111111
local C_GRP_HDR  = 0x0A0A0A
local C_CARD     = 0x191919
local C_ACCENT   = 0x4040C8
local C_TEXT     = 0xEEEEEE
local C_DIM      = 0x666666
local C_ACT_BG   = 0x1A1010
local C_SEP      = 0x252525
local C_ON_BG    = 0x4040C8
local C_OFF_BG   = 0x333333
local C_KNOB     = 0xDDDDDD
local C_GREEN    = 0x44CC66
local C_RED      = 0xFF4444

local mf = getMainForm()
mf.Left = -30000; mf.Top = -30000
pcall(function() mf.Visible = false end)
pcall(function() mf.StatusBar.Visible = false end)

-- Suppress DBK64 LOADED notification window by class name (TfrmDriverLoaded).
pcall(function()
  local _t = createTimer(nil, false); _t.Interval = 120; local _n = 0
  _t.OnTimer = function()
    _n = _n + 1
    if _n &gt; 25 then _t.Enabled = false; pcall(function() _t.destroy() end); return end
    pcall(function()
      local hw = findWindow('TfrmDriverLoaded', nil)
      if hw then sendMessage(hw, 0x10, 0, 0) end
    end)
  end
  _t.Enabled = true
end)

local function isAttached()
  local pid = getOpenedProcessID()
  return pid ~= nil and pid ~= 0
end
local function tryAttach()
  if isAttached() then return true end
  local pid = getProcessIDFromProcessName(TARGET)
  if pid and pid ~= 0 then openProcess(pid) else openProcess(TARGET) end
  return isAttached()
end

local al = getAddressList()
local ecache = {}
local function getE(id)
  if not ecache[id] then ecache[id] = al.getMemoryRecordByID(id) end
  return ecache[id]
end

local W, H = 860, 650
local HDR_H = 46
local SIDE_W = 198

local F = createForm(true)
F.Caption = &quot;BOBS D2 MENU&quot;
F.Color = C_BG
F.Width = W
F.Height = H
F.Position = &quot;poScreenCenter&quot;
F.BorderStyle = &quot;bsSingle&quot;
F.OnClose = function() mf.Close() end

-- Header
local hdr = createPanel(F)
hdr.Left = 0; hdr.Top = 0; hdr.Width = W; hdr.Height = HDR_H
hdr.Color = C_GRP_HDR; hdr.BevelOuter = &quot;bvNone&quot;

local lTitle = createLabel(hdr)
lTitle.Caption = &quot;BOBS D2 MENU&quot;
lTitle.Left = 16; lTitle.Top = 7
lTitle.Font.Size = 14; lTitle.Font.Bold = true
lTitle.Font.Color = C_TEXT
lTitle.Color = C_GRP_HDR; lTitle.ParentColor = false

