  {&quot;Orb2&quot;,           &quot;89 47 04 8B 10&quot;},
  {&quot;TurboCrash&quot;,     &quot;C7 43 04 FF FF FF FF C6 03 01&quot;},
  {&quot;Timers&quot;,         &quot;48 89 8B A0 00 00 00 48 8D 4C 24 30&quot;},
  {&quot;PlayerSpeed&quot;,    &quot;0F 10 47 04 48 8B 7C 24 38 48 83 C4 20 5B C3 F3&quot;},
  -- InfAmmo uses pointer chain (no AOB) so we check LocalPlayer which it depends on
  -- These are the pointer offsets used: playerBase+0x2C8+slot*8 -&gt; wep+0xC / wep+0x10
  -- ViewAngles hook (spinbot depends on this)
  {&quot;ViewAngles&quot;,     &quot;F3 0F 11 47 1C 7A&quot;},
  -- Freecam hook
  {&quot;Freecam&quot;,        &quot;89 01 48 8D 49 04 49 83 E8 01 75 F1 48&quot;},
  -- pSticky base (gun stat tweaks)
  {&quot;pStickyBase&quot;,    &quot;F7 43 EA 80 90 95 80 80&quot;},
  -- Chams base (wallhack rendering)
  {&quot;ChamsBase&quot;,      &quot;A6 95 80 80 00 00 00 00&quot;},
  -- LocalPlayer capture hook
  {&quot;LocalPlayerHook&quot;,&quot;0F 10 89 C0 01 00 00 0F 54 0D&quot;},
}
for _, e in ipairs(exact) do
  local hits = scan(e[2])
  if #hits == 0 then
    w(&quot;MISS  &quot; .. e[1] .. &quot;  &quot; .. e[2])
  elseif #hits == 1 then
    w(&quot;OK    &quot; .. e[1] .. &quot;  @d2+&quot; .. string.format(&quot;%X&quot;, hits[1]-d2base) .. &quot;  &quot; .. ctx(hits[1],6,20))
  else
    w(&quot;DUP(&quot; .. #hits .. &quot;)  &quot; .. e[1])
    for _, h in ipairs(hits) do
      w(&quot;      d2+&quot; .. string.format(&quot;%X&quot;,h-d2base) .. &quot;  &quot; .. ctx(h,6,20))
    end
  end
end

-- 鈹€鈹€ BROADER PATTERNS FOR MISS ITEMS 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
w(&quot;&quot;)
w(&quot;--- BROADER SCAN (find updated AOBs for broken features) ---&quot;)
local broad = {
  -- name, broad_pattern, note
  {&quot;NoRecoil&quot;,      &quot;0F 11 8B ?? ?? 00 00&quot;,           &quot;offset 0x1020 may have changed&quot;},
  {&quot;NoRecoil_alt&quot;,  &quot;0F 11 8B ?? ?? 10 00&quot;,           &quot;high byte 0x10 still present?&quot;},
  {&quot;AbilityRate&quot;,   &quot;F3 44 0F 11 5C 24 ?? 44 8B&quot;,     &quot;rsp offset changed&quot;},
  {&quot;InfTokens&quot;,     &quot;89 08 48 83 C4 38 C3&quot;,            &quot;trailing 90 removed&quot;},
  {&quot;InfTokens_alt&quot;, &quot;89 08 48 83 C4 ?? C3&quot;,            &quot;stack size changed&quot;},
  {&quot;RapidFire&quot;,     &quot;F3 0F 11 86 ?? ?? 00 00&quot;,         &quot;struct offset 0x179C moved&quot;},
  {&quot;GenOrbs&quot;,       &quot;89 51 48 48 8B D?&quot;,               &quot;last nibble wildcard&quot;},
  {&quot;GenOrbs_alt&quot;,   &quot;89 51 ?? 48 8B D9&quot;,               &quot;offset 0x48 moved&quot;},
  {&quot;Stacks2&quot;,       &quot;F3 0F 10 C8 0F 11 0A C3&quot;,         &quot;shorter, drop tail&quot;},
  {&quot;Stacks2_alt&quot;,   &quot;F3 0F 10 C8 0F 11 0A&quot;,            &quot;even shorter&quot;},
  {&quot;InteractSpd&quot;,   &quot;F3 0F 11 43 08 48 83 C4 30 5B C3&quot;,&quot;drop trailing 83&quot;},
  {&quot;InteractSpd2&quot;,  &quot;F3 0F 11 43 08 48 83 C4 ?? 5B C3&quot;,&quot;stack size changed&quot;},
  {&quot;FoV3&quot;,          &quot;F3 0F 11 43 08 F3 0F 10 87 ?? ?? ?? ??&quot;,&quot;rdi offset changed&quot;},
  {&quot;ShieldSize&quot;,    &quot;F3 0F 10 B3 ?? 00 00 00&quot;,         &quot;offset 0xB8 moved&quot;},
  {&quot;ShieldSize_alt&quot;,&quot;F3 0F 10 B3 ?? ?? 00 00&quot;,         &quot;2-byte offset&quot;},
  {&quot;Damage2&quot;,       &quot;F3 44 0F 10 61 24 44 0F 29&quot;,      &quot;add suffix&quot;},
  {&quot;Damage2_alt&quot;,   &quot;F3 44 0F 10 61 ?? 44 0F 29&quot;,      &quot;offset 0x24 changed&quot;},
  {&quot;Orb2&quot;,          &quot;89 47 04 8B 1?&quot;,                  &quot;last nibble wildcard&quot;},
  {&quot;Orb2_alt&quot;,      &quot;89 47 04 8B 10 8B&quot;,               &quot;add suffix&quot;},
  -- New entries for previously-unscanned bases
  {&quot;ViewAngles&quot;,    &quot;F3 0F 11 47 1C 7A&quot;,               &quot;spinbot dep: write view yaw&quot;},
  {&quot;ViewAngl_alt&quot;,  &quot;F3 0F 11 47 1C&quot;,                  &quot;shorter, drop Z byte&quot;},
  {&quot;Freecam&quot;,       &quot;89 01 48 8D 49 04 49 83 E8 01&quot;,   &quot;freecam write hook&quot;},
  {&quot;Freecam_alt&quot;,   &quot;89 01 48 8D 49 04 49 83 E8&quot;,      &quot;shorter&quot;},
  {&quot;pStickyBase&quot;,   &quot;F7 43 EA 80 90 95 80 80&quot;,         &quot;gun stat table ptr&quot;},
  {&quot;pStickyB_alt&quot;,  &quot;90 95 80 80 00 00 00 00&quot;,         &quot;upper bytes only&quot;},
  {&quot;ChamsBase&quot;,     &quot;A6 95 80 80 00 00 00 00&quot;,         &quot;chams render table&quot;},
  {&quot;ChamsB_alt&quot;,    &quot;?? F9 ?? 02 00 00 00 FF FF FF FF FF FF FF FF&quot;, &quot;mid section&quot;},
}
for _, e in ipairs(broad) do
  local hits = scan(e[2], 4)
  if #hits == 0 then
    w(&quot;NOMATCH  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]  &quot; .. e[2])
  else
    w(&quot;FOUND(&quot; .. #hits .. &quot;)  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
    for _, h in ipairs(hits) do
      w(&quot;  d2+&quot; .. string.format(&quot;%X&quot;,h-d2base) .. &quot;  &quot; .. ctx(h,6,24))
    end
  end
end

-- 鈹€鈹€ destinyBase / WASD+DirectFly SEARCH 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
w(&quot;&quot;)
w(&quot;--- destinyBase SEARCH (WASD + DirectFly broken) ---&quot;)
w(&quot;  OLD 2F41E70 (WASD/shellLP) = &quot; .. tostring(getAddressSafe('destiny2.exe+2F41E70')))
w(&quot;  OLD 2F40E60 (DirectFly)    = &quot; .. tostring(getAddressSafe('destiny2.exe+2F40E60')))

-- Resolve RIP-relative instruction target
local function resolveRIP(h, instrLen, off)
  local b = readBytes(h + off, 4, true)
  if not b or #b &lt; 4 then return nil end
  local d = b[1] + b[2]*256 + b[3]*65536 + b[4]*16777216
  if d &gt;= 0x80000000 then d = d - 0x100000000 end
  return h + instrLen + d
end

-- Scan REX.W MOV/LEA rXX,[rip+d32] that point into d2 data (0x100000..0xA000000)
local rip_modrm = {&quot;05&quot;,&quot;0D&quot;,&quot;15&quot;,&quot;1D&quot;,&quot;25&quot;,&quot;2D&quot;,&quot;35&quot;,&quot;3D&quot;}
local cands = {}
local function addRIPcands(prefix, instrLen, label)
  for _, mr in ipairs(rip_modrm) do
    local hits = scan(string.format(&quot;48 %s %s ?? ?? ?? ??&quot;, prefix, mr), 200)
    for _, h in ipairs(hits) do
      local tgt = resolveRIP(h, instrLen, 3)
      if tgt then
        local off = tgt - d2base
        if off &gt;= 0x100000 and off &lt;= 0xA000000 then
          cands[#cands+1] = {h-d2base, off, label}
        end
      end
    end
  end
end
addRIPcands(&quot;8B&quot;, 7, &quot;MOV_r64&quot;)
addRIPcands(&quot;8D&quot;, 7, &quot;LEA_r64&quot;)

-- Also scan MOVSS [rip+d32],xmm (write path to static floats)
local movss_w_modrm = {&quot;05&quot;,&quot;0D&quot;,&quot;15&quot;,&quot;1D&quot;,&quot;25&quot;,&quot;2D&quot;,&quot;35&quot;,&quot;3D&quot;}
for _, mr in ipairs(movss_w_modrm) do
  local hits = scan(string.format(&quot;F3 0F 11 %s ?? ?? ?? ??&quot;, mr), 200)
  for _, h in ipairs(hits) do
    local tgt = resolveRIP(h, 8, 4)
    if tgt then
      local off = tgt - d2base
      if off &gt;= 0x100000 and off &lt;= 0xA000000 then
        cands[#cands+1] = {h-d2base, off, &quot;MOVSS_WRITE&quot;}
      end
    end
  end
end

table.sort(cands, function(a,b) return a[2] &lt; b[2] end)
if #cands == 0 then
  w(&quot;  None found in d2+100000..A000000&quot;)
else
  local prev = -1
  for i = 1, math.min(80, #cands) do
    local c = cands[i]
    if c[2] - prev &gt; 0x800 then w(&quot;&quot;) end
    w(string.format(&quot;  instr@d2+%X  -&gt;  data@d2+%X  [%s]&quot;, c[1], c[2], c[3]))
    prev = c[2]
  end
  w(string.format(&quot;  Total %d candidates (showed %d)&quot;, #cands, math.min(80,#cands)))
end

-- 鈹€鈹€ destinyBase DIRECT READ TEST 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
w(&quot;&quot;)
w(&quot;--- destinyBase direct float read test (look for ~-1 to 1 direction vecs) ---&quot;)
-- If we know any candidate that could be destinyBase, check offset+0x10..+0x18 for unit vectors
if #cands &gt; 0 then
  for i = 1, math.min(20, #cands) do
    local c = cands[i]
    local tgt = d2base + c[2]
    local ok, vals = pcall(function()
      local x = readFloat(tgt + 0x10)
      local y = readFloat(tgt + 0x14)
      local z = readFloat(tgt + 0x18)
      return {x, y, z}
    end)
    if ok and vals then
      local x,y,z = vals[1],vals[2],vals[3]
      -- direction vector should have magnitude ~1.0
      local mag2 = x*x + y*y + z*z
      if mag2 &gt; 0.5 and mag2 &lt; 2.0 then
        w(string.format(&quot;  CANDIDATE destinyBase@d2+%X  dir=%.3f,%.3f,%.3f  |mag2=%.3f|&quot;, c[2], x,y,z, mag2))
      end
    end
  end
end

w(&quot;&quot;)
-- ── SECTION 3: AMMO SYSTEM ──────────────────────────────────────────────────
w(&quot;&quot;)
w(&quot;--- SECTION 3: AMMO SYSTEM (InfAmmo fix) ---&quot;)
do
  local ammo_pats = {
    {&quot;WepSlot_2C8&quot;,&quot;48 8B ?? C8 02 00 00 48 85 ?? 74&quot;,&quot;wep ptr at player+0x2C8&quot;},
    {&quot;WepSlot_2D0&quot;,&quot;48 8B ?? D0 02 00 00 48 85 ?? 74&quot;,&quot;wep ptr at player+0x2D0&quot;},
    {&quot;WepSlot_var&quot;,&quot;48 8B ?? ?? 02 00 00 48 85 ?? 74&quot;,&quot;wep ptr at player+0x2xx&quot;},
    {&quot;MagDec_32&quot;,  &quot;FF C8 89 ?? ?? ?? ?? ?? 48 8B&quot;,  &quot;dec eax; store32&quot;},
    {&quot;MagDec_16&quot;,  &quot;FF C8 66 89 ?? ?? ?? ??&quot;,         &quot;dec eax; store16&quot;},
    {&quot;MagSub_16&quot;,  &quot;66 FF 4? ?? 00 00 00&quot;,            &quot;dec word [reg+off]&quot;},
    {&quot;WepAmmo_0C&quot;, &quot;8B ?? 0C 00 00 00 FF C? 89 ?? 0C 00 00 00&quot;,&quot;rw +0x0C&quot;},
    {&quot;WepAmmo_18&quot;, &quot;8B ?? 18 00 00 00 FF C? 89 ?? 18 00 00 00&quot;,&quot;rw +0x18&quot;},
    {&quot;WepAmmo_20&quot;, &quot;8B ?? 20 00 00 00 FF C? 89 ?? 20 00 00 00&quot;,&quot;rw +0x20&quot;},
    {&quot;WepAmmo_24&quot;, &quot;8B ?? 24 00 00 00 FF C? 89 ?? 24 00 00 00&quot;,&quot;rw +0x24&quot;},
    {&quot;WepAmmo_30&quot;, &quot;8B ?? 30 00 00 00 FF C? 89 ?? 30 00 00 00&quot;,&quot;rw +0x30&quot;},
    {&quot;WepMaxMag&quot;,  &quot;8B ?? ?? 00 00 00 3B ?? ?? 00 00 00 7C&quot;,&quot;compare mag/maxmag&quot;},
  }
  for _, e in ipairs(ammo_pats) do
