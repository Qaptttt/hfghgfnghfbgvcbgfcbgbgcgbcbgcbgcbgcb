-- ═══ PREREQUISITE AUTO-FIX ═══
local function showRebootDialog(reason)
  local dlg = createForm(true)
  dlg.Caption = &quot;BOBS D2 — Reboot Required&quot;
  dlg.Width = 400; dlg.Height = 180
  dlg.Color = 0x141414; dlg.BorderStyle = &quot;bsSingle&quot;
  dlg.Position = &quot;poScreenCenter&quot;

  local function mk(parent, cls, ...)
    local w = cls(parent); return w
  end

  local lbl1 = createLabel(dlg)
  lbl1.Caption = reason
  lbl1.Left = 20; lbl1.Top = 18
  lbl1.Font.Size = 9; lbl1.Font.Bold = true; lbl1.Font.Color = 0xFF4444
  lbl1.Color = 0x141414; lbl1.ParentColor = false; lbl1.AutoSize = true

  local lbl2 = createLabel(dlg)
  lbl2.Caption = &quot;A reboot is required before the driver can load.\nSave your work before rebooting.&quot;
  lbl2.Left = 20; lbl2.Top = 46
  lbl2.Font.Size = 8; lbl2.Font.Color = 0xBBBBBB
  lbl2.Color = 0x141414; lbl2.ParentColor = false; lbl2.AutoSize = true

  local btnNow = createButton(dlg)
  btnNow.Caption = &quot;REBOOT NOW&quot;
  btnNow.Left = 20; btnNow.Top = 108; btnNow.Width = 140; btnNow.Height = 32
  btnNow.Font.Bold = true; btnNow.Font.Color = 0xFFFFFF; btnNow.Color = 0x882222
  btnNow.OnClick = function()
    dlg.Close()
    shellExecute(&quot;open&quot;, &quot;shutdown.exe&quot;, &quot;/r /t 5&quot;, &quot;&quot;, 0)
  end

  local btnLater = createButton(dlg)
  btnLater.Caption = &quot;Later&quot;
  btnLater.Left = 174; btnLater.Top = 108; btnLater.Width = 80; btnLater.Height = 32
  btnLater.OnClick = function() dlg.Close() end

  dlg.Show()
end

-- Auto DSE toggle via -off / -on flags (no interactive prompt, no bat trick).
-- Flow: disable DSE.exe -off  →  sc start driver  →  disable DSE.exe -on
-- Runs in a native thread so CE UI stays responsive during sleeps.
local function autoDSEToggleAsync(svcName)
  local origin = TrainerOrigin or &quot;&quot;
  local dseExe = &quot;disable DSE.exe&quot;
  local fck = io.open(dseExe, &quot;rb&quot;)
  if not fck then
    dseExe = origin .. &quot;disable DSE.exe&quot;
    fck = io.open(dseExe, &quot;rb&quot;)
    if not fck then return end
  end
  fck:close()

  createNativeThread(function()
    _G[&quot;_dseMsg&quot;]    = &quot;DSE: off...&quot;
    _G[&quot;_dseMsgClr&quot;] = 0xFF8800

    -- patch DSE silently; saves state to %TEMP%\dse_state.bin and exits immediately
    os.execute('&quot;' .. dseExe .. '&quot; -off')
    sleep(2500)

    if svcName and #svcName &gt; 1 then
      os.execute('sc start &quot;' .. svcName .. '&quot; &gt;nul 2&gt;nul')
    end
    sleep(1500)

    -- restore DSE from saved state; exits immediately
    os.execute('&quot;' .. dseExe .. '&quot; -on')
    sleep(800)

    _G[&quot;_dseCheckPending&quot;] = true
    _G[&quot;_dseMsg&quot;]    = &quot;DSE: checking...&quot;
    _G[&quot;_dseMsgClr&quot;] = 0xFF8800
  end)
end

local function runPrereqCheck()
  -- Step 1: test driver
  local drvOK = false
  pcall(function() drvOK = (dbk_initialize() == true) end)

  -- Step 1b: if driver not loaded, auto-attempt DSE toggle + sc start
  if not drvOK then
    pcall(function()
      local f = io.open(&quot;driver64.dat&quot;, &quot;r&quot;)
      if not f then return end
      local svc = (f:read(&quot;*l&quot;) or &quot;&quot;):match(&quot;^%s*(.-)%s*$&quot;)
      f:close()
      if svc and #svc &gt; 1 then
        autoDSEToggleAsync(svc)  -- async — returns immediately, thread handles the rest
      end
    end)
    return  -- prereq bat is pointless until DSE flow finishes; async will update status
  end

  -- Step 2: write a bat that checks + fixes HVCI, writes result to temp file
  local resPath = (os.getenv(&quot;TEMP&quot;) or &quot;C:\\Windows\\Temp&quot;)..&quot;\\d2prereq_result.txt&quot;
  local batPath = (os.getenv(&quot;TEMP&quot;) or &quot;C:\\Windows\\Temp&quot;)..&quot;\\d2prereq_fix.bat&quot;
  os.remove(resPath)
  local bat = io.open(batPath, &quot;w&quot;)
  if bat then
    bat:write('@echo off\r\n')
    bat:write('set FIXED=0\r\n')
    bat:write('set SECBOOT=0\r\n')
    -- Check Secure Boot first — if on, nointegritychecks is silently ignored by Windows
    bat:write('REG QUERY &quot;HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecureBoot\\State&quot; /v UEFISecureBootEnabled 2&gt;nul | findstr /C:&quot;0x1&quot; &gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set SECBOOT=1\r\n')
    -- Key 1: HVCI scenario (Win10 + Win11)
    bat:write('REG QUERY &quot;HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity&quot; /v Enabled 2&gt;nul | findstr /C:&quot;0x1&quot; &gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD &quot;HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity&quot; /v Enabled /t REG_DWORD /d 0 /f &gt;nul 2&gt;nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- Key 2: VBS
    bat:write('REG QUERY &quot;HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard&quot; /v EnableVirtualizationBasedSecurity 2&gt;nul | findstr /C:&quot;0x1&quot; &gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD &quot;HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard&quot; /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f &gt;nul 2&gt;nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- Key 3: Policy HVCI
    bat:write('REG QUERY &quot;HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard&quot; /v HypervisorEnforcedCodeIntegrity 2&gt;nul | findstr /C:&quot;0x1&quot; &gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 (\r\n')
    bat:write('  REG ADD &quot;HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard&quot; /v HypervisorEnforcedCodeIntegrity /t REG_DWORD /d 0 /f &gt;nul 2&gt;nul\r\n')
    bat:write('  set FIXED=1\r\n')
    bat:write(')\r\n')
    -- bcdedit: kill hypervisor launch
    bat:write('bcdedit /set hypervisorlaunchtype off &gt;nul 2&gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set FIXED=1\r\n')
    -- DSE bypass via nointegritychecks (Win11 24H2 — disable DSE.exe no longer reliable)
    -- Only works when Secure Boot is OFF; if SECBOOT=1 we report that instead
    -- nointegritychecks: always apply — works on Win10 even with Secure Boot on
    -- On Win11 24H2 with Secure Boot ON this gets ignored, but we still try
    bat:write('bcdedit /set nointegritychecks on &gt;nul 2&gt;nul\r\n')
    bat:write('bcdedit /set testsigning on &gt;nul 2&gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set FIXED=1\r\n')
    -- Disable Hyper-V / VMP / HypervisorPlatform Windows Features (DBVMM VT-x fix)
    bat:write('dism /Online /Disable-Feature /FeatureName:Microsoft-Hyper-V-All /NoRestart /Quiet &gt;nul 2&gt;nul\r\n')
    bat:write('dism /Online /Disable-Feature /FeatureName:VirtualMachinePlatform /NoRestart /Quiet &gt;nul 2&gt;nul\r\n')
    bat:write('dism /Online /Disable-Feature /FeatureName:HypervisorPlatform /NoRestart /Quiet &gt;nul 2&gt;nul\r\n')
    -- Check Windows version to flag Win11 + Secure Boot combo specifically
    bat:write('set WIN11=0\r\n')
    bat:write('ver | findstr /C:&quot;10.0.2&quot; &gt;nul\r\n')
    bat:write('if %ERRORLEVEL%==0 set WIN11=1\r\n')
    -- Write result (goto avoids nested-if scoping issues in cmd)
    bat:write('if &quot;%WIN11%&quot;==&quot;1&quot; if &quot;%SECBOOT%&quot;==&quot;1&quot; goto :sb11\r\n')
    bat:write('if &quot;%FIXED%&quot;==&quot;1&quot; (echo HVCI_FIXED&gt;'..resPath..') else (echo HVCI_OK&gt;'..resPath..')\r\n')
    bat:write('goto :done\r\n')
    bat:write(':sb11\r\n')
    bat:write('echo SECUREBOOT_WIN11&gt;'..resPath..'\r\n')
    bat:write(':done\r\n')
    bat:close()
    shellExecute(&quot;runas&quot;, &quot;cmd.exe&quot;, '/c &quot;'..batPath..'&quot;', &quot;&quot;, 0)
  end

  -- Step 3: poll for bat result (up to 10 seconds)
  local pollTmr = createTimer(nil, false)
  pollTmr.Interval = 500
  local pollN = 0
  pollTmr.OnTimer = function()
    pollN = pollN + 1
    local fh = io.open(resPath, &quot;r&quot;)
    if fh then
      local result = (fh:read(&quot;*l&quot;) or &quot;&quot;):match(&quot;^%s*(.-)%s*$&quot;)
      fh:close()
      pollTmr.Enabled = false; pcall(function() pollTmr.Destroy() end)
      if result == &quot;SECUREBOOT_WIN11&quot; then
        -- Secure Boot blocks nointegritychecks — must go into UEFI
        local dlg = createForm(true)
        dlg.Caption = &quot;BOBS D2 — Secure Boot Blocking Driver&quot;
        dlg.Width = 430; dlg.Height = 210
        dlg.Color = 0x141414; dlg.BorderStyle = &quot;bsSingle&quot;
        dlg.Position = &quot;poScreenCenter&quot;
        local t1 = createLabel(dlg)
        t1.Caption = &quot;Win11 + Secure Boot ON — driver blocked at boot&quot;
        t1.Left = 16; t1.Top = 16; t1.Font.Size = 9; t1.Font.Bold = true
        t1.Font.Color = 0xFF4444; t1.Color = 0x141414; t1.ParentColor = false; t1.AutoSize = true
        local t2 = createLabel(dlg)
        t2.Caption = &quot;Fix (required once):\n1. Restart PC  →  spam DEL / F2 at boot to enter UEFI\n2. Find  Security  →  Secure Boot  →  set DISABLED\n3. Save and reboot back into Windows\n4. Re-open CE and load this CT — driver will auto-fix rest&quot;
        t2.Left = 16; t2.Top = 46; t2.Font.Size = 8
        t2.Font.Color = 0xCCCCCC; t2.Color = 0x141414; t2.ParentColor = false; t2.AutoSize = true
        local btnOK = createButton(dlg)
        btnOK.Caption = &quot;OK, going to UEFI&quot;
        btnOK.Left = 16; btnOK.Top = 164; btnOK.Width = 140; btnOK.Height = 28
        btnOK.Font.Bold = true; btnOK.OnClick = function() dlg.Close() end
        dlg.Show()
        lblStatus.Caption = &quot;● SECURE BOOT&quot;; lblStatus.Font.Color = 0xFF4444
      elseif result == &quot;HVCI_FIXED&quot; then
        showRebootDialog(&quot;HVCI + Hyper-V + DSE disabled. Reboot to apply.&quot;)
      elseif result == &quot;HVCI_OK&quot; and not drvOK then
        lblStatus.Caption = &quot;● DRIVER FAIL&quot;; lblStatus.Font.Color = 0xFF4444
      end
    elseif pollN &gt; 20 then
      pollTmr.Enabled = false; pcall(function() pollTmr.Destroy() end)
    end
  end
  pollTmr.Enabled = true
end

-- Delay 6s after CT load so CE fully initializes (process watcher, driver, etc.)
local prereqTmr = createTimer(nil, false)
prereqTmr.Interval = 6000
prereqTmr.OnTimer = function()
  prereqTmr.Enabled = false; pcall(function() prereqTmr.Destroy() end)
  pcall(runPrereqCheck)
end
prereqTmr.Enabled = true

