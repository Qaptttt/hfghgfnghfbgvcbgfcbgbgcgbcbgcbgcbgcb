    {&quot;LightLvl1&quot;, &quot;F3 0F 10 ?? 98 0C 00 00&quot;,&quot;movss +0xC98 (light level)&quot;},
    {&quot;LightLvl2&quot;, &quot;F3 0F 10 ?? ?? 0C 00 00&quot;,&quot;movss +0xCxx&quot;},
    {&quot;GRank&quot;,     &quot;0F B7 ?? 84 1E 00 00&quot;,&quot;movzx guardian rank +0x1E84&quot;},
    {&quot;CharData1&quot;, &quot;48 8D 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B&quot;,&quot;lea static char; call&quot;},
    {&quot;CharData2&quot;, &quot;48 8B 35 ?? ?? ?? ?? 48 85 F6 74 ?? 48 8B 86&quot;,&quot;load char ptr&quot;},
  }
  for _, e in ipairs(inv_pats) do
    local hits = scan(e[2], 4)
    if #hits == 0 then
      w(&quot;NOMATCH  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
    else
      w(&quot;FOUND(&quot; .. #hits .. &quot;)  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
      for _, h in ipairs(hits) do
        local extra = &quot;&quot;
        if e[1]:find(&quot;Ptr&quot;) or e[1]:find(&quot;Data&quot;) then
          local tgt = resolveRIP(h, 7, 3)
          if tgt then extra = &quot;  -&gt;static@d2+&quot; .. string.format(&quot;%X&quot;, tgt-d2base) end
        end
        w(&quot;  d2+&quot; .. string.format(&quot;%X&quot;,h-d2base) .. &quot;  &quot; .. ctx(h,6,24) .. extra)
      end
    end
  end
end

