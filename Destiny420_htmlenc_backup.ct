local function getPlayerBase()
  local pp = getAddressSafe(&quot;Player&quot;)
  if not pp or pp == 0 then return nil end
  local base = readPointer(pp)
  if not base or base == 0 then return nil end
  return base
end

local function saveSlot(slot)
  local base = getPlayerBase()
  if not base then return end
  SavedTPSlots[slot] = {
    x = readFloat(base + 0x1C0),
    y = readFloat(base + 0x1C4),
    z = readFloat(base + 0x1C8)
  }
end

local function loadSlot(slot)
  local s = SavedTPSlots[slot]
  if not s or s.x == 0 then return end
  local base = getPlayerBase()
  if not base then return end
  writeFloat(base + 0x1C0, s.x)
  writeFloat(base + 0x1C4, s.y)
  writeFloat(base + 0x1C8, s.z)
  writeFloat(base + 0x230, 0)
  writeFloat(base + 0x234, 0)
  writeFloat(base + 0x238, 0)
end

local function tpLoop()
  while SaveTPRunning do
    for i, vk in ipairs(VK_NUMPAD) do
      local down = isKeyPressed(vk)
      if down and not prevKeys[i] then
        if i &lt;= 3 then
          saveSlot(i)
        else
          loadSlot(i - 3)
        end
      end
      prevKeys[i] = down
    end
    sleep(50)
  end
end

createNativeThread(tpLoop)
