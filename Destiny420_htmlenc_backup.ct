    pcall(writePointer, p.thunk, p.orig)
  end
end
if _G[&quot;SpoofTramp9031&quot;] then
  pcall(deAlloc, _G[&quot;SpoofTramp9031&quot;])
  _G[&quot;SpoofTramp9031&quot;] = nil
end
if _G[&quot;SpoofTrampA9031&quot;] then
  pcall(deAlloc, _G[&quot;SpoofTrampA9031&quot;])
  _G[&quot;SpoofTrampA9031&quot;] = nil
end
_G[&quot;SpoofPatched9031&quot;] = nil
_G[&quot;SpoofGUID9031&quot;] = nil
_G[&quot;SpoofFakeSerial9031&quot;] = nil
{$asm}
&lt;/AssemblerScript&gt;
    &lt;/CheatEntry&gt;
    &lt;CheatEntry&gt;
      &lt;ID&gt;9032&lt;/ID&gt;
      &lt;Description&gt;&quot;Driver Stealth [run once after CT load]&quot;&lt;/Description&gt;
      &lt;Color&gt;FF4400&lt;/Color&gt;
      &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
      &lt;AssemblerScript&gt;[ENABLE]
{$lua}
if syntaxcheck then return end

local origin = TrainerOrigin or &quot;&quot;

-- 1: delete the SCM service registry key (all ControlSets)
--    BattleEye calls EnumServicesStatus — removing the key kills the entry
pcall(function()
  local f = io.open(&quot;driver64.dat&quot;, &quot;r&quot;)
  if not f then
    f = io.open(origin .. &quot;driver64.dat&quot;, &quot;r&quot;)
    if not f then return end
  end
  local svc = (f:read(&quot;*l&quot;) or &quot;&quot;):match(&quot;^%s*(.-)%s*$&quot;)
  f:close()
  if not svc or #svc &lt; 2 then return end
  -- delete from all three ControlSet locations
  for _, cs in ipairs({&quot;CurrentControlSet&quot;,&quot;ControlSet001&quot;,&quot;ControlSet002&quot;}) do
    os.execute('reg delete &quot;HKLM\\SYSTEM\\' .. cs .. '\\Services\\' .. svc .. '&quot; /f &gt;nul 2&gt;nul')
  end
  -- sc delete also removes pending-delete mark in SCM in-memory table
  os.execute('sc delete &quot;' .. svc .. '&quot; &gt;nul 2&gt;nul')
end)

-- 2: rename (then delete) the .sys file from disk
--    Once loaded, the file can be renamed/deleted — kernel image stays in RAM.
--    BattleEye scans %SystemRoot%\System32\drivers and app dirs for known sys filenames.
pcall(function()
  local f = io.open(&quot;driver64.dat&quot;, &quot;r&quot;)
  if not f then f = io.open(origin..&quot;driver64.dat&quot;,&quot;r&quot;) end
  if not f then return end
  f:read(&quot;*l&quot;); f:read(&quot;*l&quot;); f:read(&quot;*l&quot;)   -- skip line1, line2, line3
  local sysName = (f:read(&quot;*l&quot;) or &quot;&quot;):match(&quot;^%s*(.-)%s*$&quot;)  -- line 4 = .sys filename
  f:close()
  if not sysName or #sysName &lt; 3 then return end
  -- try both local dir and origin dir
  for _, dir in ipairs({origin, origin..&quot;drivers\\&quot;}) do
    local fp = dir .. sysName
    local fh = io.open(fp, &quot;rb&quot;)
    if fh then
      fh:close()
      -- rename to a random temp name so the original name is gone from disk
      local tmp = fp:gsub(&quot;%.sys$&quot;, math.random(10000,99999)..&quot;.tmp&quot;)
      os.rename(fp, tmp)
      break
    end
  end
end)

-- 3: PE header erasure DISABLED.
-- Zeroing kernel module headers triggers PatchGuard CRITICAL_STRUCTURE_CORRUPTION
-- bugcheck 0x109 on Win10/11. SCM deletion + file rename (steps 1-2) are sufficient.

-- 4: spoof CE's own PEB ImagePathName to look like a system process
--    replaces the unicode path string in the PEB so task managers + BE show a fake name
pcall(function()
  local peb = getAddressSafe(&quot;__readgsqword(0x60)&quot;)  -- not available from Lua directly
  -- use readPointer chain: TEB (GS:[0x30]) → PEB (offset 0x60) → ProcessParameters (0x20)
  -- → ImagePathName.Buffer (0x60), ImagePathName.Length (0x58)
  -- We can't read GS from Lua, but we CAN find the PEB via NtCurrentTeb if CE exposes it
  -- Best-effort: use a known CE Lua PEB accessor if available
  local getPEB = _G[&quot;getCEprocessParam&quot;] or _G[&quot;getPEB&quot;] or _G[&quot;dbk_getPEB&quot;]
  if getPEB then
    local pebAddr = getPEB()
    if pebAddr and pebAddr ~= 0 then
      local pp = readPointer(pebAddr + 0x20)  -- ProcessParameters
      if pp and pp ~= 0 then
        -- ImagePathName at pp+0x60 (Length at pp+0x60, MaxLength at pp+0x62, Buffer at pp+0x68)
        local bufPtr = readPointer(pp + 0x68)
        if bufPtr and bufPtr ~= 0 then
          local fakeName = &quot;conhost.exe\0&quot;
          local fakeW = {}
          for c in fakeName:gmatch(&quot;.&quot;) do fakeW[#fakeW+1] = c:byte(); fakeW[#fakeW+1] = 0 end
          writeSmallInteger(pp + 0x60, #fakeW)
          pcall(writeBytes, bufPtr, table.unpack(fakeW))
        end
      end
    end
  end
end)
