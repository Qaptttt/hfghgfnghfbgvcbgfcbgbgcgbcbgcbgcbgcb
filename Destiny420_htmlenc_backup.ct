        &lt;CheatEntry&gt;
          &lt;ID&gt;2205&lt;/ID&gt;
          &lt;Description&gt;&quot;Heretic Clan Tag&quot;&lt;/Description&gt;
          &lt;Options moHideChildren=&quot;1&quot;/&gt;
          &lt;Color&gt;FF0080&lt;/Color&gt;
          &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
          &lt;AssemblerScript&gt;{$lua}
--GetLuaEngine().MenuItem5.doClick()
local counter = 0
local strings = {
    &quot;                  &quot;,
    &quot;                 A&quot;,
    &quot;                Al&quot;,
    &quot;               Alu&quot;,
    &quot;              Alur&quot;,
    &quot;             Alura&quot;,
    &quot;            Alura &quot;,
    &quot;           Alura S&quot;,
    &quot;          Alura So&quot;,
    &quot;         Alura Sol&quot;,
    &quot;        Alura Solu&quot;,
    &quot;       Alura Solut&quot;,
    &quot;      Alura Soluti&quot;,
    &quot;     Alura Solutio&quot;,
    &quot;    Alura Solution&quot;,
    &quot;   Alura Solutions&quot;,
    &quot;  Alura Solutions &quot;,
    &quot; Alura Solutions  &quot;,
    &quot;Alura Solutions   &quot;,
    &quot;lura Solutions    &quot;,
    &quot;ura Solutions     &quot;,
    &quot;ra Solutions      &quot;,
    &quot;a Solutions       &quot;,
    &quot; Solutions        &quot;,
    &quot;Solutions         &quot;,
    &quot;olutions          &quot;,
    &quot;lutions           &quot;,
    &quot;utions            &quot;,
    &quot;tions             &quot;,
    &quot;ions              &quot;,
    &quot;ons               &quot;,
    &quot;ns                &quot;,
    &quot;s                 &quot;,
}

function NameFunction()
    local baseAddress = getAddress(&quot;destiny2.exe&quot;) + 0x2E0E422
    local stringIndex = (counter % #strings) + 1
    local stringToWrite = strings[stringIndex]
    writeString(baseAddress, stringToWrite)
    counter = counter + 1
end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 100 -- Adjust the delay (in milliseconds) between each iteration as needed
  tmr.OnTimer = NameFunction
  tmr.Enabled = true
end

function disableFunction()
  tmr.Enabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()

[DISABLE]
disableFunction()
&lt;/AssemblerScript&gt;
        &lt;/CheatEntry&gt;
        &lt;CheatEntry&gt;
          &lt;ID&gt;1605&lt;/ID&gt;
          &lt;Description&gt;&quot;Name Animation&quot;&lt;/Description&gt;
          &lt;Color&gt;FF0080&lt;/Color&gt;
          &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
          &lt;AssemblerScript&gt;{$lua}
if syntaxcheck then return end

[ENABLE]
-- Define the pointer address
local playerNamePointer = getAddress(&quot;destiny2.exe+2ED7D32&quot;)
local maxNameLength = 25  -- Define the maximum length for the name

-- Control variables
local isAnimating = false  -- Flag for animating the name (scrolling effect)
local isRandomizing = false  -- Flag for randomizing the name (without clearing)
local isSpamming = false  -- Flag for spamming (alternating between random name and clearing)

-- Store original name
local originalName = &quot;&quot;  -- The name before Ghost mode or Hello mode is activated

-- Calculate the player name address directly from the pointer
local playerNameAddress = playerNamePointer

-- AOB Scan to find INV+1E22 offset
local aobPattern = &quot;00 00 00 00 07 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF&quot;
local aobScanResult = AOBScan(aobPattern)
local invOffset = nil

if aobScanResult ~= nil and aobScanResult.Count &gt; 0 then
    -- Get the first address found by the AOB scan and add the offset (1E22)
    invOffset = tonumber(aobScanResult[0], 16) + 0x1E22
end

-- Create the form for entering the player name
myForm = createForm()
myForm.Caption = &quot;Enter Player Name&quot;
myForm.Width = 300
myForm.Height = 300  -- Increased height to fit additional controls
myForm.Position = &quot;poScreenCenter&quot;
myForm.BorderStyle = &quot;bsSingle&quot;

-- Create an input box for the name
local inputBox = createEdit(myForm)
inputBox.Top = 10
inputBox.Left = 10
inputBox.Width = 280

-- Store the original name from inputBox
originalName = inputBox.Text

-- Create a button to apply the name change
local applyButton = createButton(myForm)
applyButton.Caption = &quot;Apply Name&quot;
applyButton.Top = 40
applyButton.Left = 10
applyButton.Width = 100

-- Create a checkbox for the &quot;Randomize Name Continuously&quot; option
local chkRandomize = createCheckBox(myForm)
chkRandomize.Caption = &quot;Randomize Name&quot;
chkRandomize.Top = 80
chkRandomize.Left = 10

-- Create a checkbox for the &quot;Spam Name&quot; option
local chkSpam = createCheckBox(myForm)
chkSpam.Caption = &quot;Spam Departed/Joined Fireteam&quot;
chkSpam.Top = 110
chkSpam.Left = 10

-- Create a checkbox for the &quot;Animate Name&quot; option
local chkAnimate = createCheckBox(myForm)
chkAnimate.Caption = &quot;Animate Name&quot;
chkAnimate.Top = 140
chkAnimate.Left = 10

-- Create a checkbox for the &quot;Ghost&quot; functionality (clearing the name)
local chkGhost = createCheckBox(myForm)
chkGhost.Caption = &quot;Ghost Mode&quot;
chkGhost.Top = 170
chkGhost.Left = 10

-- Create a checkbox for the &quot;Hello&quot; functionality (set name to &quot;Hello&quot;)
local chkHello = createCheckBox(myForm)
chkHello.Caption = &quot;Racism Mode&quot;
chkHello.Top = 200
chkHello.Left = 10

-- Function to generate a random name using letters, numbers, and basic symbols
local function generateRandomName()
    local chars = &quot;abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&amp;*()-_=+&quot;
    local randomName = &quot;&quot;
    for i = 1, maxNameLength do
        local randomIndex = math.random(1, #chars)
        randomName = randomName .. chars:sub(randomIndex, randomIndex)
    end
    return randomName
end

-- Function to clear the player's name (set it to an empty string)
local function clearName()
    for i = 0, maxNameLength - 1 do
        writeBytes(playerNameAddress + i, 0x00)  -- Clear the memory
    end
end

-- Function to set the player's name to &quot;Hello&quot;
local function setHelloName()
    local helloName = &quot;卍卍Nigger卍卍&quot; .. string.rep(&quot; &quot;, maxNameLength - 5)  -- &quot;Hello&quot; with padding
    writeString(playerNameAddress, helloName)
end

-- Function to animate the name (scrolling effect from right to left)
local function animateName()
    local paddedName = originalName .. string.rep(&quot; &quot;, maxNameLength - #originalName)

    while isAnimating do
        -- Shift the characters to the right
        paddedName = paddedName:sub(-1) .. paddedName:sub(1, -2)

        -- Clear existing name in memory and write the animated name
        for i = 0, maxNameLength - 1 do
            writeBytes(playerNameAddress + i, 0x00)
        end
        writeString(playerNameAddress, paddedName:sub(1, maxNameLength))

        -- Delay to control animation speed
        sleep(50)  -- Adjust the delay as needed (50ms here)
    end
end

-- Function to handle randomizing the name (without clearing it)
local function randomizeName()
    while isRandomizing do
        local randomName = generateRandomName()  -- Generate a random name
        writeString(playerNameAddress, randomName:sub(1, maxNameLength))  -- Write the random name to the address

        sleep(100)  -- Wait for 100ms before randomizing again
    end
end

-- Function to handle spamming the name (alternating between random name and clearing it)
local function spamNameLoop()
    while isSpamming do
        local randomName = generateRandomName()  -- Generate a random name
        writeString(playerNameAddress, randomName:sub(1, maxNameLength))  -- Write the random name to the address

        sleep(100)  -- Wait for 100ms before clearing the name

        clearName()  -- Clear the name from the address

        sleep(100)  -- Wait for another 100ms before writing a new random name
    end
end

-- Randomize Name checkbox event
chkRandomize.OnChange = function()
    if chkRandomize.Checked then
        isRandomizing = true
        createThread(randomizeName)  -- Start randomizing name in a new thread
    else
        isRandomizing = false  -- Stop the randomization loop
    end
end

-- Spam Name checkbox event
chkSpam.OnChange = function()
    if chkSpam.Checked then
        isSpamming = true
        createThread(spamNameLoop)  -- Start the name spamming loop in a new thread
    else
        isSpamming = false  -- Stop the name spamming loop
    end
end

-- Animate Name checkbox event
chkAnimate.OnChange = function()
    if chkAnimate.Checked then
        isAnimating = true
        createThread(animateName)  -- Start animating the name in a new thread
    else
        isAnimating = false  -- Stop the animation loop
    end
end

-- Ghost Mode checkbox event
chkGhost.OnChange = function()
    if chkGhost.Checked then
        -- Save the last name before clearing it
        originalName = inputBox.Text
        clearName()  -- Clear the name when Ghost mode is activated
    else
        -- Revert to the last name before Ghost mode
        writeString(playerNameAddress, originalName:sub(1, maxNameLength))
    end
end

-- Hello Mode checkbox event
chkHello.OnChange = function()
    if chkHello.Checked then
        -- Write the value 9967 (0x26EF) as 2 bytes to the offset INV+1E22
        if invOffset ~= nil then
            writeBytes(invOffset, 0xEF)  -- Lower byte of 0x26EF
            writeBytes(invOffset + 1, 0x26)  -- Higher byte of 0x26EF
        end
        setHelloName()  -- Optionally, set the name to &quot;Hello&quot;
    else
        -- Reset or handle unticking as needed (apply name in box)
        applyButton.OnClick()  -- Apply the name from the input box when &quot;Hello&quot; mode is unchecked
    end
end

-- Apply Name button action
applyButton.OnClick = function()
    local newName = inputBox.Text
    if newName == &quot;&quot; then
        showMessage(&quot;The name field cannot be left blank.&quot;)
        return
    end
    originalName = newName  -- Update original name

    for i = 0, maxNameLength - 1 do
        writeBytes(playerNameAddress + i, 0x00)
    end
    writeString(playerNameAddress, newName:sub(1, maxNameLength))
end

-- Stop animation and revert on form close
myForm.OnClose = function()
    isAnimating = false
    isRandomizing = false
    isSpamming = false
    sleep(250)  -- Allow time for the thread to fully terminate

    local revertName = inputBox.Text
    for i = 0, maxNameLength - 1 do
        writeBytes(playerNameAddress + i, 0x00)
    end
    writeString(playerNameAddress, revertName:sub(1, maxNameLength))

    myForm.hide()
    return caHide
end

[DISABLE]
-- Stop the randomization and spamming process if running
isRandomizing = false
isSpamming = false
isAnimating = false
sleep(1000)  -- Allow time for the thread to fully terminate

-- Trigger the form's OnClose event to stop animation and reset name
if myForm ~= nil then
    myForm.OnClose()  -- Call OnClose to handle stopping and resetting
    myForm = nil  -- Clear the reference to the form
end

-- Force garbage collection
collectgarbage()

