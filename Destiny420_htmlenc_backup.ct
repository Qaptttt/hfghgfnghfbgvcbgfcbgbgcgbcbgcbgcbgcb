          &lt;AssemblerScript&gt;[ENABLE]
{$lua}
if syntaxcheck then return end
-- pattern dead as of last scan; guard so aobscan failure doesn't leave dangling labels
local r = AOBScan(&quot;48 89 8B A0 00 00 00 48 8D 4C 24 30&quot;)
if not r or r.Count == 0 then
  if r then r.destroy() end
  error(&quot;Timers pattern NOMATCH - needs rescan&quot;)
end
local addr = tonumber(r[0], 16); r.destroy()
if not addr or addr == 0 then error(&quot;Timers addr=0&quot;) end
registerSymbol(&quot;INJECT_TIMERS&quot;, addr)
{$asm}
alloc(newmem,$1000,INJECT_TIMERS)
label(code)
label(return)
newmem:
code:
  mov [rbx+000000A0],rcx
  jmp return
INJECT_TIMERS:
  jmp newmem
  nop 2
return:

[DISABLE]
