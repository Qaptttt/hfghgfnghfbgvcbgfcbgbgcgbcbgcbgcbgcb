-- ── SECTION 4: ENTITY SYSTEM (Aimbot) ───────────────────────────────────────
w(&quot;&quot;)
w(&quot;--- SECTION 4: ENTITY SYSTEM (Aimbot) ---&quot;)
do
  local ent_pats = {
    {&quot;EntIter_rcx&quot;, &quot;48 8B 04 C1 48 85 C0 74&quot;,&quot;ent=[rcx+rax*8]; null check&quot;},
    {&quot;EntIter_rdx&quot;, &quot;48 8B 04 D1 48 85 C0 74&quot;,&quot;ent=[rcx+rdx*8]; null check&quot;},
    {&quot;EntIter_rsi&quot;, &quot;48 8B 04 F1 48 85 C0 74&quot;,&quot;ent=[rcx+rsi*8]; null check&quot;},
    {&quot;EntListPtr1&quot;, &quot;48 8B 05 ?? ?? ?? ?? 48 85 C0 74 ?? 48 8B 00&quot;,&quot;list ptr; null; deref&quot;},
    {&quot;EntListPtr2&quot;, &quot;48 8B 0D ?? ?? ?? ?? 48 85 C9 74 ?? 8B 41&quot;,&quot;mgr ptr; null; read count&quot;},
    {&quot;EntPos_r&quot;,    &quot;F3 0F 10 ?? C0 01 00 00&quot;,&quot;movss read +0x1C0&quot;},
    {&quot;EntPos_w&quot;,    &quot;F3 0F 11 ?? C0 01 00 00&quot;,&quot;movss write +0x1C0&quot;},
    {&quot;EntHP_read1&quot;, &quot;F3 0F 10 ?? 40 00 00 00 0F 2F&quot;,&quot;hp float +0x40; compare&quot;},
    {&quot;EntHP_read2&quot;, &quot;F3 0F 10 ?? 44 00 00 00 0F 2F&quot;,&quot;hp float +0x44; compare&quot;},
    {&quot;EntHP_read3&quot;, &quot;F3 0F 10 ?? 50 00 00 00 0F 2F&quot;,&quot;hp float +0x50; compare&quot;},
    {&quot;EntHP_write&quot;, &quot;F3 41 0F 5C ?? F3 0F 11 ?? ?? 00 00 00&quot;,&quot;sub hp; store back&quot;},
    {&quot;EntNearCS&quot;,   &quot;A6 95 80 80 00 00 00 00&quot;,&quot;chams class tag&quot;},
    {&quot;EntScan&quot;,     &quot;90 95 80 80 00 00 00 00&quot;,&quot;pSticky class tag&quot;},
  }
  for _, e in ipairs(ent_pats) do
    local hits = scan(e[2], 6)
    if #hits == 0 then
      w(&quot;NOMATCH  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
    else
      w(&quot;FOUND(&quot; .. #hits .. &quot;)  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
      for _, h in ipairs(hits) do
        local extra = &quot;&quot;
        if e[1]:find(&quot;Ptr&quot;) then
          local tgt = resolveRIP(h, 7, 3)
          if tgt then extra = &quot;  -&gt;d2+&quot; .. string.format(&quot;%X&quot;, tgt-d2base) end
        end
        w(&quot;  d2+&quot; .. string.format(&quot;%X&quot;,h-d2base) .. &quot;  &quot; .. ctx(h,6,28) .. extra)
      end
    end
