          &lt;CheatEntries&gt;
            &lt;CheatEntry&gt;
              &lt;ID&gt;2337&lt;/ID&gt;
              &lt;Description&gt;&quot;Directional Fly&quot;&lt;/Description&gt;
              &lt;Color&gt;FF0080&lt;/Color&gt;
              &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
              &lt;AssemblerScript&gt;[ENABLE]
{$lua}

local AirstuckToggled = false
local previousStateG = false
local isGKeyPressed = false
KEEP_GOING = true

function handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
  writeFloat(playerPositionBase, positionX)
  writeFloat(playerPositionBase + 0x4, positionY)
  writeFloat(playerPositionBase + 0x8, positionZ)
  writeFloat(playerPositionBase + 0x70, 0)
  writeFloat(playerPositionBase + 0x74, 0)
  writeFloat(playerPositionBase + 0x78, 0)
end

function Fly()
  while KEEP_GOING do
    local playerBase = getAddressSafe(&quot;Player&quot;)
    if playerBase and playerBase ~= 0 then
      local ptrVal = readPointer(playerBase)
      if ptrVal and ptrVal ~= 0 then
        local playerPositionBase = ptrVal + 0x1C0
        local positionX = readFloat(playerPositionBase)
        local positionY = readFloat(playerPositionBase + 0x4)
        local positionZ = readFloat(playerPositionBase + 0x8)
        local rotationX = readFloat(playerPositionBase + 0x10)
        local rotationY = readFloat(playerPositionBase + 0x14)
        local rotationZ = readFloat(playerPositionBase + 0x18)
        FlypositionX = positionX + rotationX * 0.25
        FlypositionY = positionY + rotationY * 0.25
        FlypositionZ = positionZ + rotationZ * 0.25
        if isKeyPressed(VK_G) then
          writeFloat(playerPositionBase, FlypositionX)
          writeFloat(playerPositionBase + 0x4, FlypositionY)
          writeFloat(playerPositionBase + 0x8, FlypositionZ)
          writeFloat(playerPositionBase + 0x70, 0)
          writeFloat(playerPositionBase + 0x74, 0)
          writeFloat(playerPositionBase + 0x78, 0)
        end
        if isKeyPressed(VK_H) and not previousStateG then
          isGKeyPressed = not isGKeyPressed
          previousStateG = true
        elseif not isKeyPressed(VK_H) then
          previousStateG = false
        end
        if isGKeyPressed then
          handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
        end
      end
    end
    sleep(10)
  end
end

createNativeThread(Fly)

