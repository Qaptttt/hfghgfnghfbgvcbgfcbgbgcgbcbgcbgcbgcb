if syntaxcheck then return end
local addr = getAddressSafe(&quot;INJECT_TIMERS&quot;)
if addr and addr ~= 0 then
  pcall(writeBytes, addr, 0x48,0x89,0x8B,0xA0,0x00,0x00,0x00)
end
unregisterSymbol(&quot;INJECT_TIMERS&quot;)
{$asm}
dealloc(newmem)

