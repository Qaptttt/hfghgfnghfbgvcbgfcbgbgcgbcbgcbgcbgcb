            &lt;/CheatEntry&gt;
            &lt;CheatEntry&gt;
              &lt;ID&gt;2740&lt;/ID&gt;
              &lt;Description&gt;&quot;shellLocalPlayer&quot;&lt;/Description&gt;
              &lt;Options moActivateChildrenAsWell=&quot;1&quot; moDeactivateChildrenAsWell=&quot;1&quot;/&gt;
              &lt;Color&gt;808080&lt;/Color&gt;
              &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
              &lt;AssemblerScript&gt;{$lua}
local destinyBase = getAddressSafe('destiny2.exe+2F41D60')
local localPlayerOffset = 0x1C0
local teamIdOffset = 0xAAC

function LocalPlayerFunction()
  local localPlayer = readPointer(getAddress(&quot;LocalPlayer&quot;))
  local MovingEntityX = readFloat(destinyBase)
  local LocalPlayerX = readFloat(localPlayer + localPlayerOffset)
  local MovingEntityY = readFloat(destinyBase + 4)
  local LocalPlayerY = readFloat(localPlayer + localPlayerOffset + 4)
  local MovingEntityZ = readFloat(destinyBase + 8)
  local LocalPlayerZ = readFloat(localPlayer + localPlayerOffset + 8)

 -- local TeamID = readFloat(localPlayer + teamIdOffset)

  if (
    (MovingEntityX - 1 &lt;= LocalPlayerX and LocalPlayerX &lt;= MovingEntityX + 1) and
    (MovingEntityY - 1 &lt;= LocalPlayerY and LocalPlayerY &lt;= MovingEntityY + 1) and
    (MovingEntityZ - 3 &lt;= LocalPlayerZ and LocalPlayerZ &lt;= MovingEntityZ + 3) --and
   -- TeamID == 1
  ) then
    writeQword(getAddress(&quot;Player&quot;), localPlayer)
  end
end

function enableFunction()
  tmr = createTimer(nil, true)
  tmr.Interval = 1
  tmr.OnTimer = LocalPlayerFunction
end

function disableFunction()
  tmr.setEnabled = false
  tmr.destroy()
  tmr = nil
end

[ENABLE]
enableFunction()
{$asm}
alloc(Player, 8)
registersymbol(Player)
{$lua}
[DISABLE]
disableFunction()
{$asm}
dealloc(Player, 8)
unregistersymbol(Player)

&lt;/AssemblerScript&gt;
