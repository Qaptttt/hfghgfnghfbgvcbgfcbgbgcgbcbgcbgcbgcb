-- ── SECTION 7: WEAPON STATS ──────────────────────────────────────────────────
w(&quot;&quot;)
w(&quot;--- SECTION 7: WEAPON STAT TABLE ---&quot;)
do
  local wep_pats = {
    {&quot;WepClassTag&quot;, &quot;90 95 80 80 00 00 00 00&quot;,&quot;pSticky class tag&quot;},
    {&quot;WepClassAlt&quot;, &quot;8F 95 80 80 00 00 00 00&quot;,&quot;adjacent class tag&quot;},
    {&quot;WepRPM&quot;,      &quot;F3 0F 10 ?? ?? ?? ?? ?? F3 0F 59 ?? ?? ?? ?? ?? F3 0F 11&quot;,&quot;RPM multiply&quot;},
    {&quot;WepRange&quot;,    &quot;F3 0F 10 ?? 50 00 00 00 F3 0F 59&quot;,&quot;range float +0x50&quot;},
    {&quot;WepFull1&quot;,    &quot;F7 43 EA 80 ?? 95 80 80&quot;,&quot;flags near class tag&quot;},
  }
  for _, e in ipairs(wep_pats) do
    local hits = scan(e[2], 4)
    if #hits == 0 then
      w(&quot;NOMATCH  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
    else
      w(&quot;FOUND(&quot; .. #hits .. &quot;)  &quot; .. e[1] .. &quot;  [&quot; .. e[3] .. &quot;]&quot;)
      for _, h in ipairs(hits) do
        w(&quot;  d2+&quot; .. string.format(&quot;%X&quot;,h-d2base) .. &quot;  &quot; .. ctx(h,6,28))
      end
    end
  end
end

w(&quot;&quot;)
w(&quot;=== END V2 (7 sections) ===&quot;)

local function notify(msg)
  local dlg = createForm(true)
  dlg.Caption = &quot;D2 Scanner V2&quot;
  dlg.Width = 440; dlg.Height = 120
  dlg.Position = poScreenCenter
  dlg.FormStyle = fsStayOnTop
  dlg.BorderStyle = bsDialog
  local lbl = createLabel(dlg)
  lbl.Left = 12; lbl.Top = 12; lbl.Width = 416; lbl.Height = 60
  lbl.WordWrap = true
  lbl.Caption = msg
  local btn = createButton(dlg)
  btn.Caption = &quot;OK&quot;; btn.Left = 180; btn.Top = 78; btn.Width = 80; btn.Height = 26
  btn.OnClick = function() dlg.Close() end
  dlg.ShowModal(); dlg.Destroy()
end

if outFile then
  outFile:close()
  notify(&quot;Scan V2 complete!\n&quot; .. OUT .. &quot;\n7 sections: CT/ammo/entities/inventory/positions/weapons&quot;)
else
  notify(&quot;WRITE FAILED — could not open output file&quot;)
end
