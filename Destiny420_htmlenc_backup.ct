label(doyaw)
label(nopitch)
label(return)

newmem:
code:
  push r14
  mov r14, AimbotOn
  cmp byte ptr [r14], 0
  je doyaw
  movss xmm0, [AimbotYaw]
doyaw:
  movss [rdi+1C], xmm0
  mov r14, AimbotOn
  cmp byte ptr [r14], 0
  je nopitch
  movss xmm0, [AimbotPitch]
  movss [rdi+18], xmm0
nopitch:
  mov r14, ViewAngles
  mov [r14], rdi
  pop r14
  jmp return

INJECT:
  jmp newmem
return:
registersymbol(INJECT)

