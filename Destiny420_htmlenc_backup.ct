_G[&quot;InvPtrRunning&quot;] = true
createNativeThread(function()
  while _G[&quot;InvPtrRunning&quot;] do
    pcall(function()
      local d2base = getAddress(&quot;destiny2.exe&quot;)
      local staticAddr = d2base + 0x240C838
      local mid = readPointer(staticAddr)
      if mid and mid ~= 0 then
        local charBase = mid - 0x2F67B4
        if charBase &gt; 0x100000 and charBase &lt; 0x7FFFFFFFFFFF then
          writeQword(getAddress(&quot;HnxQBrSslpSZrxA&quot;), charBase)
        end
      end
    end)
    sleep(500)
  end
end)
