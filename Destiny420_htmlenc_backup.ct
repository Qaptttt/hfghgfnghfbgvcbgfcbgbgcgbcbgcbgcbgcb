-- Driver check: use dbk_initialize() — actual kernel driver test, not an AOB scan
local function runDrvCheck()
  local pid = getOpenedProcessID()
  if not pid or pid == 0 then
    lblStatus.Caption = &quot;● NOT ATTACHED&quot;; lblStatus.Font.Color = C_RED; return
  end
  local ok = pcall(function() dbk_initialize() end)
  if ok then
    lblStatus.Caption = &quot;● DRIVER OK&quot;;   lblStatus.Font.Color = C_GREEN
  else
    lblStatus.Caption = &quot;● DRIVER FAIL&quot;; lblStatus.Font.Color = C_RED
  end
end
drvBtn.OnClick = runDrvCheck

scanBtn.OnClick = function()
  local e = getE(9000); if not e then return end
  scanBtn.Caption = &quot;SCANNING...&quot;
  local t = createTimer(nil, false); t.Interval = 60
  t.OnTimer = function()
    t.Enabled = false; pcall(function() e.Active = true end)
    scanBtn.Caption = &quot;AOB SCANNER&quot;; t.Destroy()
  end
  t.Enabled = true
end

setTab(&quot;PLAYER&quot;)

_G[&quot;_dseMsg&quot;]        = nil   -- set by autoDSEToggleAsync thread, read by refreshTmr
_G[&quot;_dseMsgClr&quot;]     = nil
_G[&quot;_dseCheckPending&quot;] = false  -- signals refreshTmr to call dbk_initialize on main thread

local refreshTmr = createTimer(nil, false)
refreshTmr.Interval = 600
refreshTmr.OnTimer = function()
  for _, r in ipairs(btnList) do r.refresh() end
  -- driver check after DSE toggle (must run on main thread, not inside native thread)
  if _G[&quot;_dseCheckPending&quot;] then
    _G[&quot;_dseCheckPending&quot;] = false
    local ok = false
    pcall(function() ok = (dbk_initialize() == true) end)
    _G[&quot;_dseMsg&quot;]    = ok and &quot;DRIVER OK&quot; or &quot;DRIVER FAIL&quot;
    _G[&quot;_dseMsgClr&quot;] = ok and C_GREEN or C_RED
  end
  local msg = _G[&quot;_dseMsg&quot;]
  if msg then
    lblStatus.Caption = &quot;● &quot; .. msg
    lblStatus.Font.Color = _G[&quot;_dseMsgClr&quot;] or 0xFF8800
    if msg == &quot;DRIVER OK&quot; or msg == &quot;DRIVER FAIL&quot; then _G[&quot;_dseMsg&quot;] = nil end
  end
end
refreshTmr.Enabled  = true

local attachTmr = createTimer(nil, false)
attachTmr.Interval = 1500
attachTmr.OnTimer  = function()
  if tryAttach() then
    attachTmr.Enabled = false
    lblStatus.Caption = &quot;● ATTACHED&quot;; lblStatus.Font.Color = C_GREEN
  end
end
if tryAttach() then
  lblStatus.Caption = &quot;● ATTACHED&quot;; lblStatus.Font.Color = C_GREEN
else
  attachTmr.Enabled = true
end

