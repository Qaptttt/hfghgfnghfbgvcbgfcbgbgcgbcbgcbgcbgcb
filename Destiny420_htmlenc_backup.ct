            &lt;CheatEntry&gt;
              &lt;ID&gt;2338&lt;/ID&gt;
              &lt;Description&gt;&quot;WASDQE&quot;&lt;/Description&gt;
              &lt;Color&gt;808080&lt;/Color&gt;
              &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
              &lt;AssemblerScript&gt;[ENABLE]
{$lua}

local AirstuckToggled = false
local previousStateG = false
local isGKeyPressed = false
KEEP_GOING = true

function handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
  writeFloat(playerPositionBase, positionX)
  writeFloat(playerPositionBase + 0x4, positionY)
  writeFloat(playerPositionBase + 0x8, positionZ)
  writeFloat(playerPositionBase + 0x70, 0)  -- velocity X (ptrVal+0x230)
  writeFloat(playerPositionBase + 0x74, 0)  -- velocity Y (ptrVal+0x234)
  writeFloat(playerPositionBase + 0x78, 0)  -- velocity Z (ptrVal+0x238)
end

function Fly()
  while KEEP_GOING do
    local playerBase = getAddressSafe(&quot;Player&quot;)
    if playerBase and playerBase ~= 0 then
      local ptrVal = readPointer(playerBase)
      if ptrVal and ptrVal ~= 0 then
        local playerPositionBase = ptrVal + 0x1C0
        local positionX = readFloat(playerPositionBase)
        local positionY = readFloat(playerPositionBase + 0x4)
        local positionZ = readFloat(playerPositionBase + 0x8)
        local rotationX = readFloat(playerPositionBase + 0x10)
        local rotationY = readFloat(playerPositionBase + 0x14)
        local rotationZ = readFloat(playerPositionBase + 0x18)
          WpositionX = positionX + rotationX * 0.2
          WpositionY = positionY + rotationY * 0.2
          SpositionX = positionX - rotationX * 0.2
          SpositionY = positionY - rotationY * 0.2
          ApositionX = positionX - rotationY * 0.2
          ApositionY = positionY + rotationX * 0.2
          DpositionX = positionX + rotationY * 0.2
          DpositionY = positionY - rotationX * 0.2
          UppositionZ   = positionZ + 0.2
          DownpositionZ = positionZ - 0.2
          writeFloat(playerPositionBase + 0x70, 0)
          writeFloat(playerPositionBase + 0x74, 0)
          writeFloat(playerPositionBase + 0x78, 0)
          if isKeyPressed(VK_W) then
            writeFloat(playerPositionBase, WpositionX)
            writeFloat(playerPositionBase + 0x4, WpositionY)
          end
          if isKeyPressed(VK_S) then
            writeFloat(playerPositionBase, SpositionX)
            writeFloat(playerPositionBase + 0x4, SpositionY)
          end
          if isKeyPressed(VK_A) then
            writeFloat(playerPositionBase, ApositionX)
            writeFloat(playerPositionBase + 0x4, ApositionY)
          end
          if isKeyPressed(VK_D) then
            writeFloat(playerPositionBase, DpositionX)
            writeFloat(playerPositionBase + 0x4, DpositionY)
          end
          if isKeyPressed(VK_SPACE) then
            writeFloat(playerPositionBase + 0x8, UppositionZ)
          end
          if isKeyPressed(VK_SHIFT) then
            writeFloat(playerPositionBase + 0x8, DownpositionZ)
          end
          if isKeyPressed(VK_G) and not previousStateG then
            isGKeyPressed = not isGKeyPressed
            previousStateG = true
          elseif not isKeyPressed(VK_G) then
            previousStateG = false
          end
          if isGKeyPressed then
            handleGKeyPress(playerPositionBase, positionX, positionY, positionZ)
          end
        end
      end
    sleep(10)
  end
end

createNativeThread(Fly)

