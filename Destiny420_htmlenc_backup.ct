      &lt;AssemblerScript&gt;[ENABLE]
{$lua}
if syntaxcheck then return end
_G[&quot;HardenerPaused&quot;] = false
_G[&quot;HardenerRunning9030&quot;] = true

local PAGE_EXECUTE_READ      = 0x20
local PAGE_EXECUTE_READWRITE = 0x40

-- Cache d2 + BEClient module VA ranges so we never touch their pages
local function getModRange(name)
  local b = getAddress(name)
  if not b or b == 0 then return 0, 0 end
  local lf  = readInteger(b + 0x3C)
  if not lf then return b, b + 0x4000000 end
  local soi = readInteger(b + lf + 0x50)   -- SizeOfImage @ OptHdr+0x38, OptHdr at PE+0x18
  return b, b + (soi or 0x4000000)
end

local function hardenOnce()
  local d2s, d2e = getModRange(&quot;destiny2.exe&quot;)
  local bes, bee = getModRange(&quot;BEClient_x64.dll&quot;)
  local regions  = getMemoryRegions()
  if not regions then return end
  for i = 0, regions.Count - 1 do
    local r = regions[i]
    local ba = r.BaseAddress
    -- skip d2 and BEClient module ranges — only touch foreign RWX MEM_PRIVATE allocs
    if (ba &lt; d2s or ba &gt;= d2e) and (ba &lt; bes or ba &gt;= bee)
       and r.Protect == PAGE_EXECUTE_READWRITE and r.State == 0x1000
       and r.Type == 0x20000 and r.RegionSize &gt;= 0x10000 then
      pcall(changeMemoryProtection, ba, r.RegionSize, PAGE_EXECUTE_READ)
    end
  end
  regions.destroy()
end

local function hardenLoop()
  while _G[&quot;HardenerRunning9030&quot;] do
    if not _G[&quot;HardenerPaused&quot;] then
      hardenOnce()
    end
    -- jitter interval so the VirtualProtect call cadence isn't a fixed signature
    sleep(1800 + math.random(-200, 200))
  end
end

createNativeThread(hardenLoop)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
_G[&quot;HardenerRunning9030&quot;] = false
_G[&quot;HardenerPaused&quot;] = true
local PAGE_EXECUTE_READWRITE = 0x40
local regions = getMemoryRegions()
if regions then
  for i = 0, regions.Count - 1 do
    local r = regions[i]
    if r.Protect == 0x20 and r.State == 0x1000
       and r.Type == 0x20000 and r.RegionSize &gt;= 0x10000 then
      pcall(changeMemoryProtection, r.BaseAddress, r.RegionSize, PAGE_EXECUTE_READWRITE)
    end
  end
  regions.destroy()
end
{$asm}
&lt;/AssemblerScript&gt;
    &lt;/CheatEntry&gt;
    &lt;CheatEntry&gt;
      &lt;ID&gt;9031&lt;/ID&gt;
      &lt;Description&gt;&quot;HWID Spoofer&quot;&lt;/Description&gt;
      &lt;VariableType&gt;Auto Assembler Script&lt;/VariableType&gt;
      &lt;AssemblerScript&gt;[ENABLE]
{$lua}
if syntaxcheck then return end

math.randomseed(getTickCount())
local _unpack = table.unpack or unpack

local function rh(n)
  return string.format(&quot;%0&quot;..n..&quot;X&quot;, math.random(0, (16^n)-1))
end

local fakeSerial = math.random(0x10000000, 0x7FFFFFFF)
local fakeGUID   = rh(8)..&quot;-&quot;..rh(4)..&quot;-4&quot;..rh(3)..&quot;-&quot;..rh(4)..&quot;-&quot;..rh(12)

-- addr to 8 LE bytes (table)
local function q2b(a)
  local b = {}
  for i = 1, 8 do b[i] = a &amp; 0xFF; a = a &gt;&gt; 8 end
  return b
end

-- dword to 4 LE bytes (table)
local function d2b(v)
  return {v &amp; 0xFF, (v &gt;&gt; 8) &amp; 0xFF, (v &gt;&gt; 16) &amp; 0xFF, (v &gt;&gt; 24) &amp; 0xFF}
end

local function extend(t, src)
  for _, v in ipairs(src) do t[#t+1] = v end
end

-- Walk one PE's IAT, find target_addr, overwrite thunk with hook_addr.
-- Returns the thunk VA on success, nil on failure.
-- Import dir is DataDirectory[1]: PE+0x18(OptHdr)+0x78(DD[1].RVA)
local function iatPatch(pe_base, target_addr, hook_addr)
  if not pe_base or pe_base == 0 then return nil end
  local lf = readInteger(pe_base + 0x3C)
  if not lf then return nil end
  -- PE32+ magic check
  if readSmallInteger(pe_base + lf + 0x18) ~= 0x20B then return nil end
  local impRVA  = readInteger(pe_base + lf + 0x18 + 0x78)
  local impSize = readInteger(pe_base + lf + 0x18 + 0x7C)
  if not impRVA or impRVA == 0 then return nil end
  local desc = pe_base + impRVA
  for _ = 0, math.floor(impSize / 20) - 1 do
    local nameRVA = readInteger(desc + 0x0C)
    local ftRVA   = readInteger(desc + 0x10)
    if nameRVA == 0 and ftRVA == 0 then break end
    if ftRVA ~= 0 then
      local thunk = pe_base + ftRVA
      for _ = 1, 16384 do
        local fp = readPointer(thunk)
        if not fp or fp == 0 then break end
        if fp == target_addr then
          if pcall(writePointer, thunk, hook_addr) then return thunk end
          return nil
        end
        thunk = thunk + 8
      end
    end
    desc = desc + 20
  end
  return nil
end

-- Build GetVolumeInformation trampoline (W and A share same logic).
-- Uses RIP-relative scratch to save R9 — zero RSP delta so
-- the callee sees stack params 5-8 at their correct positions.
-- Layout (44 bytes code, scratch qword at offset 0x30):
--   4C 89 0D 29 00 00 00   mov [rip+0x29], r9
--   48 B8 [8]              mov rax, origAddr
--   FF D0                  call rax
--   85 C0                  test eax, eax
--   74 14                  jz done
--   4C 8B 0D 12 00 00 00   mov r9, [rip+0x12]
--   4D 85 C9               test r9, r9
--   74 08                  jz done
--   BA [4]                 mov edx, fakeSerial
--   41 89 11               mov [r9], edx
-- done: C3                 ret
local function buildVolTramp(origAddr)
  local tramp = allocateMemory(64)
  if not tramp or tramp == 0 then return nil end
  local sc = {
    0x4C,0x89,0x0D,0x29,0x00,0x00,0x00,   -- mov [rip+0x29], r9
    0x48,0xB8,
  }
  extend(sc, q2b(origAddr))
  extend(sc, {
    0xFF,0xD0,
    0x85,0xC0,
    0x74,0x14,
    0x4C,0x8B,0x0D,0x12,0x00,0x00,0x00,   -- mov r9, [rip+0x12]
    0x4D,0x85,0xC9,
    0x74,0x08,
  })
  extend(sc, {0xBA}); extend(sc, d2b(fakeSerial))
  extend(sc, {0x41,0x89,0x11})
  extend(sc, {0xC3})
  writeBytes(tramp, _unpack(sc))
  return tramp
end

-- Hook GetVolumeInformationW + GetVolumeInformationA in destiny2.exe + BEClient_x64.dll
local function hookVolumeSerial()
  local origW = getAddressSafe(&quot;GetVolumeInformationW&quot;)
  local origA = getAddressSafe(&quot;GetVolumeInformationA&quot;)
  _G[&quot;SpoofTramp9031&quot;]  = (origW and origW ~= 0) and buildVolTramp(origW) or nil
  _G[&quot;SpoofTrampA9031&quot;] = (origA and origA ~= 0) and buildVolTramp(origA) or nil
  _G[&quot;SpoofPatched9031&quot;] = {}
  for _, mod in ipairs({&quot;destiny2.exe&quot;,&quot;BEClient_x64.dll&quot;}) do
    local base = getAddress(mod)
    if base and base ~= 0 then
      if _G[&quot;SpoofTramp9031&quot;] and origW and origW ~= 0 then
        local thunk = iatPatch(base, origW, _G[&quot;SpoofTramp9031&quot;])
        if thunk then
          _G[&quot;SpoofPatched9031&quot;][#_G[&quot;SpoofPatched9031&quot;]+1] = {thunk=thunk, orig=origW}
        end
      end
      if _G[&quot;SpoofTrampA9031&quot;] and origA and origA ~= 0 then
        local thunk = iatPatch(base, origA, _G[&quot;SpoofTrampA9031&quot;])
        if thunk then
          _G[&quot;SpoofPatched9031&quot;][#_G[&quot;SpoofPatched9031&quot;]+1] = {thunk=thunk, orig=origA}
        end
      end
    end
  end
end

-- MachineGuid: read real GUID via registry, scan for it (UTF-16LE) in memory, overwrite.
-- Falls back to scanning for the key name if io.popen unavailable.
local function patchMachineGUID()
  local wfake = {}
  for i = 1, #fakeGUID do
    wfake[#wfake+1] = fakeGUID:sub(i,i):byte(); wfake[#wfake+1] = 0
  end
  wfake[#wfake+1] = 0; wfake[#wfake+1] = 0

  local realGUID = nil
  local fh = io.popen('reg query &quot;HKLM\\SOFTWARE\\Microsoft\\Cryptography&quot; /v MachineGuid 2&gt;nul')
  if fh then
    local out = fh:read(&quot;*a&quot;) or &quot;&quot;; fh:close()
    realGUID = out:match(&quot;MachineGuid%s+REG_SZ%s+([0-9A-Fa-f%-]+)&quot;)
    if realGUID then realGUID = realGUID:match(&quot;^%s*(.-)%s*$&quot;) end
  end

  if realGUID and #realGUID &gt;= 32 then
    local parts = {}
    for i = 1, #realGUID do
      parts[#parts+1] = string.format(&quot;%02X 00&quot;, realGUID:sub(i,i):byte())
    end
    local r = AOBScan(table.concat(parts, &quot; &quot;))
    if r then
      for i = 0, math.min(r.Count-1, 63) do
        local addr = tonumber(r[i], 16)
        if addr and addr &gt; 0x10000 then pcall(writeBytes, addr, _unpack(wfake)) end
      end
      r.destroy()
    end
  else
    -- fallback: key name scan
    local r = AOBScan(&quot;4D 00 61 00 63 00 68 00 69 00 6E 00 65 00 47 00 75 00 69 00 64 00&quot;)
    if r then
      for i = 0, math.min(r.Count-1, 15) do
        local addr = tonumber(r[i], 16)
        if addr and addr &gt; 0x10000 then
          pcall(writeBytes, addr + 24, _unpack(wfake))
        end
      end
      r.destroy()
    end
  end
  _G[&quot;SpoofGUID9031&quot;] = fakeGUID
end

pcall(hookVolumeSerial)
pcall(patchMachineGUID)
_G[&quot;SpoofFakeSerial9031&quot;] = fakeSerial
